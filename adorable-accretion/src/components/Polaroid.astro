---
/**
 * Polaroid.astro — Reusable polaroid-style image card with click-to-expand modal.
 *
 * Renders a thumbnail inside a rotated polaroid frame. Clicking opens a <dialog>
 * overlay showing the full-resolution image. Closing is handled by clicking
 * anywhere or pressing Escape.
 *
 * @prop {ImageMetadata} src    — Astro image import to display.
 * @prop {string}        alt    — Alt text for accessibility.
 * @prop {string}        caption — Optional caption shown below the image.
 * @prop {number}        rotate — CSS rotation in degrees (default 0).
 */
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt?: string;
	caption?: string;
	rotate?: number;
}

const { src, alt = '', caption, rotate = 0 } = Astro.props;
---

<div class="polaroid-wrapper">
	<div class="polaroid" style={`--rotate: ${rotate}deg`}>
		<div class="polaroid-image">
			<Image src={src} alt={alt} width={280} height={280} loading="lazy" />
		</div>
		{caption && <p class="polaroid-caption">{caption}</p>}
	</div>

	<dialog class="polaroid-modal">
		<div class="modal-inner">
			<Image src={src} alt={alt} width={1600} height={1600} />
			{caption && <p class="modal-caption">{caption}</p>}
		</div>
	</dialog>
</div>

<script>
	function initPolaroids() {
		document.querySelectorAll<HTMLElement>('.polaroid-wrapper').forEach((wrapper) => {
			const polaroid = wrapper.querySelector('.polaroid') as HTMLElement;
			const dialog = wrapper.querySelector('dialog') as HTMLDialogElement;
			if (!polaroid || !dialog) return;
			if (polaroid.dataset.initialized) return;
			polaroid.dataset.initialized = 'true';

			polaroid.addEventListener('click', () => {
				dialog.showModal();
			});

			dialog.addEventListener('click', () => {
				dialog.close();
			});
		});
	}

	initPolaroids();
	document.addEventListener('astro:after-swap', initPolaroids);
</script>

<style>
	.polaroid-wrapper {
		display: inline-block;
	}
	.polaroid {
		background: #fff;
		padding: 16px 16px 56px 16px;
		box-shadow: 2px 3px 12px rgba(0, 0, 0, 0.15), 0 1px 4px rgba(0, 0, 0, 0.1);
		transform: rotate(var(--rotate));
		display: inline-block;
		transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
		cursor: pointer;
	}
	:global(html.dark) .polaroid {
		background: #2a2a3e;
		box-shadow: 2px 3px 12px rgba(0, 0, 0, 0.4), 0 1px 4px rgba(0, 0, 0, 0.3);
	}
	.polaroid:hover {
		transform: rotate(0deg) scale(1.05);
		box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.25);
		z-index: 10;
	}
	.polaroid-image {
		width: 200px;
		height: 200px;
		max-width: 100%;
		overflow: hidden;
	}
	@media (max-width: 720) {
		.polaroid {
			padding: 10px 10px 36px 10px;
		}
		.polaroid-image {
			width: 140px;
			height: 140px;
		}
	}
	.polaroid-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.polaroid-caption {
		margin: 8px 0 0 0;
		text-align: center;
		font-family: 'Segoe UI', cursive, sans-serif;
		font-size: 0.8rem;
		color: #555;
	}
	:global(html.dark) .polaroid-caption {
		color: #aaa;
	}

	.polaroid-modal {
		border: none;
		background: transparent;
		padding: 5% 5% 12% 5%;
		background: #fff;
		margin: auto;
		max-width: none;
		max-height: none;
		overflow: visible;	
		box-shadow: 4px 6px 24px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2);

	}
	.polaroid-modal::backdrop {
		background: rgba(0, 0, 0, 0.85);
	}
	.modal-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	:global(html.dark) .polaroid-modal {
		background: #2a2a3e;
		box-shadow: 4px 6px 24px rgba(0, 0, 0, 0.6), 0 2px 8px rgba(0, 0, 0, 0.4);
	}
	.modal-inner img {
		max-width: 80vw;
		max-height: 75vh;
		width: auto;
		height: auto;
		object-fit: contain;
		display: block;
	}
	@media (max-width: 720px) {
		.modal-inner {
			padding: 3% 3% 15% 3%;
		}
		.modal-inner img {
			max-width: 110vw;
			max-height: 105vh;
		}
	}

	.modal-caption {
		text-align: center;
		color: #555;
		margin-top: 12px;
		font-size: 1rem;
		font-family: 'Segoe UI', cursive, sans-serif;
	}
	:global(html.dark) .modal-caption {
		color: #aaa;
	}
</style>
