---
/**
 * FormattedDate.astro — Renders a <time> element with a human-readable date.
 * Output format: "Mon DD, YYYY" (e.g. "Apr 09, 2026").
 *
 * @prop {Date} date — The date to format.
 */
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
