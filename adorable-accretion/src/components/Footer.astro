---
/**
 * Footer.astro — Site-wide footer with copyright year.
 * Section-specific gradient backgrounds are applied via global.css
 * using the html[data-section] attribute.
 */
import FeedbackBunny from './FeedbackBunny.astro';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Lucy's stuff! All rights reserved? <br>
	Damn look at the news, im not sure I have too many rights.
	<br> <br>
	All content on this website is created <strong>by hand by humans,</strong> without the use of any kind of AI. <br><strong>Note:</strong> Images in the Taverns wiki are taken from the internet and may have been created by AI, but I try to use those created by humans.
	<br><br>
	<nav class="legal-links" aria-label="Legal information">
		<a href="/impressum/">Impressum</a>
		<a href="/kontakt/">Kontakt</a>
	</nav>
	<br>
	<button class="summon-bunny-btn" onclick="window.summonBunny && window.summonBunny()" aria-label="Summon the bunny">
		🐇 Summon the bunny
	</button>
</footer>
<FeedbackBunny />
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		position: relative;
		z-index: 3;
	}

	.summon-bunny-btn {
		-webkit-appearance: none;
		appearance: none;
		background: none;
		border: 1px solid currentColor;
		border-radius: 999px;
		color: inherit;
		cursor: pointer;
		font-family: inherit;
		font-size: 0.8rem;
		opacity: 0.6;
		padding: 0.3em 0.9em;
		transition: opacity 0.2s;
	}

	.legal-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.legal-links a {
		color: inherit;
		font-size: 0.85rem;
	}

	.summon-bunny-btn:hover {
		opacity: 1;
	}
</style>
