			}
			html.dark .scheduling-layout .section-heading {
				color: #DEB96E;
			}
			.scheduling-layout .section-heading.past-heading {
				margin-top: 3rem;
				padding-top: 0.75rem;
				border-top: 1px solid #C4A35A;
			}
			html.dark .scheduling-layout .section-heading.past-heading {
				border-top-color: #7a5c2e;
			}

			/* ── Event cards (wiki-style frame) ── */
			.scheduling-layout .event-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
