				color: #FDF6EC;
				font-size: 0.72rem;
				font-weight: 400;
				padding: 0.4em 0.75em;
				border-radius: 6px;
				white-space: nowrap;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s ease;
				z-index: 10;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
