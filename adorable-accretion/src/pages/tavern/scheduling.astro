				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 1.6em;
				height: 1.6em;
				padding: 0 0.35em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.15);
				color: #5C3D0E;
				font-size: 0.75rem;
				font-weight: 700;
				line-height: 1;
			}
			html.dark .scheduling-layout .avail-result-cell .avail-count {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.scheduling-layout .avail-result-cell .avail-count.zero {
				opacity: 0.4;
			}
			.scheduling-layout .avail-error {
				color: #a33;
				font-size: 0.75rem;
				margin-top: 0.4rem;
			}
		</style>
