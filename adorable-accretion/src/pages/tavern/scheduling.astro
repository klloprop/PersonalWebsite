				align-items: center;
				gap: 0.35rem;
				padding: 0.35em 0.75em;
				border-radius: 8px;
				border: 1px solid rgba(196, 163, 90, 0.4);
				background: rgba(139, 105, 20, 0.05);
				color: #5C3D0E;
				font-size: 0.78rem;
				font-family: Georgia, 'Times New Roman', serif;
				cursor: pointer;
