			}
			.scheduling-layout .avail-btn:hover {
				border-color: #C4A35A;
				background: rgba(139, 105, 20, 0.12);
			}
			html.dark .scheduling-layout .avail-btn {
				border-color: rgba(122, 92, 46, 0.5);
				background: rgba(222, 185, 110, 0.05);
				color: #F5E4C4;
			}
			html.dark .scheduling-layout .avail-btn:hover {
