---
/**
 * tavern/scheduling.astro — Session scheduling page.
 *
 * Features:
 *  - Reads events from the events content collection.
 *  - Converts Berlin timezone dates to visitor's local timezone.
 *  - Groups events into Next, Upcoming, and Past sections.
 *  - Countdown badges for upcoming events.
 *  - Availability polling via Upstash Redis API (/api/availability).
 */
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const allEvents = await getCollection('events');

// Parse Berlin datetimes and sort by date/time
const events = allEvents.map((event) => {
	const { date, time } = event.data;
	// Build an ISO string in Europe/Berlin
	const berlinISO = `${date}T${time}:00`;
	return { ...event, berlinISO };
}).sort((a, b) => a.berlinISO.localeCompare(b.berlinISO));

// We'll split into past/upcoming on the client side since we need the user's current time,
// but we can also do a server-side split using build time as a rough guide.
// For static sites, client-side is more accurate.
---

<!doctype html>
<html lang="en" data-section="tavern">
	<head>
		<BaseHead title={`${SITE_TITLE} - Scheduling`} description="Upcoming and past sessions" />
		<style is:global>
			/* Scoped under .scheduling-layout to avoid leaking */
			.scheduling-layout {
				max-width: 900px;
				margin: 0 auto;
				padding: 2.5rem 2rem;
				flex: 1;
			}
			.scheduling-layout .page-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 2rem;
				color: #3E2703;
				margin: 0 0 0.5rem;
			}
			html.dark .scheduling-layout .page-title {
				color: #DEB96E;
			}
			.scheduling-layout .page-subtitle {
				color: #8B6914;
				margin: 0 0 2.5rem;
				font-size: 1rem;
			}
			html.dark .scheduling-layout .page-subtitle {
				color: #C4A35A;
			}

			/* ── Next event hero ── */
			.scheduling-layout .next-event {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
				margin-bottom: 3rem;
			}
			html.dark .scheduling-layout .next-event {
				background: #2a1c0a;
				border-color: #7a5c2e;
				box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
			}
			.scheduling-layout .next-event-content {
				padding: 1.75rem 2rem;
			}
			.scheduling-layout .next-event-top-row {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 0.6rem;
			}
			.scheduling-layout .next-event-label {
				display: inline-block;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				padding: 0.2em 0.65em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.15);
				color: #8B6914;
				font-weight: 700;
				margin: 0;
			}
			html.dark .scheduling-layout .next-event-label {
				background: rgba(222, 185, 110, 0.15);
				color: #C4A35A;
			}

			/* ── Session type tag ── */
			.scheduling-layout .session-type-tag {
				display: inline-block;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				padding: 0.25em 0.75em;
				border-radius: 6px;
				font-weight: 800;
				font-family: Georgia, 'Times New Roman', serif;
				line-height: 1.4;
			}
			.scheduling-layout .session-type-tag.main-session {
				background: #133538;
				color: #fff;
			}
			html.dark .scheduling-layout .session-type-tag.main-session {
				background: #29484b;
				color: #fff;
			}
			.scheduling-layout .session-type-tag.optional-session {
				background: #9b8923;
				color: #fff;
			}
			html.dark .scheduling-layout .session-type-tag.optional-session {
				background: #a1923c;
				color: #fff;
			}

			/* ── Cancelled state ── */
			.scheduling-layout .cancelled-tag {
				display: inline-block;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				padding: 0.25em 0.75em;
				border-radius: 6px;
				font-weight: 800;
				font-family: Georgia, 'Times New Roman', serif;
				line-height: 1.4;
				background: #a33;
				color: #fff;
			}
			html.dark .scheduling-layout .cancelled-tag {
				background: #c44;
				color: #ffe8e8;
			}
			.scheduling-layout .event-card.cancelled {
				border-style: dashed;
			}
			.scheduling-layout .next-event.cancelled {
				border-style: dashed;
			}
			.scheduling-layout .next-event-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.55rem;
				color: #3E2703;
				margin: 0 0 0.75rem;
			}
			html.dark .scheduling-layout .next-event-title {
				color: #DEB96E;
			}
			.scheduling-layout .next-event-datetime {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-bottom: 1rem;
			}
			.scheduling-layout .next-event-description {
				color: #5C3D0E;
				line-height: 1.7;
				margin: 0 0 1rem;
			}
			html.dark .scheduling-layout .next-event-description {
				color: #F5E4C4;
			}
			.scheduling-layout .next-event-body {
				color: #5C3D0E;
				line-height: 1.7;
				font-size: 0.95rem;
			}
			html.dark .scheduling-layout .next-event-body {
				color: #F5E4C4;
			}
			.scheduling-layout .next-event-body p {
				margin: 0 0 0.75rem;
			}
			.scheduling-layout .next-event-body strong {
				color: #3E2703;
			}
			html.dark .scheduling-layout .next-event-body strong {
				color: #DEB96E;
			}
			.scheduling-layout .next-event-body ul {
				margin: 0.25rem 0 0.75rem 1.25rem;
			}

			/* ── Time badge ── */
			.scheduling-layout .time-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				padding: 0.25em 0.7em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.15);
				color: #5C3D0E;
				font-size: 0.82rem;
				font-weight: 600;
				font-family: Georgia, 'Times New Roman', serif;
				line-height: 1.4;
			}
			html.dark .scheduling-layout .time-badge {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.scheduling-layout .time-badge svg {
				width: 14px;
				height: 14px;
				flex-shrink: 0;
			}
			.scheduling-layout .time-converted {
				background: rgba(34, 139, 34, 0.12);
				color: #2d6b2d;
				border: 1px dashed rgba(34, 139, 34, 0.4);
			}
			html.dark .scheduling-layout .time-converted {
				background: rgba(100, 200, 100, 0.12);
				color: #7ddb7d;
				border-color: rgba(100, 200, 100, 0.3);
			}
			.scheduling-layout .time-note {
				font-size: 0.7rem;
				color: #8B6914;
				font-weight: 400;
			}
			html.dark .scheduling-layout .time-note {
				color: #C4A35A;
			}

			/* ── Section headings ── */
			.scheduling-layout .section-heading {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.35rem;
				color: #3E2703;
				margin: 0 0 1.25rem;
			}
			html.dark .scheduling-layout .section-heading {
				color: #DEB96E;
			}
			.scheduling-layout .section-heading.past-heading {
				margin-top: 3rem;
				padding-top: 0.75rem;
				border-top: 1px solid #C4A35A;
			}
			html.dark .scheduling-layout .section-heading.past-heading {
				border-top-color: #7a5c2e;
			}

			/* ── Event cards (wiki-style frame) ── */
			.scheduling-layout .event-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.scheduling-layout .event-card {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			html.dark .scheduling-layout .event-card {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.scheduling-layout .event-card:not(.past):hover {
				box-shadow: 0 4px 18px rgba(62, 39, 3, 0.16);
				transform: translateY(-2px);
			}
			html.dark .scheduling-layout .event-card:not(.past):hover {
				box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
			}
			.scheduling-layout .event-card.past {
				opacity: 0.55;
				border-style: dashed;
			}
			.scheduling-layout .event-card-content {
				padding: 1.5rem 1.75rem;
			}
			.scheduling-layout .event-card-tags-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
			}
			.scheduling-layout .event-card-top-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
			}
			.scheduling-layout .event-card-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.15rem;
				color: #3E2703;
				margin: 0 0 0.65rem;
			}
			html.dark .scheduling-layout .event-card-title {
				color: #DEB96E;
			}
			.scheduling-layout .event-card-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-bottom: 0.6rem;
			}
			.scheduling-layout .event-card-description {
				color: #5C3D0E;
				font-size: 0.9rem;
				line-height: 1.6;
				margin: 0;
			}
			html.dark .scheduling-layout .event-card-description {
				color: #F5E4C4;
			}

			/* ── Countdown badge with hover tooltip ── */
			.scheduling-layout .countdown-badge {
				position: relative;
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				padding: 0.2em 0.65em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.12);
				color: #5C3D0E;
				font-size: 0.75rem;
				font-weight: 600;
				font-family: Georgia, 'Times New Roman', serif;
				cursor: default;
				white-space: nowrap;
			}
			html.dark .scheduling-layout .countdown-badge {
				background: rgba(222, 185, 110, 0.12);
				color: #DEB96E;
			}
			.scheduling-layout .countdown-badge.past-badge {
				background: rgba(139, 105, 20, 0.06);
				color: #8B6914;
			}
			html.dark .scheduling-layout .countdown-badge.past-badge {
				background: rgba(222, 185, 110, 0.06);
				color: #C4A35A;
			}
			.scheduling-layout .countdown-badge svg {
				width: 12px;
				height: 12px;
				flex-shrink: 0;
			}
			.scheduling-layout .countdown-tooltip {
				position: absolute;
				bottom: calc(100% + 8px);
				left: 50%;
				transform: translateX(-50%);
				background: #3E2703;
				color: #FDF6EC;
				font-size: 0.72rem;
				font-weight: 400;
				padding: 0.4em 0.75em;
				border-radius: 6px;
				white-space: nowrap;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s ease;
				z-index: 10;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
			}
			.scheduling-layout .countdown-tooltip::after {
				content: '';
				position: absolute;
				top: 100%;
				left: 50%;
				transform: translateX(-50%);
				border: 5px solid transparent;
				border-top-color: #3E2703;
			}
			html.dark .scheduling-layout .countdown-tooltip {
				background: #DEB96E;
				color: #1a1008;
			}
			html.dark .scheduling-layout .countdown-tooltip::after {
				border-top-color: #DEB96E;
			}
			.scheduling-layout .countdown-badge:hover .countdown-tooltip {
				opacity: 1;
			}

			.scheduling-layout .no-events {
				color: #8B6914;
				font-style: italic;
				padding: 1rem 0;
			}
			html.dark .scheduling-layout .no-events {
				color: #C4A35A;
			}

			@media (max-width: 720px) {
				.scheduling-layout {
					padding: 1.25rem;
				}
				.scheduling-layout .next-event-content {
					padding: 1.25rem;
				}
				.scheduling-layout .next-event-title {
					font-size: 1.25rem;
				}
				.scheduling-layout .event-card-content {
					padding: 1rem 1.25rem;
				}
				.scheduling-layout .avail-table td.avail-option-cell {
					width: auto;
				}
				.scheduling-layout .avail-table td.avail-bar-cell {
					display: none;
				}
				.scheduling-layout .avail-table td.avail-result-cell {
					width: auto;
					text-align: right;
				}
				.scheduling-layout .avail-table tr {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: 0.4rem 0;
				}
				.scheduling-layout .next-event-top-row {
					flex-wrap: wrap;
				}
				.scheduling-layout .time-badges {
					flex-wrap: wrap;
				}
			}

			/* ── Availability poll (2-column table) ── */
			.scheduling-layout .avail-section {
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(196, 163, 90, 0.25);
			}
			.scheduling-layout .avail-label {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.8rem;
				color: #8B6914;
				margin: 0 0 0.6rem;
				font-weight: 600;
			}
			html.dark .scheduling-layout .avail-label {
				color: #C4A35A;
			}
			.scheduling-layout .avail-table {
				width: 100%;
				border-collapse: collapse;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.78rem;
			}
			.scheduling-layout .avail-table tr {
				border-bottom: 1px solid rgba(196, 163, 90, 0.15);
			}
			.scheduling-layout .avail-table tr:last-child {
				border-bottom: none;
			}
			.scheduling-layout .avail-table td {
				padding: 0.45rem 0.5rem;
				vertical-align: middle;
			}
			.scheduling-layout .avail-table td.avail-option-cell {
				width: 45%;
			}
			.scheduling-layout .avail-table td.avail-bar-cell {
				width: 40%;
				padding: 0.45rem 0.6rem;
			}
			.scheduling-layout .avail-bar-track {
				width: 100%;
				height: 8px;
				border-radius: 4px;
				background: rgba(139, 105, 20, 0.1);
				overflow: hidden;
			}
			html.dark .scheduling-layout .avail-bar-track {
				background: rgba(222, 185, 110, 0.1);
			}
			.scheduling-layout .avail-bar-fill {
				height: 100%;
				width: 0%;
				border-radius: 4px;
				background: #C4A35A;
				transition: width 0.3s ease;
			}
			html.dark .scheduling-layout .avail-bar-fill {
				background: #DEB96E;
			}
			.scheduling-layout .avail-table td.avail-result-cell {
				width: 15%;
				text-align: right;
			}
			.scheduling-layout .avail-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.35em 0.75em;
				border-radius: 8px;
				border: 1px solid rgba(196, 163, 90, 0.4);
				background: rgba(139, 105, 20, 0.05);
				color: #5C3D0E;
				font-size: 0.78rem;
				font-family: Georgia, 'Times New Roman', serif;
				cursor: pointer;
				transition: all 0.15s ease;
				line-height: 1.4;
				width: 100%;
				box-sizing: border-box;
			}
			.scheduling-layout .avail-btn:hover {
				border-color: #C4A35A;
				background: rgba(139, 105, 20, 0.12);
			}
			html.dark .scheduling-layout .avail-btn {
				border-color: rgba(122, 92, 46, 0.5);
				background: rgba(222, 185, 110, 0.05);
				color: #F5E4C4;
			}
			html.dark .scheduling-layout .avail-btn:hover {
				border-color: #C4A35A;
				background: rgba(222, 185, 110, 0.12);
			}
			.scheduling-layout .avail-btn.selected {
				border-color: #8B6914;
				background: rgba(139, 105, 20, 0.2);
				font-weight: 700;
				box-shadow: 0 0 0 1px #8B6914;
			}
			html.dark .scheduling-layout .avail-btn.selected {
				border-color: #DEB96E;
				background: rgba(222, 185, 110, 0.2);
				box-shadow: 0 0 0 1px #DEB96E;
			}

			.scheduling-layout .avail-result-cell .avail-count {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 1.6em;
				height: 1.6em;
				padding: 0 0.35em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.15);
				color: #5C3D0E;
				font-size: 0.75rem;
				font-weight: 700;
				line-height: 1;
			}
			html.dark .scheduling-layout .avail-result-cell .avail-count {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.scheduling-layout .avail-result-cell .avail-count.zero {
				opacity: 0.4;
			}
			.scheduling-layout .avail-error {
				color: #a33;
				font-size: 0.75rem;
				margin-top: 0.4rem;
			}

			/* ── Schedule Calendar ── */
			.scheduling-layout .calendar-section {
				margin: 2rem 0 3rem;
			}
			.scheduling-layout .session-calendar {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				padding: 1.5rem;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
			}
			html.dark .scheduling-layout .session-calendar {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.scheduling-layout .calendar-legend {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 1.25rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgba(196, 163, 90, 0.25);
			}
			.scheduling-layout .legend-item {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.78rem;
				color: #5C3D0E;
				font-family: Georgia, 'Times New Roman', serif;
			}
			html.dark .scheduling-layout .legend-item {
				color: #F5E4C4;
			}
			.scheduling-layout .legend-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				flex-shrink: 0;
				box-sizing: border-box;
			}
			.scheduling-layout .legend-dot.main { background: #133538; }
			.scheduling-layout .legend-dot.optional { background: #9b8923; }
			.scheduling-layout .legend-dot.cancelled { background: #a33; }
			.scheduling-layout .legend-dot.extrapolated-main {
				background: rgba(19, 53, 56, 0.12);
				border: 1.5px dashed #133538;
			}
			.scheduling-layout .legend-dot.extrapolated-optional {
				background: rgba(155, 137, 35, 0.12);
				border: 1.5px dashed #9b8923;
			}
			.scheduling-layout .cal-nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.25rem;
			}
			.scheduling-layout .cal-nav-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.4em 0.85em;
				border-radius: 8px;
				border: 1.5px solid #C4A35A;
				background: #FDF6EC;
				color: #5C3D0E;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.82rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.15s, border-color 0.15s;
				line-height: 1.4;
			}
			.scheduling-layout .cal-nav-btn:hover:not(:disabled) {
				background: rgba(139, 105, 20, 0.12);
				border-color: #8B6914;
			}
			.scheduling-layout .cal-nav-btn:disabled {
				opacity: 0.35;
				cursor: default;
			}
			html.dark .scheduling-layout .cal-nav-btn {
				background: #2a1c0a;
				border-color: #7a5c2e;
				color: #F5E4C4;
			}
			html.dark .scheduling-layout .cal-nav-btn:hover:not(:disabled) {
				background: rgba(222, 185, 110, 0.12);
				border-color: #DEB96E;
			}
			.scheduling-layout .calendar-months {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0;
			}
			@media (max-width: 560px) {
