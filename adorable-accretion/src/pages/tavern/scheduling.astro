	<body>
		<Header />
		<div class="scheduling-layout">
			<h1 class="page-title">Scheduling</h1>
			<p class="page-subtitle">Session times are shown in your local timezone.</p>

			<!-- Next upcoming event (rendered as hero) — replaced client-side -->
			<div id="next-event-container"></div>

			<!-- Upcoming events -->
			<div id="upcoming-container"></div>

			<!-- Past events -->
			<div id="past-container"></div>
		</div>
		<Footer />

		<!-- Embed all event data as JSON for client-side timezone conversion -->
		<script define:vars={{ events: await Promise.all(events.map(async (e) => {
			const { Content } = await render(e);
			return null; // We can't serialize components
		})) }}>
		</script>

		<!-- Pass event data as JSON -->
		<script is:inline define:vars={{ eventsJSON: JSON.stringify(events.map(e => ({
			id: e.id,
			slug: e.slug ?? e.id,
			title: e.data.title,
			description: e.data.description,
			date: e.data.date,
			time: e.data.time,
			duration: e.data.duration,
			berlinISO: e.berlinISO,
			sessionType: e.data.sessionType ?? 'main',
			cancelled: e.data.cancelled ?? false,
		}))) }}>
			window.__EVENTS_DATA__ = JSON.parse(eventsJSON);
		</script>

		<!-- Rendered event bodies for the next-event detail view -->
		<div id="event-bodies" style="display:none;">
			{events.map(async (event) => {
				const { Content } = await render(event);
				return (
					<div data-event-id={event.id}>
						<Content />
					</div>
				);
			})}
		</div>

		<script>
			function initScheduling() {
				const events = (window as any).__EVENTS_DATA__ as Array<{
					id: string;
					slug: string;
					title: string;
					description: string;
					date: string;
					time: string;
					duration?: number;
					berlinISO: string;
					sessionType: 'main' | 'optional';
					cancelled: boolean;
				}>;

				if (!events || events.length === 0) return;

				const now = new Date();

				// Convert Berlin time → user's local time
				function berlinToLocal(dateStr: string, timeStr: string): Date {
					// Create a date string as if it's in Europe/Berlin
					const isoStr = `${dateStr}T${timeStr}:00`;
					// Use Intl to figure out Berlin's UTC offset for that datetime
					const berlinFormatter = new Intl.DateTimeFormat('en-US', {
						timeZone: 'Europe/Berlin',
						year: 'numeric', month: '2-digit', day: '2-digit',
						hour: '2-digit', minute: '2-digit', second: '2-digit',
						hour12: false,
					});

					// Parse the given date/time as a UTC reference, then adjust
					// Strategy: find Berlin's offset by comparing formatted output
					const testDate = new Date(isoStr + 'Z'); // treat as UTC first
					const berlinParts = berlinFormatter.formatToParts(testDate);
					const getPart = (type: string) => berlinParts.find(p => p.type === type)?.value || '0';
					const berlinHour = parseInt(getPart('hour'));
					const berlinDay = parseInt(getPart('day'));

					// The offset is Berlin's displayed time minus UTC
					const utcHour = testDate.getUTCHours();
					const utcDay = testDate.getUTCDate();
					let offsetHours = berlinHour - utcHour + (berlinDay - utcDay) * 24;

					// Now: the user gave us time in Berlin. We need UTC.
					// Berlin time = UTC + offset → UTC = Berlin time - offset
					const berlinAsUTC = new Date(isoStr + 'Z');
					berlinAsUTC.setUTCHours(berlinAsUTC.getUTCHours() - offsetHours);
					return berlinAsUTC;
				}

				function formatLocalTime(date: Date): string {
					return date.toLocaleTimeString(undefined, {
						hour: '2-digit',
						minute: '2-digit',
						hour12: true,
					});
				}

				function formatLocalDate(date: Date): string {
					return date.toLocaleDateString(undefined, {
						weekday: 'long',
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					});
				}

				function formatBerlinTime(timeStr: string): string {
					const [h, m] = timeStr.split(':').map(Number);
					const period = h >= 12 ? 'PM' : 'AM';
					const h12 = h % 12 || 12;
					return `${h12}:${m.toString().padStart(2, '0')} ${period}`;
				}

				function getUserTZ(): string {
					return Intl.DateTimeFormat().resolvedOptions().timeZone;
				}

				function isBerlinTZ(): boolean {
					const tz = getUserTZ();
					return tz === 'Europe/Berlin' || tz === 'Europe/Paris' || tz === 'Europe/Amsterdam' || tz === 'Europe/Brussels' || tz === 'Europe/Madrid' || tz === 'Europe/Rome' || tz === 'Europe/Vienna' || tz === 'Europe/Zurich' || tz === 'Europe/Warsaw' || tz === 'Europe/Prague' || tz === 'Europe/Budapest' || tz === 'Europe/Stockholm' || tz === 'Europe/Oslo' || tz === 'Europe/Copenhagen';
				}

				function formatDuration(mins: number): string {
					const h = Math.floor(mins / 60);
					const m = mins % 60;
					if (h && m) return `${h}h ${m}m`;
					if (h) return `${h}h`;
					return `${m}m`;
				}

				function clockSVG(): string {
					return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>`;
				}

				function calendarSVG(): string {
					return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>`;
				}

				function hourglassSVG(): string {
					return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2v6h.01L6 8.01 10 12l-4 4 .01.01H6V22h12v-5.99h-.01L18 16l-4-4 4-3.99-.01-.01H18V2H6zm10 14.5V20H8v-3.5l4-4 4 4zm-4-5-4-4V4h8v3.5l-4 4z"/></svg>`;
				}

				function formatCountdown(ms: number): { short: string; full: string } {
					const totalMinutes = Math.floor(Math.abs(ms) / 60000);
					const minutes = totalMinutes % 60;
					const totalHours = Math.floor(totalMinutes / 60);
					const hours = totalHours % 24;
					const days = Math.floor(totalHours / 24);
					const isPast = ms < 0;

					let short = '';
					if (days > 0) short = `${days}d`;
					else if (hours > 0) short = `${hours}h`;
					else short = `${minutes}m`;
					if (isPast) short += ' ago';
					else short = 'in ' + short;

					const parts: string[] = [];
					if (days > 0) parts.push(`${days} day${days !== 1 ? 's' : ''}`);
					if (hours > 0) parts.push(`${hours} hour${hours !== 1 ? 's' : ''}`);
					if (minutes > 0 || parts.length === 0) parts.push(`${minutes} minute${minutes !== 1 ? 's' : ''}`);
					const full = isPast ? `${parts.join(', ')} ago` : `${parts.join(', ')} from now`;

					return { short, full };
				}

				function countdownBadge(localDate: Date, isPast: boolean): string {
					const diff = localDate.getTime() - now.getTime();
					const { short, full } = formatCountdown(diff);
					const cls = isPast ? 'countdown-badge past-badge' : 'countdown-badge';
					return `<span class="${cls}">${hourglassSVG()} ${short}<span class="countdown-tooltip">${full}</span></span>`;
				}

				function sessionTypeTag(type: 'main' | 'optional'): string {
					if (type === 'optional') {
						return `<span class="session-type-tag optional-session">Optional Session</span>`;
					}
					return `<span class="session-type-tag main-session">Main Session</span>`;
				}

				function cancelledTag(): string {
					return `<span class="cancelled-tag">Cancelled</span>`;
				}

				// Split events
				const parsed = events.map(ev => ({
					...ev,
					localDate: berlinToLocal(ev.date, ev.time),
				}));

				const upcoming = parsed.filter(ev => ev.localDate >= now).sort((a, b) => a.localDate.getTime() - b.localDate.getTime());
				const past = parsed.filter(ev => ev.localDate < now).sort((a, b) => b.localDate.getTime() - a.localDate.getTime());

				const sameTimezone = isBerlinTZ();

				function buildTimeBadges(ev: typeof parsed[0]): string {
					let html = `<span class="time-badge">${calendarSVG()} ${formatLocalDate(ev.localDate)}</span>`;
					html += `<span class="time-badge">${clockSVG()} ${formatBerlinTime(ev.time)} <span class="time-note">Berlin</span></span>`;

					if (!sameTimezone) {
						html += `<span class="time-badge time-converted">${clockSVG()} ${formatLocalTime(ev.localDate)} <span class="time-note">Your time</span></span>`;
					}

					return html;
				}

				// Availability poll options
				const availOptions = [
					{ key: 'can-make-it', label: 'I can make it' },
					{ key: 'low-energy', label: 'I\'ll be low energy' },
					{ key: 'cannot-play-without', label: 'Can\'t make it, don\'t play without me' },
					{ key: 'cannot-do-not-play', label: 'Can\'t make it, play without me' },
				];

				function buildAvailPoll(eventId: string, isPast: boolean): string {
					if (isPast) return '';
					const safeId = eventId.replace(/[^a-zA-Z0-9_-]/g, '_');
					const rows = availOptions.map(opt =>
						`<tr>` +
						`<td class="avail-option-cell">` +
						`<button class="avail-btn" data-event-id="${eventId}" data-status="${opt.key}">` +
						`${opt.label}` +
						`</button></td>` +
						`<td class="avail-bar-cell">` +
						`<div class="avail-bar-track"><div class="avail-bar-fill" data-bar-for="${opt.key}"></div></div>` +
						`</td>` +
						`<td class="avail-result-cell">` +
						`<span class="avail-count zero" data-count-for="${opt.key}">0</span>` +
						`</td></tr>`
					).join('');
					return `
						<div class="avail-section" data-avail-poll="${eventId}" id="avail-${safeId}">
							<p class="avail-label">Availability</p>
							<table class="avail-table">${rows}</table>
						</div>
					`;
				}

				async function fetchAvailability(eventId: string): Promise<void> {
					try {
						const resp = await fetch(`/api/availability?eventId=${encodeURIComponent(eventId)}`);
						if (!resp.ok) return;
						const data = await resp.json();
						updatePollUI(eventId, data.votes, data.myVote);
					} catch {
						// silently fail — poll is non-critical
					}
				}

				async function submitVote(eventId: string, status: string): Promise<void> {
					const poll = document.querySelector(`[data-avail-poll="${eventId}"]`);
					try {
						const resp = await fetch('/api/availability', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ eventId, status }),
						});
						if (!resp.ok) throw new Error('Failed');
						const data = await resp.json();
						updatePollUI(eventId, data.votes, data.myVote);
					} catch {
						if (poll) {
							let errEl = poll.querySelector('.avail-error');
							if (!errEl) {
								errEl = document.createElement('p');
								errEl.className = 'avail-error';
								poll.appendChild(errEl);
							}
							errEl.textContent = 'Could not save — please try again.';
						}
					}
				}

				function updatePollUI(eventId: string, votes: Record<string, number>, myVote: string | null): void {
					const poll = document.querySelector(`[data-avail-poll="${eventId}"]`);
					if (!poll) return;
					const totalVotes = Object.values(votes).reduce((sum, n) => sum + n, 0);
					poll.querySelectorAll('.avail-btn').forEach(btn => {
						const status = (btn as HTMLElement).dataset.status;
						const row = btn.closest('tr');
						const countEl = row?.querySelector('.avail-count');
						const barEl = row?.querySelector('.avail-bar-fill') as HTMLElement | null;
						const count = votes[status || ''] || 0;
						if (countEl) {
							countEl.textContent = String(count);
							countEl.classList.toggle('zero', count === 0);
						}
						if (barEl) {
							const pct = totalVotes > 0 ? (count / totalVotes) * 100 : 0;
							barEl.style.width = `${pct}%`;
						}
						btn.classList.toggle('selected', status === myVote);
					});
				}

				// Render next event hero
				const nextContainer = document.getElementById('next-event-container');
				if (nextContainer && upcoming.length > 0) {
					const next = upcoming[0];
					const bodyEl = document.querySelector(`#event-bodies [data-event-id="${next.id}"]`);
					const bodyHTML = bodyEl ? bodyEl.innerHTML : '';

					nextContainer.innerHTML = `
						<div class="next-event${next.cancelled ? ' cancelled' : ''}">
							<div class="next-event-content">
								<div class="next-event-top-row">
									${sessionTypeTag(next.sessionType)}
									<span class="next-event-label">Next Session</span>
									${next.cancelled ? cancelledTag() : countdownBadge(next.localDate, false)}
								</div>
								<h2 class="next-event-title">${next.title}</h2>
								<div class="next-event-datetime">${buildTimeBadges(next)}</div>
								<p class="next-event-description">${next.description}</p>
								${!next.cancelled && bodyHTML ? `<div class="next-event-body">${bodyHTML}</div>` : ''}
								${!next.cancelled ? buildAvailPoll(next.id, false) : ''}
							</div>
						</div>
					`;
				}

				// Render upcoming events (skip first since it's the hero)
				const upcomingContainer = document.getElementById('upcoming-container');
				if (upcomingContainer) {
					if (upcoming.length > 1) {
						const cards = upcoming.slice(1).map(ev => `
							<li class="event-card${ev.cancelled ? ' cancelled' : ''}">
								<div class="event-card-content">
									<div class="event-card-tags-row">
										${sessionTypeTag(ev.sessionType)}
										${ev.cancelled ? cancelledTag() : countdownBadge(ev.localDate, false)}
									</div>
									<div class="event-card-top-row">
										<h3 class="event-card-title">${ev.title}</h3>
									</div>
									<div class="event-card-meta">${buildTimeBadges(ev)}</div>
									<p class="event-card-description">${ev.description}</p>
									${!ev.cancelled ? buildAvailPoll(ev.id, false) : ''}
								</div>
							</li>
						`).join('');
						upcomingContainer.innerHTML = `
							<h2 class="section-heading">Upcoming Sessions</h2>
							<ul class="event-list">${cards}</ul>
						`;
					}
				}

				// Render past events
				const pastContainer = document.getElementById('past-container');
				if (pastContainer && past.length > 0) {
					const cards = past.map(ev => `
						<li class="event-card past${ev.cancelled ? ' cancelled' : ''}">
							<div class="event-card-content">
								<div class="event-card-tags-row">
									${sessionTypeTag(ev.sessionType)}
									${ev.cancelled ? cancelledTag() : ''}
								</div>
								<div class="event-card-top-row">
									<h3 class="event-card-title">${ev.title}</h3>
									${!ev.cancelled ? countdownBadge(ev.localDate, true) : ''}
								</div>
								<div class="event-card-meta">${buildTimeBadges(ev)}</div>
								<p class="event-card-description">${ev.description}</p>
							</div>
						</li>
					`).join('');
					pastContainer.innerHTML = `
						<h2 class="section-heading past-heading">Past Sessions</h2>
						<ul class="event-list">${cards}</ul>
					`;
				}

				// If no events at all
				if (upcoming.length === 0 && past.length === 0) {
					const nextContainer = document.getElementById('next-event-container');
					if (nextContainer) {
						nextContainer.innerHTML = '<p class="no-events">No sessions scheduled yet.</p>';
					}
				} else if (upcoming.length === 0) {
					const nextContainer = document.getElementById('next-event-container');
					if (nextContainer) {
						nextContainer.innerHTML = '<p class="no-events">No upcoming sessions scheduled.</p>';
					}
				}

				// Wire up vote buttons (event delegation)
				document.querySelector('.scheduling-layout')?.addEventListener('click', (e) => {
					const btn = (e.target as HTMLElement).closest('.avail-btn') as HTMLElement | null;
					if (!btn) return;
					const eventId = btn.dataset.eventId;
					const status = btn.dataset.status;
					if (eventId && status) {
						const isSelected = btn.classList.contains('selected');
						submitVote(eventId, isSelected ? 'clear' : status);
					}
				});

				// Fetch initial availability data for all upcoming non-cancelled events
				for (const ev of upcoming) {
					if (!ev.cancelled) {
						fetchAvailability(ev.id);
					}
				}
			}

			initScheduling();
			document.addEventListener('astro:after-swap', initScheduling);
		</script>
	</body>
</html>
