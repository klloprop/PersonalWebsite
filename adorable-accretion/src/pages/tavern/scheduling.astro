			/* ── Availability poll (2-column table) ── */
			.scheduling-layout .avail-section {
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(196, 163, 90, 0.25);
			}
			.scheduling-layout .avail-label {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.8rem;
				color: #8B6914;
				margin: 0 0 0.6rem;
				font-weight: 600;
			}
			html.dark .scheduling-layout .avail-label {
				color: #C4A35A;
			}
			.scheduling-layout .avail-table {
				width: 100%;
