	<body>
		<Header />
		<div class="scheduling-layout">
			<h1 class="page-title">Scheduling</h1>
			<p class="page-subtitle">Session times are shown in your local timezone.</p>

			<!-- Schedule Calendar -->
			<div id="calendar-container"></div>

			<!-- Next upcoming event (rendered as hero) — replaced client-side -->
			<div id="next-event-container"></div>

			<!-- Upcoming events -->
			<div id="upcoming-container"></div>

			<!-- Past events -->
			<div id="past-container"></div>
		</div>
		<Footer />

		<!-- Embed all event data as JSON for client-side timezone conversion -->
		<script define:vars={{ events: await Promise.all(events.map(async (e) => {
			const { Content } = await render(e);
			return null; // We can't serialize components
		})) }}>
		</script>

		<!-- Pass event data as JSON -->
		<script is:inline define:vars={{ eventsJSON: JSON.stringify(events.map(e => ({
			id: e.id,
			slug: e.slug ?? e.id,
			title: e.data.title,
			description: e.data.description,
			date: e.data.date,
			time: e.data.time,
			duration: e.data.duration,
			berlinISO: e.berlinISO,
			sessionType: e.data.sessionType ?? 'main',
			cancelled: e.data.cancelled ?? false,
		}))) }}>
			window.__EVENTS_DATA__ = JSON.parse(eventsJSON);
		</script>

		<!-- Rendered event bodies for the next-event detail view -->
		<div id="event-bodies" style="display:none;">
			{events.map(async (event) => {
				const { Content } = await render(event);
				return (
					<div data-event-id={event.id}>
						<Content />
					</div>
				);
			})}
		</div>

		<script>
			function initScheduling() {
				const events = (window as any).__EVENTS_DATA__ as Array<{
					id: string;
					slug: string;
					title: string;
					description: string;
					date: string;
					time: string;
					duration?: number;
					berlinISO: string;
					sessionType: 'main' | 'optional';
					cancelled: boolean;
				}>;

				if (!events || events.length === 0) return;

				const now = new Date();

				// Convert Berlin time → user's local time
				function berlinToLocal(dateStr: string, timeStr: string): Date {
					// Create a date string as if it's in Europe/Berlin
					const isoStr = `${dateStr}T${timeStr}:00`;
					// Use Intl to figure out Berlin's UTC offset for that datetime
					const berlinFormatter = new Intl.DateTimeFormat('en-US', {
						timeZone: 'Europe/Berlin',
						year: 'numeric', month: '2-digit', day: '2-digit',
						hour: '2-digit', minute: '2-digit', second: '2-digit',
						hour12: false,
					});

					// Parse the given date/time as a UTC reference, then adjust
					// Strategy: find Berlin's offset by comparing formatted output
					const testDate = new Date(isoStr + 'Z'); // treat as UTC first
					const berlinParts = berlinFormatter.formatToParts(testDate);
					const getPart = (type: string) => berlinParts.find(p => p.type === type)?.value || '0';
					const berlinHour = parseInt(getPart('hour'));
					const berlinDay = parseInt(getPart('day'));

					// The offset is Berlin's displayed time minus UTC
					const utcHour = testDate.getUTCHours();
					const utcDay = testDate.getUTCDate();
					let offsetHours = berlinHour - utcHour + (berlinDay - utcDay) * 24;

					// Now: the user gave us time in Berlin. We need UTC.
					// Berlin time = UTC + offset → UTC = Berlin time - offset
					const berlinAsUTC = new Date(isoStr + 'Z');
					berlinAsUTC.setUTCHours(berlinAsUTC.getUTCHours() - offsetHours);
					return berlinAsUTC;
				}

				function formatLocalTime(date: Date): string {
					return date.toLocaleTimeString(undefined, {
						hour: '2-digit',
						minute: '2-digit',
						hour12: true,
					});
				}

				function formatLocalDate(date: Date): string {
					return date.toLocaleDateString(undefined, {
						weekday: 'long',
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					});
				}

				function formatBerlinTime(timeStr: string): string {
					const [h, m] = timeStr.split(':').map(Number);
					const period = h >= 12 ? 'PM' : 'AM';
					const h12 = h % 12 || 12;
					return `${h12}:${m.toString().padStart(2, '0')} ${period}`;
				}

				function getUserTZ(): string {
					return Intl.DateTimeFormat().resolvedOptions().timeZone;
				}

				function isBerlinTZ(): boolean {
					const tz = getUserTZ();
					return tz === 'Europe/Berlin' || tz === 'Europe/Paris' || tz === 'Europe/Amsterdam' || tz === 'Europe/Brussels' || tz === 'Europe/Madrid' || tz === 'Europe/Rome' || tz === 'Europe/Vienna' || tz === 'Europe/Zurich' || tz === 'Europe/Warsaw' || tz === 'Europe/Prague' || tz === 'Europe/Budapest' || tz === 'Europe/Stockholm' || tz === 'Europe/Oslo' || tz === 'Europe/Copenhagen';
				}

				function formatDuration(mins: number): string {
					const h = Math.floor(mins / 60);
					const m = mins % 60;
					if (h && m) return `${h}h ${m}m`;
					if (h) return `${h}h`;
					return `${m}m`;
				}

				function clockSVG(): string {
					return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>`;
				}

				function calendarSVG(): string {
					return `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>`;
				}

				function hourglassSVG(): string {
					return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2v6h.01L6 8.01 10 12l-4 4 .01.01H6V22h12v-5.99h-.01L18 16l-4-4 4-3.99-.01-.01H18V2H6zm10 14.5V20H8v-3.5l4-4 4 4zm-4-5-4-4V4h8v3.5l-4 4z"/></svg>`;
				}

				function formatCountdown(ms: number): { short: string; full: string } {
					const totalMinutes = Math.floor(Math.abs(ms) / 60000);
					const minutes = totalMinutes % 60;
					const totalHours = Math.floor(totalMinutes / 60);
					const hours = totalHours % 24;
					const days = Math.floor(totalHours / 24);
					const isPast = ms < 0;

					let short = '';
					if (days > 0) short = `${days}d`;
					else if (hours > 0) short = `${hours}h`;
					else short = `${minutes}m`;
					if (isPast) short += ' ago';
					else short = 'in ' + short;

					const parts: string[] = [];
					if (days > 0) parts.push(`${days} day${days !== 1 ? 's' : ''}`);
					if (hours > 0) parts.push(`${hours} hour${hours !== 1 ? 's' : ''}`);
					if (minutes > 0 || parts.length === 0) parts.push(`${minutes} minute${minutes !== 1 ? 's' : ''}`);
					const full = isPast ? `${parts.join(', ')} ago` : `${parts.join(', ')} from now`;

					return { short, full };
				}

				function countdownBadge(localDate: Date, isPast: boolean): string {
					const diff = localDate.getTime() - now.getTime();
					const { short, full } = formatCountdown(diff);
					const cls = isPast ? 'countdown-badge past-badge' : 'countdown-badge';
					return `<span class="${cls}">${hourglassSVG()} ${short}<span class="countdown-tooltip">${full}</span></span>`;
				}

				function sessionTypeTag(type: 'main' | 'optional'): string {
					if (type === 'optional') {
						return `<span class="session-type-tag optional-session">Optional Session</span>`;
					}
					return `<span class="session-type-tag main-session">Main Session</span>`;
				}

				function cancelledTag(): string {
					return `<span class="cancelled-tag">Cancelled</span>`;
				}

				// Split events
				const parsed = events.map(ev => ({
					...ev,
					localDate: berlinToLocal(ev.date, ev.time),
				}));

				const upcoming = parsed.filter(ev => ev.localDate >= now).sort((a, b) => a.localDate.getTime() - b.localDate.getTime());
				const past = parsed.filter(ev => ev.localDate < now).sort((a, b) => b.localDate.getTime() - a.localDate.getTime());

				const sameTimezone = isBerlinTZ();

				function buildTimeBadges(ev: typeof parsed[0]): string {
					let html = `<span class="time-badge">${calendarSVG()} ${formatLocalDate(ev.localDate)}</span>`;
					html += `<span class="time-badge">${clockSVG()} ${formatBerlinTime(ev.time)} <span class="time-note">Berlin</span></span>`;

					if (!sameTimezone) {
						html += `<span class="time-badge time-converted">${clockSVG()} ${formatLocalTime(ev.localDate)} <span class="time-note">Your time</span></span>`;
					}

					return html;
				}

				// Availability poll options
				const availOptions = [
					{ key: 'can-make-it', label: 'I can make it' },
					{ key: 'low-energy', label: 'I\'ll be low energy' },
					{ key: 'cannot-play-without', label: 'Can\'t make it, don\'t play without me' },
					{ key: 'cannot-do-not-play', label: 'Can\'t make it, play without me' },
				];

				function buildAvailPoll(eventId: string, isPast: boolean): string {
					if (isPast) return '';
					const safeId = eventId.replace(/[^a-zA-Z0-9_-]/g, '_');
					const rows = availOptions.map(opt =>
						`<tr>` +
						`<td class="avail-option-cell">` +
						`<button class="avail-btn" data-event-id="${eventId}" data-status="${opt.key}">` +
						`${opt.label}` +
						`</button></td>` +
						`<td class="avail-bar-cell">` +
						`<div class="avail-bar-track"><div class="avail-bar-fill" data-bar-for="${opt.key}"></div></div>` +
						`</td>` +
						`<td class="avail-result-cell">` +
						`<span class="avail-count zero" data-count-for="${opt.key}">0</span>` +
						`</td></tr>`
					).join('');
					return `
						<div class="avail-section" data-avail-poll="${eventId}" id="avail-${safeId}">
							<p class="avail-label">Availability</p>
							<table class="avail-table">${rows}</table>
						</div>
					`;
				}

				async function fetchAvailability(eventId: string): Promise<void> {
					try {
						const resp = await fetch(`/api/availability?eventId=${encodeURIComponent(eventId)}`);
						if (!resp.ok) return;
						const data = await resp.json();
						updatePollUI(eventId, data.votes, data.myVote);
					} catch {
						// silently fail — poll is non-critical
					}
				}

				async function submitVote(eventId: string, status: string): Promise<void> {
					const poll = document.querySelector(`[data-avail-poll="${eventId}"]`);
					try {
						const resp = await fetch('/api/availability', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ eventId, status }),
						});
						if (!resp.ok) throw new Error('Failed');
						const data = await resp.json();
						updatePollUI(eventId, data.votes, data.myVote);
					} catch {
						if (poll) {
							let errEl = poll.querySelector('.avail-error');
							if (!errEl) {
								errEl = document.createElement('p');
								errEl.className = 'avail-error';
								poll.appendChild(errEl);
							}
							errEl.textContent = 'Could not save — please try again.';
						}
					}
				}

				function updatePollUI(eventId: string, votes: Record<string, number>, myVote: string | null): void {
					const poll = document.querySelector(`[data-avail-poll="${eventId}"]`);
					if (!poll) return;
					const totalVotes = Object.values(votes).reduce((sum, n) => sum + n, 0);
					poll.querySelectorAll('.avail-btn').forEach(btn => {
						const status = (btn as HTMLElement).dataset.status;
						const row = btn.closest('tr');
						const countEl = row?.querySelector('.avail-count');
						const barEl = row?.querySelector('.avail-bar-fill') as HTMLElement | null;
						const count = votes[status || ''] || 0;
						if (countEl) {
							countEl.textContent = String(count);
							countEl.classList.toggle('zero', count === 0);
						}
						if (barEl) {
							const pct = totalVotes > 0 ? (count / totalVotes) * 100 : 0;
							barEl.style.width = `${pct}%`;
						}
						btn.classList.toggle('selected', status === myVote);
					});
				}

				// Render next event hero
				const nextContainer = document.getElementById('next-event-container');
				if (nextContainer && upcoming.length > 0) {
					const next = upcoming[0];
					const bodyEl = document.querySelector(`#event-bodies [data-event-id="${next.id}"]`);
					const bodyHTML = bodyEl ? bodyEl.innerHTML : '';
					const nextSafeId = next.id.replace(/[^a-zA-Z0-9_-]/g, '_');

					nextContainer.innerHTML = `
						<div class="next-event${next.cancelled ? ' cancelled' : ''}" id="event-card-${nextSafeId}">
							<div class="next-event-content">
								<div class="next-event-top-row">
									${sessionTypeTag(next.sessionType)}
									<span class="next-event-label">Next Session</span>
									${next.cancelled ? cancelledTag() : countdownBadge(next.localDate, false)}
								</div>
								<h2 class="next-event-title">${next.title}</h2>
								<div class="next-event-datetime">${buildTimeBadges(next)}</div>
								<p class="next-event-description">${next.description}</p>
								${!next.cancelled && bodyHTML ? `<div class="next-event-body">${bodyHTML}</div>` : ''}
								${!next.cancelled ? buildAvailPoll(next.id, false) : ''}
							</div>
						</div>
					`;
				}

				// Render upcoming events (skip first since it's the hero)
				const upcomingContainer = document.getElementById('upcoming-container');
				if (upcomingContainer) {
					if (upcoming.length > 1) {
						const cards = upcoming.slice(1).map(ev => {
							const safeId = ev.id.replace(/[^a-zA-Z0-9_-]/g, '_');
							return `
							<li class="event-card${ev.cancelled ? ' cancelled' : ''}" id="event-card-${safeId}">
								<div class="event-card-content">
									<div class="event-card-tags-row">
										${sessionTypeTag(ev.sessionType)}
										${ev.cancelled ? cancelledTag() : countdownBadge(ev.localDate, false)}
									</div>
									<div class="event-card-top-row">
										<h3 class="event-card-title">${ev.title}</h3>
									</div>
									<div class="event-card-meta">${buildTimeBadges(ev)}</div>
									<p class="event-card-description">${ev.description}</p>
									${!ev.cancelled ? buildAvailPoll(ev.id, false) : ''}
								</div>
							</li>
						`}).join('');
						upcomingContainer.innerHTML = `
							<h2 class="section-heading">Upcoming Sessions</h2>
							<ul class="event-list">${cards}</ul>
						`;
					}
				}

				// Render past events
				const pastContainer = document.getElementById('past-container');
				if (pastContainer && past.length > 0) {
					const cards = past.map(ev => {
						const safeId = ev.id.replace(/[^a-zA-Z0-9_-]/g, '_');
						return `
						<li class="event-card past${ev.cancelled ? ' cancelled' : ''}" id="event-card-${safeId}">
							<div class="event-card-content">
								<div class="event-card-tags-row">
									${sessionTypeTag(ev.sessionType)}
									${ev.cancelled ? cancelledTag() : ''}
								</div>
								<div class="event-card-top-row">
									<h3 class="event-card-title">${ev.title}</h3>
									${!ev.cancelled ? countdownBadge(ev.localDate, true) : ''}
								</div>
								<div class="event-card-meta">${buildTimeBadges(ev)}</div>
								<p class="event-card-description">${ev.description}</p>
							</div>
						</li>
					`}).join('');
					pastContainer.innerHTML = `
						<h2 class="section-heading past-heading">Past Sessions</h2>
						<ul class="event-list">${cards}</ul>
					`;
				}

				// If no events at all
				if (upcoming.length === 0 && past.length === 0) {
					const nextContainer = document.getElementById('next-event-container');
					if (nextContainer) {
						nextContainer.innerHTML = '<p class="no-events">No sessions scheduled yet.</p>';
					}
				} else if (upcoming.length === 0) {
					const nextContainer = document.getElementById('next-event-container');
					if (nextContainer) {
						nextContainer.innerHTML = '<p class="no-events">No upcoming sessions scheduled.</p>';
					}
				}

				// Wire up vote buttons (event delegation)
				document.querySelector('.scheduling-layout')?.addEventListener('click', (e) => {
					const btn = (e.target as HTMLElement).closest('.avail-btn') as HTMLElement | null;
					if (!btn) return;
					const eventId = btn.dataset.eventId;
					const status = btn.dataset.status;
					if (eventId && status) {
						const isSelected = btn.classList.contains('selected');
						submitVote(eventId, isSelected ? 'clear' : status);
					}
				});

				// Fetch initial availability data for all upcoming non-cancelled events
				for (const ev of upcoming) {
					if (!ev.cancelled) {
						fetchAvailability(ev.id);
					}
				}

				// ── Schedule Calendar ──
				async function buildCalendar(): Promise<void> {
					const calContainer = document.getElementById('calendar-container');
					if (!calContainer) return;

					// Build date → events[] map
					const dateMap = new Map<string, typeof parsed>();
					for (const ev of parsed) {
						const existing = dateMap.get(ev.date) || [];
						existing.push(ev);
						dateMap.set(ev.date, existing);
					}

					// Determine session day-of-week from actual events
					const allDates = [...dateMap.keys()].sort();
					if (allDates.length === 0) return;
					const dowTally = new Array(7).fill(0);
					for (const ds of allDates) {
						const d = new Date(ds + 'T12:00:00Z');
						dowTally[d.getUTCDay()]++;
					}
					const autoDOW = dowTally.indexOf(Math.max(...dowTally));

					// Anchor for main/optional alternation
					const mainEvents = parsed.filter(e => e.sessionType === 'main' && !e.cancelled);
					if (mainEvents.length === 0) return;
					mainEvents.sort((a, b) => a.date.localeCompare(b.date));
					const anchorDate = mainEvents[mainEvents.length - 1].date;

					// Calendar display settings (fetched from server, admin-writable)
					type CalSettings = { dowOverride: number | null; dow2: number | null; extrapolate: boolean };
					const [settingsData, meData] = await Promise.all([
						fetch('/api/admin/cal-settings').then(r => r.json()).catch(() => ({})),
						fetch('/api/auth/me').then(r => r.json()).catch(() => ({})),
					]);
					const isAdmin: boolean = meData?.role === 'admin';
					let calSettings: CalSettings = { dowOverride: null, dow2: null, extrapolate: true, ...settingsData };
					function saveCalSettings(s: CalSettings): void {
						fetch('/api/admin/cal-settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(s) });
					}
					function effectiveDOW(): number { return calSettings.dowOverride !== null ? calSettings.dowOverride : autoDOW; }

					function getExpectedType(dateStr: string): 'main' | 'optional' {
						const anchor = new Date(anchorDate + 'T12:00:00Z');
						const test = new Date(dateStr + 'T12:00:00Z');
						const diffWeeks = Math.round(
							(test.getTime() - anchor.getTime()) / (7 * 24 * 60 * 60 * 1000)
						);
						return diffWeeks % 2 === 0 ? 'main' : 'optional';
					}

					const todayMidnight = new Date();
					todayMidnight.setHours(0, 0, 0, 0);

					const nextSessionDate = upcoming.find(e => !e.cancelled)?.date ?? null;

					function pad2(n: number): string { return String(n).padStart(2, '0'); }
					function toDateStr(y: number, m: number, d: number): string {
						return `${y}-${pad2(m + 1)}-${pad2(d)}`;
					}

					const DOW_LABELS = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];

					function buildMonthHTML(year: number, month: number, isCurrent: boolean): string {
						const monthName = new Date(year, month, 1).toLocaleDateString('en-US', {
							month: 'long', year: 'numeric',
						});
						const firstDOW = new Date(year, month, 1).getDay();
						const daysInMonth = new Date(year, month + 1, 0).getDate();
						let html = `<div class="cal-month${isCurrent ? ' current-month' : ''}">
							<div class="cal-month-header">${monthName}</div>
							<div class="cal-grid">`;

						for (const label of DOW_LABELS) {
							html += `<div class="cal-dow">${label}</div>`;
						}
						for (let blank = 0; blank < firstDOW; blank++) {
							html += `<div class="cal-day"></div>`;
						}

						for (let d = 1; d <= daysInMonth; d++) {
							const dateStr = toDateStr(year, month, d);
							const cellDate = new Date(year, month, d);
							cellDate.setHours(0, 0, 0, 0);
							const isToday = cellDate.getTime() === todayMidnight.getTime();
							const isPast = cellDate < todayMidnight;
							const isSessionDay = cellDate.getDay() === effectiveDOW() || (calSettings.dow2 !== null && cellDate.getDay() === calSettings.dow2);
							const todayClass = isToday ? ' today' : '';

							const dayEvents = dateMap.get(dateStr);
							if (dayEvents && dayEvents.length > 0) {
								const active = dayEvents.find(e => !e.cancelled) || dayEvents[0];
								const isCancelled = active.cancelled;
								const typeClass = active.sessionType === 'main' ? 'main-session' : 'optional-session';
								const safeId = active.id.replace(/[^a-zA-Z0-9_-]/g, '_');
								const tooltipText = isCancelled
									? `Cancelled · ${active.title}`
									: active.title;
								const pastClass = isPast ? ' past' : '';
								const scrollAttr = !isCancelled ? ` data-scroll-to="${safeId}"` : '';
								const cancelClass = isCancelled ? ' cancelled' : '';
                                                            const nextClass = (!isPast && !isCancelled && dateStr === nextSessionDate) ? ' next-session' : '';
								html += `<div class="cal-day session ${typeClass}${cancelClass}${pastClass}${nextClass}${todayClass}"${scrollAttr}>${d}<span class="cal-tooltip">${tooltipText}</span></div>`;
							} else if (isSessionDay && !isPast && calSettings.extrapolate) {
								const isPrimary = cellDate.getDay() === effectiveDOW();
								const expectedType = isPrimary ? getExpectedType(dateStr) : 'optional';
								const typeClass = expectedType === 'main' ? 'main-session' : 'optional-session';
								const typeLabel = expectedType === 'main' ? 'Main Session' : 'Optional Session';
								html += `<div class="cal-day extrapolated ${typeClass}${todayClass}">${d}<span class="cal-tooltip">Not yet scheduled · ${typeLabel}</span></div>`;
							} else {
								html += `<div class="cal-day${todayClass}">${d}</div>`;
							}
						}

						html += `</div></div>`;
						return html;
					}

					// Pre-build all 6 month HTMLs (offsets -2 … +3 from current month)
					// Index 0 = -2 months, index 2 = current month, index 5 = +3 months
					const MONTH_COUNT = 6;
					const CURRENT_IDX = 2;
					let monthHTMLs: string[] = [];
					function rebuildMonths(): void {
						monthHTMLs = [];
						for (let i = 0; i < MONTH_COUNT; i++) {
							const offset = i - CURRENT_IDX;
							const d = new Date(todayMidnight.getFullYear(), todayMidnight.getMonth() + offset, 1);
							monthHTMLs.push(buildMonthHTML(d.getFullYear(), d.getMonth(), i === CURRENT_IDX));
						}
					}
					rebuildMonths();

					const legendHTML = `
						<div class="calendar-legend">
							<span class="legend-item"><span class="legend-dot main"></span>Main Session</span>
							<span class="legend-item"><span class="legend-dot optional"></span>Optional Session</span>
							<span class="legend-item"><span class="legend-dot cancelled"></span>Cancelled</span>
							<span class="legend-item"><span class="legend-dot extrapolated-main"></span>Potential Main</span>
							<span class="legend-item"><span class="legend-dot extrapolated-optional"></span>Potential Optional</span>
						</div>`;

					// viewStart: which index is shown as the left column (right = viewStart + 1)
					// Default: show current month (idx 2) + next month (idx 3)
					let viewStart = CURRENT_IDX;

					let settingsOpen = false;

					const DOW_NAMES = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

					function buildSettingsHTML(): string {
						if (!isAdmin) return '';
						const gearSVG = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7 7 0 0 0-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54a7.37 7.37 0 0 0-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.47.47 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.36 1.04.67 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54a7.37 7.37 0 0 0 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.47.47 0 0 0-.12-.61l-2.01-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z"/></svg>';
						const dowOpts = DOW_NAMES.map((n, i) => '<option value="' + i + '"' + (calSettings.dowOverride === i ? ' selected' : '') + '>' + n + '</option>').join('');
						const dow2Opts = DOW_NAMES.map((n, i) => '<option value="' + i + '"' + (calSettings.dow2 === i ? ' selected' : '') + '>' + n + '</option>').join('');
						const openClass = settingsOpen ? ' open' : '';
						const dowAutoSel = calSettings.dowOverride === null ? ' selected' : '';
						const dow2Chk = calSettings.dow2 !== null ? ' checked' : '';
						const dow2Dis = calSettings.dow2 === null ? ' disabled' : '';
						const extChk = calSettings.extrapolate ? ' checked' : '';
						return '<div class="cal-settings' + openClass + '">' +
							'<button class="cal-settings-toggle" id="cal-settings-btn" type="button">' + gearSVG + ' Options</button>' +
							'<div class="cal-settings-panel">' +
							'<div class="cal-setting-row"><span class="cal-setting-label">Session day</span>' +
							'<select class="cal-select" id="cal-dow-select">' +
							'<option value=""' + dowAutoSel + '>Auto (' + DOW_NAMES[autoDOW] + ')</option>' +
							dowOpts + '</select></div>' +
							'<div class="cal-setting-row"><span class="cal-setting-label">Second session day</span>' +
							'<input type="checkbox" id="cal-dow2-enable" class="cal-checkbox"' + dow2Chk + '>' +
							'<select class="cal-select" id="cal-dow2-select"' + dow2Dis + '>' + dow2Opts + '</select></div>' +
							'<div class="cal-setting-row"><span class="cal-setting-label">Show potential sessions</span>' +
							'<input type="checkbox" id="cal-extrapolate" class="cal-checkbox"' + extChk + '></div>' +
							'</div></div>';
					}
function wireScrollHandlers(): void {
						calContainer!.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach(cell => {
							cell.addEventListener('click', () => {
								const safeId = cell.dataset.scrollTo!;
								const target = document.getElementById(`event-card-${safeId}`);
								if (!target) return;
								target.scrollIntoView({ behavior: 'smooth', block: 'center' });
								target.classList.remove('cal-highlighted');
								void (target as HTMLElement).offsetWidth;
								target.classList.add('cal-highlighted');
								setTimeout(() => target.classList.remove('cal-highlighted'), 1600);
							});
						});
					}

					function render(): void {
						const canPrev = viewStart > 0;
						const canNext = viewStart < MONTH_COUNT - 2; // max viewStart = 4 (shows idx 4+5)

						const prevSVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/></svg>`;
						const nextSVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>`;

						calContainer!.innerHTML = `
							<div class="calendar-section">
								<div class="session-calendar">
									${legendHTML}

									${buildSettingsHTML()}
									<div class="cal-nav">
										<button class="cal-nav-btn" id="cal-prev" ${canPrev ? '' : 'disabled'}>
											${prevSVG} Earlier
										</button>
										<button class="cal-nav-btn" id="cal-next" ${canNext ? '' : 'disabled'}>
											Later ${nextSVG}
										</button>
									</div>
									<div class="calendar-months">${monthHTMLs[viewStart]}${monthHTMLs[viewStart + 1]}</div>
								</div>
							</div>`;

						document.getElementById('cal-prev')?.addEventListener('click', () => {
							if (viewStart > 0) { viewStart--; render(); }
						});
						document.getElementById('cal-next')?.addEventListener('click', () => {
							if (viewStart < MONTH_COUNT - 2) { viewStart++; render(); }
						});
						
						document.getElementById('cal-settings-btn')?.addEventListener('click', () => { settingsOpen = !settingsOpen; render(); });
						(document.getElementById('cal-dow-select') as HTMLSelectElement | null)?.addEventListener('change', function() {
							calSettings.dowOverride = (this as HTMLSelectElement).value === '' ? null : parseInt((this as HTMLSelectElement).value);
							saveCalSettings(calSettings); rebuildMonths(); render();
						});
						const _dow2En = document.getElementById('cal-dow2-enable') as HTMLInputElement | null;
						const _dow2Sel = document.getElementById('cal-dow2-select') as HTMLSelectElement | null;
						_dow2En?.addEventListener('change', () => {
							if (_dow2En!.checked) { calSettings.dow2 = calSettings.dow2 ?? (effectiveDOW() + 3) % 7; if (_dow2Sel) { _dow2Sel.disabled = false; _dow2Sel.value = String(calSettings.dow2); } }
							else { calSettings.dow2 = null; if (_dow2Sel) _dow2Sel.disabled = true; }
							saveCalSettings(calSettings); rebuildMonths(); render();
						});
						_dow2Sel?.addEventListener('change', () => { calSettings.dow2 = parseInt(_dow2Sel!.value); saveCalSettings(calSettings); rebuildMonths(); render(); });
						(document.getElementById('cal-extrapolate') as HTMLInputElement | null)?.addEventListener('change', function() { calSettings.extrapolate = (this as HTMLInputElement).checked; saveCalSettings(calSettings); rebuildMonths(); render(); });
						wireScrollHandlers();
					}

					render();
				}

				buildCalendar();
			}

			initScheduling();
			document.addEventListener('astro:after-swap', initScheduling);
		</script>
	</body>
</html>
