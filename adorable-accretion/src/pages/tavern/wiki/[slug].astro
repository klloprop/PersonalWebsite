---
export const prerender = false;

/**
 * tavern/wiki/[slug].astro — Individual wiki entry page (SSR + ISR).
 *
 * Body content is fetched from GitHub at request time for instant updates.
 * Hero images and collection chips come from the build-time content collection.
 * ISR caches the result; on-demand revalidation busts it after edits.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import D20Icon from '../../../assets/D20_Icon.png';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import WikiLinks from '../../../components/WikiLinks.astro';
import { SITE_TITLE } from '../../../consts';
import { renderFromGitHub } from '../../../lib/content-renderer';

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404, statusText: 'Not Found' });

// Look up entry in content collection for hero image + collection metadata.
// Use case-insensitive + space-normalised comparison so mixed-case filenames
// (e.g. NailoStory.md, alianaStarwielder.md) and [[Slug]] wiki links all work.
const entries = await getCollection('wiki');
const entry = entries.find((e) => {
	const normalized = (e.id.split('/').pop() ?? '').toLowerCase().replace(/\s+/g, '-');
	return normalized === slug.toLowerCase();
});

if (!entry) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Derive a project-relative path with correct original casing.
// entry.id is lowercased by Astro's glob loader, so Characters/CoreNPCs/mask
// becomes characters/corenpcs/mask — wrong for the case-sensitive GitHub API.
// entry.filePath preserves real casing but is an absolute filesystem path, so
// we strip everything before the first occurrence of src/content/wiki/.
function projectRelativePath(absPath: string): string {
	const normalized = absPath.replace(/\\/g, '/');
	const idx = normalized.indexOf('src/content/wiki/');
	return idx >= 0 ? normalized.slice(idx) : `src/content/wiki/${entry!.id}.md`;
}
const filePath = entry.filePath
	? projectRelativePath(entry.filePath)
	: `src/content/wiki/${entry.id}.md`;

// Fetch latest body from GitHub (instant updates, no rebuild needed)
let rendered;
try {
	rendered = await renderFromGitHub('wiki', filePath, slug);
} catch {
	// GitHub fetch failed — fall through with empty body so the page still loads.
	rendered = null;
}

// Use GitHub frontmatter for title/description (instant update), fall back to collection
const title = rendered?.frontmatter.title || entry.data.title;
const description = rendered?.frontmatter.description || entry.data.description;
const bodyHtml = rendered?.html || '';

// Hero image & collection from build-time content collection (requires rebuild to change)
const { heroImage, heroImagePosition, collection } = entry.data;
const pubDate = rendered?.frontmatter.pubDate
	? new Date(rendered.frontmatter.pubDate)
	: entry.data.pubDate;
const updatedDate = rendered?.frontmatter.updatedDate
	? new Date(rendered.frontmatter.updatedDate)
	: entry.data.updatedDate;

// Edit slug uses original-cased path
const editSlug = filePath.replace(/^src\/content\/wiki\//, '').replace(/\.\w+$/, '');

// Always serve fresh runtime content for live edits.
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

// Build ancestor chain for collection chips
const collectionEntries = await getCollection('wikiCollections');
const colParentMap = new Map<string, string>();
for (const col of collectionEntries) {
	if (col.data.parent) colParentMap.set(col.data.name, col.data.parent);
}
function getAncestors(name: string): string[] {
	const chain: string[] = [];
	let current: string | undefined = name;
	while (current) {
		chain.unshift(current);
		current = colParentMap.get(current);
	}
	return chain;
}
const collectionChain = collection ? getAncestors(collection) : [];
---

<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - ${title}`} description={description} />
		<style>
			html {
				margin: 0;
				padding: 0;
			}
			main {
				margin-top: 0;
				width: 100%;
				max-width: 100%;
				padding: 0;
				flex: 1;
			}
			.hero-image {
				width: 100vw;
				height: 50vh;
				min-height: 250px;
				max-height: 500px;
				overflow: hidden;
				position: relative;
				margin: -60px 0 0 0;
				padding: 0;
			}
			.hero-image::after {
				content: '';
				display: block;
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(245, 228, 196, 0) 55%, rgba(245, 228, 196, 1) 100%);
				pointer-events: none;
			}
			:global(html.dark) .hero-image::after {
				background: linear-gradient(180deg, rgba(26, 16, 8, 0) 55%, rgba(26, 16, 8, 1) 100%);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: var(--hero-position, center);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em;
				color: #3E2703;
			}
			:global(html.dark) .prose {
				color: #F5E4C4;
			}
			.meta-date {
				margin: 0 0 1rem 0;
				color: #8B6914;
			}
			:global(html.dark) .meta-date {
				color: #C4A35A;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.75rem 0;
				font-family: Georgia, 'Times New Roman', serif;
				color: #3E2703;
			}
			:global(html.dark) .title h1 {
				color: #DEB96E;
			}
			.last-updated-on {
				font-style: italic;
			}
			.title-chips {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 0.75rem;
			}
			.collection-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.3em 0.85em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.12);
				color: #5C3D0E;
				font-size: 0.85rem;
				font-weight: 600;
				font-family: Georgia, 'Times New Roman', serif;
				text-decoration: none;
				transition: background 0.2s;
			}
			.chip-sep {
				color: #C4A35A;
				font-size: 1rem;
				line-height: 1;
			}
			.collection-chip:hover {
				background: rgba(139, 105, 20, 0.22);
			}
			.collection-chip svg {
				width: 14px;
				height: 14px;
			}
			:global(html.dark) .collection-chip {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			:global(html.dark) .collection-chip:hover {
				background: rgba(222, 185, 110, 0.25);
			}
			.title-row {
				position: relative;
				text-align: center;
			}
			.title-row h1 {
				margin: 0;
			}
			.edit-entry-btn {
				position: absolute;
				right: 0;
				top: 50%;
				transform: translateY(-50%);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2rem;
				height: 2rem;
				border-radius: 50%;
				background: rgba(139, 105, 20, 0.1);
				color: #5C3D0E;
				text-decoration: none;
				transition: background 0.2s;
			}
			.edit-entry-btn:hover {
				background: rgba(139, 105, 20, 0.22);
			}
			:global(html.dark) .edit-entry-btn {
				background: rgba(222, 185, 110, 0.12);
				color: #DEB96E;
			}
			:global(html.dark) .edit-entry-btn:hover {
				background: rgba(222, 185, 110, 0.22);
			}
			/* ── PDF embed wrapper ── */
			/* .pdf-embed in markdown body is rendered via set:html so needs :global */
			.prose :global(.pdf-embed) {
				margin: 0 -15rem;
			}
			@media (max-width: 1200px) {
				.prose :global(.pdf-embed) {
					margin: 0;
				}
			}
			/* ── Responsive PDF iframes ── */
			.prose :global(iframe) {
				display: block;
				width: 100% !important;
				border: none;
				height: min(1200px, 85vh);
			}
			@media (max-width: 768px) {
				.prose :global(iframe) {
					height: 75vh;
				}
			}
			@media (max-width: 480px) {
				.prose :global(iframe) {
					height: 65vh;
				}
			}

		</style>
	</head>

	<body>
		<Header />
		{heroImage && (
			<div class="hero-image" style={`--hero-position: ${heroImagePosition}`}>
				<Image src={heroImage} alt={title} width={1600} densities={[1]} />
			</div>
		)}
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="title-chips">
							<a class="collection-chip" href="/tavern/wiki/?collection=all">
								<svg viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
								All Entries
							</a>
							{collectionChain.length > 0 && (
								<span class="chip-sep">›</span>
							)}
							{collectionChain.map((name, idx) => (
								<>
									<a class="collection-chip" href={`/tavern/wiki/?collection=${encodeURIComponent(name)}`}>
										<svg viewBox="0 0 20 20" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
										{name}
									</a>
									{idx < collectionChain.length - 1 && <span class="chip-sep">›</span>}
								</>
							))}
						</div>
						<div class="title-row">
							<h1>{title}</h1>
							<a
								class="edit-entry-btn"
								id="edit-btn"
								href={`/tavern/edit/wiki/${editSlug}`}
								hidden
								title="Edit this entry"
							>
								<svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
							</a>
						</div>
						<p class="meta-date">{new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
						<hr />
					</div>
					<Fragment set:html={bodyHtml} />
				</div>
			</article>
		</main>
		<Footer />
		<WikiLinks />
		<script>
			// Show edit button only for authenticated users
			fetch('/api/auth/me')
				.then((r) => r.ok ? r.json() : Promise.reject())
				.then((data) => {
					if (data?.username) {
						const btn = document.getElementById('edit-btn');
						if (btn) btn.hidden = false;
					}
				})
				.catch(() => {});
		</script>
	</body>
</html>
