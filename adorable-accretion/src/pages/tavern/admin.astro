---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const user = Astro.locals.user!;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Admin`} description="Admin panel" />
	</head>
	<body>
		<Header />
		<main>
			<div class="admin-header">
				<h1>Admin Panel</h1>
				<div class="admin-meta">
					<span>Logged in as <strong>{user.username}</strong></span>
					<a href="/tavern/library" class="btn-secondary">Library</a>
					<button id="logout-btn" class="btn-secondary">Log Out</button>
				</div>
			</div>

			<!-- ============ USER MANAGEMENT ============ -->
			<section>
				<h2>Create User</h2>
				<form id="create-user-form" class="inline-form">
					<input type="text" id="new-username" placeholder="Username" required
						pattern="[a-zA-Z0-9_\-]{2,30}" title="2-30 chars: letters, numbers, _ or -" />
					<select id="new-role">
						<option value="user">User</option>
						<option value="admin">Admin</option>
					</select>
					<button type="submit">Create</button>
				</form>
				<div id="create-result" class="result-box" hidden></div>

				<h2>Existing Users</h2>
				<div id="users-list" class="card-list">
					<p class="loading">Loading…</p>
				</div>
			</section>

			<!-- ============ VOTE MANAGEMENT ============ -->
			<section>
				<h2>Clear Availability Votes</h2>
				<p style="font-size:0.9rem;opacity:0.75;margin:0 0 0.75rem;">Use this when a session is rescheduled and its file is reused, causing old votes to carry over.</p>
				<form id="clear-votes-form" class="inline-form">
					<input type="text" id="votes-event-id" placeholder="Event ID (e.g. session-52)" required
						pattern="[a-zA-Z0-9_\-]+" title="Letters, numbers, hyphens and underscores only" />
					<button type="submit">Clear Votes</button>
				</form>
				<div id="votes-result" class="result-box" hidden></div>
			</section>

			<!-- ============ WIKI COLLECTION VISIBILITY ============ -->
			<section>
				<h2>Wiki Collection Visibility</h2>
				<p style="font-size:0.9rem;opacity:0.75;margin:0 0 0.75rem;">Set collections to <strong>user</strong> or <strong>admin</strong>. Changes are live immediately. Child collections inherit <strong>admin</strong> visibility from admin-only parents.</p>
				<div class="visibility-legend" role="note" aria-label="Visibility inheritance legend">
					<p><strong>How inheritance works</strong></p>
					<p><span class="legend-badge">Parent: admin</span> + <span class="legend-badge">Child: user</span> => <span class="legend-badge effective">Child effective: admin</span></p>
					<p><span class="legend-badge">Parent: user</span> + <span class="legend-badge">Child: admin</span> => <span class="legend-badge effective">Child effective: admin</span></p>
					<p class="legend-note">"Default" uses frontmatter visibility from the collection file.</p>
				</div>
				<div id="wiki-visibility-result" class="result-box" hidden></div>
				<div id="wiki-visibility-list" class="card-list">
					<p class="loading">Loading…</p>
				</div>
			</section>

			<section>
				<h2>Wiki Entry Visibility</h2>
				<p style="font-size:0.9rem;opacity:0.75;margin:0 0 0.75rem;">Set individual wiki entries to <strong>user</strong> or <strong>admin</strong>. Collection-level admin visibility still applies and can force effective admin visibility.</p>
				<div id="wiki-entry-visibility-result" class="result-box" hidden></div>
				<div id="wiki-entry-visibility-list" class="card-list">
					<p class="loading">Loading…</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.admin-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.admin-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.9rem;
	}
	.btn-secondary {
		padding: 0.4rem 0.8rem;
		border: 1px solid #c99026;
		border-radius: 4px;
		background: transparent;
		color: #744908;
		text-decoration: none;
		cursor: pointer;
		font-size: 0.85rem;
	}
	.btn-secondary:hover {
		background: rgba(201, 144, 38, 0.15);
	}

	/* Forms */
	.inline-form {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		align-items: center;
		margin-bottom: 1rem;
	}
	.inline-form input,
	.inline-form select {
		padding: 0.5rem;
		border: 1px solid #c99026;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.8);
	}
	.inline-form button {
		padding: 0.5rem 1rem;
		background: #744908;
		color: #F5E4C4;
		border: none;
		border-radius: 4px;
		cursor: pointer;
		font-weight: bold;
	}
	.inline-form button:hover {
		background: #c99026;
	}

	/* Results & cards */
	.result-box {
		padding: 0.75rem 1rem;
		border-radius: 4px;
		margin-bottom: 1.5rem;
		word-break: break-all;
	}
	.result-box.success {
		background: rgba(34, 139, 34, 0.1);
		border: 1px solid #2a7a2a;
		color: #2a7a2a;
	}
	.result-box.error {
		background: rgba(170, 0, 0, 0.1);
		border: 1px solid #a00;
		color: #a00;
	}
	.card-list {
		display: grid;
		gap: 0.5rem;
	}
	.card {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		border: 1px solid rgba(201, 144, 38, 0.3);
		border-radius: 6px;
	}
	.card-info {
		flex: 1;
	}
	.card-info strong {
		display: block;
	}
	.card-info small {
		opacity: 0.7;
	}
	.card-actions {
		display: flex;
		gap: 0.4rem;
		flex-shrink: 0;
	}
	.card-actions button {
		padding: 0.3rem 0.6rem;
		border: 1px solid;
		border-radius: 4px;
		cursor: pointer;
		font-size: 0.8rem;
		background: transparent;
	}
	.btn-reset {
		color: #744908;
		border-color: #c99026;
	}
	.btn-reset:hover {
		background: rgba(201, 144, 38, 0.15);
	}
	.btn-delete {
		color: #a00;
		border-color: #a00;
	}
	.btn-delete:hover {
		background: rgba(170, 0, 0, 0.1);
	}
	.card-select {
		padding: 0.35rem 0.5rem;
		border: 1px solid #c99026;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.85);
		color: #744908;
	}
	.visibility-legend {
		margin: 0 0 0.85rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid rgba(201, 144, 38, 0.35);
		border-radius: 6px;
		background: rgba(245, 228, 196, 0.28);
		font-size: 0.85rem;
	}
	.visibility-legend p {
		margin: 0.2rem 0;
	}
	.legend-badge {
		display: inline-block;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		border: 1px solid rgba(201, 144, 38, 0.55);
		background: rgba(255, 255, 255, 0.7);
	}
	.legend-badge.effective {
		border-color: rgba(160, 39, 39, 0.6);
		background: rgba(160, 39, 39, 0.08);
	}
	.legend-note {
		opacity: 0.8;
	}
	.collection-path {
		opacity: 0.7;
		font-size: 0.8rem;
	}
	.entry-id {
		opacity: 0.6;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
		font-size: 0.75rem;
		word-break: break-all;
	}
	.loading {
		color: #888;
		font-style: italic;
	}

	/* Dark mode */
	:global(html.dark) .btn-secondary {
		color: #DEB96E;
		border-color: #6B4710;
	}
	:global(html.dark) .inline-form input,
	:global(html.dark) .inline-form select {
		background: rgba(30, 20, 10, 0.6);
		color: #F5E4C4;
		border-color: #6B4710;
	}
	:global(html.dark) .inline-form button {
		background: #6B4710;
	}
	:global(html.dark) .inline-form button:hover {
		background: #8B6914;
	}
	:global(html.dark) .card {
		border-color: rgba(107, 71, 16, 0.4);
	}
	:global(html.dark) .btn-reset {
		color: #DEB96E;
		border-color: #6B4710;
	}
	:global(html.dark) .btn-delete {
		color: #ff8080;
		border-color: #ff8080;
	}
	:global(html.dark) .card-select {
		background: rgba(30, 20, 10, 0.6);
		color: #F5E4C4;
		border-color: #6B4710;
	}
	:global(html.dark) .visibility-legend {
		border-color: rgba(107, 71, 16, 0.55);
		background: rgba(30, 20, 10, 0.5);
	}
	:global(html.dark) .legend-badge {
		border-color: rgba(222, 185, 110, 0.45);
		background: rgba(30, 20, 10, 0.55);
	}
	:global(html.dark) .legend-badge.effective {
		border-color: rgba(255, 128, 128, 0.55);
		background: rgba(255, 128, 128, 0.12);
	}
	:global(html.dark) .result-box.success {
		color: #6bdf6b;
		border-color: #3a9a3a;
		background: rgba(34, 139, 34, 0.15);
	}
	:global(html.dark) .result-box.error {
		color: #ff8080;
		border-color: #cc4444;
		background: rgba(170, 0, 0, 0.15);
	}
</style>

<script>
	// ----------- Helpers -----------
	function showResult(id: string, message: string, isError = false) {
		const el = document.getElementById(id) as HTMLDivElement;
		el.textContent = message;
		el.className = `result-box ${isError ? 'error' : 'success'}`;
		el.hidden = false;
	}

	// ----------- Load users -----------
	async function loadUsers() {
		const container = document.getElementById('users-list')!;
		try {
			const res = await fetch('/api/admin/users');
			const data = await res.json();
			if (!data.users?.length) {
				container.innerHTML = '<p class="loading">No users found.</p>';
				return;
			}
			container.innerHTML = data.users
				.map(
					(u: string) => `
				<div class="card">
					<div class="card-info"><strong>${escapeHtml(u)}</strong></div>
					<div class="card-actions">
						<button class="btn-reset" data-user="${escapeHtml(u)}" data-action="reset">Reset Password</button>
						<button class="btn-delete" data-user="${escapeHtml(u)}" data-action="delete">Delete</button>
					</div>
				</div>`,
				)
				.join('');
			attachUserActions();
		} catch {
			container.innerHTML = '<p class="loading">Failed to load users.</p>';
		}
	}

	function escapeHtml(s: string) {
		return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
	}

	function escapeAttr(s: string) {
		return escapeHtml(s).replace(/'/g, '&#39;');
	}

	function attachUserActions() {
		document.querySelectorAll<HTMLButtonElement>('[data-action="reset"]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const username = btn.dataset.user!;
				btn.disabled = true;
				try {
					const res = await fetch('/api/admin/reset-link', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ username }),
					});
					const data = await res.json();
					if (res.ok) {
						showResult('create-result', `Reset link for ${username}: ${data.resetUrl}`);
					} else {
						showResult('create-result', data.error || 'Failed', true);
					}
				} catch {
					showResult('create-result', 'Request failed', true);
				} finally {
					btn.disabled = false;
				}
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-action="delete"]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const username = btn.dataset.user!;
				if (!confirm(`Delete user "${username}"? This cannot be undone.`)) return;
				btn.disabled = true;
				try {
					const res = await fetch('/api/admin/users', {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ username }),
					});
					if (res.ok) {
						loadUsers();
					} else {
						const data = await res.json();
						showResult('create-result', data.error || 'Failed', true);
					}
				} catch {
					showResult('create-result', 'Request failed', true);
				}
			});
		});
	}

	// ----------- Wiki collection visibility -----------
	async function loadWikiVisibility() {
		const container = document.getElementById('wiki-visibility-list')!;
		try {
			const res = await fetch('/api/admin/wiki-collection-visibility');
			const data = await res.json();
			if (!res.ok) {
				container.innerHTML = '<p class="loading">Failed to load collections.</p>';
				return;
			}

			const cols = data.collections as Array<{
				id: string;
				name: string;
				parentId: string | null;
				parentName: string | null;
				defaultVisibility: 'user' | 'admin';
				overrideVisibility: 'user' | 'admin' | null;
				effectiveVisibility: 'user' | 'admin';
			}>;

			if (!cols.length) {
				container.innerHTML = '<p class="loading">No wiki collections found.</p>';
				return;
			}

			container.innerHTML = cols.map((col) => {
				const selected = col.overrideVisibility ?? 'default';
				const parentText = col.parentName ? `Parent: ${escapeHtml(col.parentName)}` : 'Root collection';
				return `
				<div class="card">
					<div class="card-info">
						<strong>${escapeHtml(col.name)}</strong>
						<small class="collection-path">${parentText}</small>
						<small class="entry-id">ID: ${escapeHtml(col.id)}</small>
						<small>Effective visibility: <strong>${escapeHtml(col.effectiveVisibility)}</strong> (default: ${escapeHtml(col.defaultVisibility)})</small>
					</div>
					<div class="card-actions">
						<select class="card-select" data-wiki-collection-id="${escapeAttr(col.id)}">
							<option value="default" ${selected === 'default' ? 'selected' : ''}>Default (${escapeHtml(col.defaultVisibility)})</option>
							<option value="user" ${selected === 'user' ? 'selected' : ''}>user</option>
							<option value="admin" ${selected === 'admin' ? 'selected' : ''}>admin</option>
						</select>
					</div>
				</div>`;
			}).join('');

			attachWikiVisibilityActions();
		} catch {
			container.innerHTML = '<p class="loading">Failed to load collections.</p>';
		}
	}

	function attachWikiVisibilityActions() {
		document.querySelectorAll<HTMLSelectElement>('[data-wiki-collection-id]').forEach((select) => {
			select.addEventListener('change', async () => {
				const id = select.dataset.wikiCollectionId;
				if (!id) return;
				const value = select.value;
				select.disabled = true;
				try {
					const body = value === 'default'
						? { id, mode: 'default' }
						: { id, visibility: value };
					const res = await fetch('/api/admin/wiki-collection-visibility', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(body),
					});
					const data = await res.json();
					if (!res.ok) {
						showResult('wiki-visibility-result', data.error || 'Failed to update visibility', true);
						await loadWikiVisibility();
						return;
					}
					showResult('wiki-visibility-result', 'Updated collection visibility.');
					await loadWikiVisibility();
				} catch {
					showResult('wiki-visibility-result', 'Request failed', true);
				} finally {
					select.disabled = false;
				}
			});
		});
	}

	async function loadWikiEntryVisibility() {
		const container = document.getElementById('wiki-entry-visibility-list')!;
		try {
			const res = await fetch('/api/admin/wiki-entry-visibility');
			const data = await res.json();
			if (!res.ok) {
				container.innerHTML = '<p class="loading">Failed to load entries.</p>';
				return;
			}

			const entries = data.entries as Array<{
				id: string;
				title: string;
				collectionRef: string | null;
				defaultVisibility: 'user' | 'admin';
				overrideVisibility: 'user' | 'admin' | null;
				effectiveVisibility: 'user' | 'admin';
			}>;

			if (!entries.length) {
				container.innerHTML = '<p class="loading">No wiki entries found.</p>';
				return;
			}

			container.innerHTML = entries.map((entry) => {
				const selected = entry.overrideVisibility ?? 'default';
				const collectionText = entry.collectionRef ? `Collection ref: ${escapeHtml(entry.collectionRef)}` : 'No collection';
				return `
				<div class="card">
					<div class="card-info">
						<strong>${escapeHtml(entry.title)}</strong>
						<small class="collection-path">${collectionText}</small>
						<small class="entry-id">ID: ${escapeHtml(entry.id)}</small>
						<small>Effective visibility: <strong>${escapeHtml(entry.effectiveVisibility)}</strong> (default: ${escapeHtml(entry.defaultVisibility)})</small>
					</div>
					<div class="card-actions">
						<select class="card-select" data-wiki-entry-id="${escapeAttr(entry.id)}">
							<option value="default" ${selected === 'default' ? 'selected' : ''}>Default (${escapeHtml(entry.defaultVisibility)})</option>
							<option value="user" ${selected === 'user' ? 'selected' : ''}>user</option>
							<option value="admin" ${selected === 'admin' ? 'selected' : ''}>admin</option>
						</select>
					</div>
				</div>`;
			}).join('');

			attachWikiEntryVisibilityActions();
		} catch {
			container.innerHTML = '<p class="loading">Failed to load entries.</p>';
		}
	}

	function attachWikiEntryVisibilityActions() {
		document.querySelectorAll<HTMLSelectElement>('[data-wiki-entry-id]').forEach((select) => {
			select.addEventListener('change', async () => {
				const id = select.dataset.wikiEntryId;
				if (!id) return;
				const value = select.value;
				select.disabled = true;
				try {
					const body = value === 'default'
						? { id, mode: 'default' }
						: { id, visibility: value };
					const res = await fetch('/api/admin/wiki-entry-visibility', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(body),
					});
					const data = await res.json();
					if (!res.ok) {
						showResult('wiki-entry-visibility-result', data.error || 'Failed to update entry visibility', true);
						await loadWikiEntryVisibility();
						return;
					}
					showResult('wiki-entry-visibility-result', 'Updated entry visibility.');
					await loadWikiEntryVisibility();
				} catch {
					showResult('wiki-entry-visibility-result', 'Request failed', true);
				} finally {
					select.disabled = false;
				}
			});
		});
	}

	// ----------- Create user -----------
	(document.getElementById('create-user-form') as HTMLFormElement).addEventListener('submit', async (e) => {
		e.preventDefault();
		const usernameEl = document.getElementById('new-username') as HTMLInputElement;
		const roleEl = document.getElementById('new-role') as HTMLSelectElement;
		const username = usernameEl.value.trim();
		const role = roleEl.value;

		try {
			const res = await fetch('/api/admin/users', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ username, role }),
			});
			const data = await res.json();
			if (res.ok) {
				showResult('create-result', `User "${username}" created. Setup link: ${data.setupUrl}`);
				usernameEl.value = '';
				loadUsers();
			} else {
				showResult('create-result', data.error || 'Failed', true);
			}
		} catch {
			showResult('create-result', 'Request failed', true);
		}
	});

	// ----------- Logout -----------
	document.getElementById('logout-btn')?.addEventListener('click', async () => {
		await fetch('/api/auth/logout', { method: 'POST' });
		window.location.href = '/tavern/login';
	});

	// ----------- Clear votes -----------
	(document.getElementById('clear-votes-form') as HTMLFormElement).addEventListener('submit', async (e) => {
		e.preventDefault();
		const eventIdEl = document.getElementById('votes-event-id') as HTMLInputElement;
		const eventId = eventIdEl.value.trim();
		if (!confirm(`Clear ALL votes for "${eventId}"? This cannot be undone.`)) return;
		try {
			const res = await fetch('/api/admin/votes', {
				method: 'DELETE',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ eventId }),
			});
			const data = await res.json();
			if (res.ok) {
				showResult('votes-result', `All votes for "${eventId}" have been cleared.`);
				eventIdEl.value = '';
			} else {
				showResult('votes-result', data.error || 'Failed', true);
			}
		} catch {
			showResult('votes-result', 'Request failed', true);
		}
	});

	// ----------- Init -----------
	loadUsers();
	loadWikiVisibility();
	loadWikiEntryVisibility();
</script>
