---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Pen and Paper - About`} description="About pen and paper content" />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				Welcome to my tavern! This is a place where I gather informations about my Campaign(s) and share that with you!
				This website is explicitly public, all content on here is, still please do not share this website to larger groups of people or forums. You can share it with a friend.
				
				If you are wondering about the hidden section in the library (the library page), which requires a login, send me a message and I can set up an account for you!
			
			</p>
		</main>
		<Footer />
	</body>
</html>