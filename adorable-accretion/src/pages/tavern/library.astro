---
export const prerender = false;

/**
 * tavern/library.astro — Private resource library.
 *
 * - Reads files from src/assets/Ressources/ subfolders (like the gallery).
 * - Folder-based collection sidebar (like the wiki).
 * - Card grid of downloadable files.
 * - Protected by middleware (login required).
 */
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SearchBar from '../../components/SearchBar.astro';
import type { SearchItem } from '../../components/SearchBar.astro';
import { SITE_TITLE } from '../../consts';

const user = Astro.locals.user!;

// Import all files from Ressources — PDFs, PNGs, etc.
const fileModules = import.meta.glob(
	'/src/assets/Ressources/**/*.{pdf,PDF,png,PNG,jpg,jpeg,JPG,JPEG,webp,WEBP,canvas}',
	{ eager: true, query: '?url', import: 'default' }
);

interface LibraryFile {
	name: string;
	url: string;
	ext: string;
	folderPath: string;   // full folder path, e.g. "NimbleV2/Nimble-2.0.3-WITH-EXTRAS/CoreBooks"
}

const files: LibraryFile[] = [];

for (const [modulePath, url] of Object.entries(fileModules)) {
	const relPath = modulePath.replace('/src/assets/Ressources/', '');
	const parts = relPath.split('/');
	const filename = parts.pop()!;

	// Skip hidden files
	if (filename.startsWith('.')) continue;

	const ext = filename.split('.').pop()?.toLowerCase() ?? '';
	const folderPath = parts.join('/');

	files.push({
		name: filename.replace(/\.[^.]+$/, ''),
		url: url as string,
		ext,
		folderPath,
	});
}

// Sort alphabetically
files.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

// Build nested folder tree for sidebar
interface TreeNode {
	name: string;
	fullPath: string;
	count: number;       // files directly in this folder + all subfolders
	children: TreeNode[];
	depth: number;
}

function buildTree(fileList: LibraryFile[]): TreeNode[] {
	const root = new Map<string, { direct: number; children: Map<string, any> }>();

	// Collect unique folder paths and count files per exact folder
	const folderFileCounts = new Map<string, number>();
	for (const f of fileList) {
		if (f.folderPath) {
			folderFileCounts.set(f.folderPath, (folderFileCounts.get(f.folderPath) || 0) + 1);
		}
	}

	// Build tree structure
	function getOrCreate(map: Map<string, any>, segments: string[], fullPath: string): void {
		const key = segments[0];
		if (!map.has(key)) {
			map.set(key, { children: new Map() });
		}
		if (segments.length > 1) {
			getOrCreate(map.get(key).children, segments.slice(1), fullPath);
		}
	}

	for (const folderPath of folderFileCounts.keys()) {
		const segs = folderPath.split('/');
		getOrCreate(root, segs, folderPath);
	}

	// Convert to TreeNode[] recursively
	function toNodes(map: Map<string, any>, prefix: string, depth: number): TreeNode[] {
		const nodes: TreeNode[] = [];
		for (const [name, val] of [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
			const fullPath = prefix ? `${prefix}/${name}` : name;
			const children = toNodes(val.children, fullPath, depth + 1);
			// Count = files in this exact folder + all descendant files
			const directCount = folderFileCounts.get(fullPath) || 0;
			const descendantCount = children.reduce((s, c) => s + c.count, 0);
			nodes.push({ name, fullPath, count: directCount + descendantCount, children, depth });
		}
		return nodes;
	}

	return toNodes(root, '', 0);
}

const folderTree = buildTree(files);

const librarySearchItems: SearchItem[] = files.map((f, i) => ({
	name: f.name,
	url: `#file-${i}`,
	extra: f.folderPath,
}));

// Chevron SVG for toggle buttons
const chevronSvg = '<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>';
const folderSvg = '<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>';

function fileIcon(ext: string): string {
	switch (ext) {
		case 'pdf': return '📕';
		case 'png': case 'jpg': case 'jpeg': case 'webp': return '🖼️';
		case 'canvas': return '🗺️';
		default: return '📄';
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Library`} description="Private resource library" />
		<style>
			:global(html) {
				scrollbar-gutter: stable;
			}
			:global(body) {
				overflow-x: hidden;
			}
			.library-layout {
				position: relative;
				width: 100%;
				max-width: 1480px;
				margin: 0 auto;
				padding: 2.5rem 2rem 2.5rem calc(240px + 3rem);
				display: flex;
				justify-content: center;
				flex: 1;
				box-sizing: border-box;
			}
			.library-layout > :global(main) {
				width: auto !important;
				max-width: 900px;
				padding: 0 !important;
				margin: 0 !important;
			}
			/* Sidebar */
			.sidebar {
				width: 240px;
				position: fixed;
				top: 6rem;
				left: max(1rem, calc((100vw - 1260px) / 2 + 1rem));
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				padding: 1.25rem 0.75rem;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.1);
				z-index: 10;
			}
			:global(html.dark) .sidebar {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.sidebar-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.9rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #8B6914;
				margin: 0 0 0.75rem;
				padding: 0 0.5rem;
			}
			:global(html.dark) .sidebar-title {
				color: #DEB96E;
			}
			.sidebar-btn {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				width: 100%;
				padding: 0.6rem 0.75rem;
				border: none;
				border-radius: 10px;
				background: none;
				cursor: pointer;
				text-align: left;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.95rem;
				color: #3E2703;
				transition: background 0.2s;
			}
			:global(html.dark) .sidebar-btn {
				color: #F5E4C4;
			}
			.sidebar-btn:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			.sidebar-btn.active {
				background: rgba(139, 105, 20, 0.15);
				font-weight: 700;
				color: #5C3D0E;
			}
			:global(html.dark) .sidebar-btn.active {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			:global(html.dark) .sidebar-btn:hover {
				background: rgba(222, 185, 110, 0.1);
			}
			.sidebar-btn .all-icon {
				width: 36px;
				height: 36px;
				border-radius: 8px;
				background: linear-gradient(135deg, #8B6914, #5C3D0E);
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				color: #FDF6EC;
				font-size: 1.1rem;
			}
			.sidebar-btn .collection-info {
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.sidebar-btn .collection-name {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.sidebar-btn .collection-count {
				font-size: 0.75rem;
				color: #8B6914;
			}
			:global(html.dark) .sidebar-btn .collection-count {
				color: #C4A35A;
			}
			/* Tree nesting */
			.sidebar-group {
				display: flex;
				flex-direction: column;
			}
			.sidebar-group-header {
				display: flex;
				align-items: center;
				width: 100%;
			}
			.sidebar-toggle {
				width: 22px;
				height: 22px;
				border: none;
				background: none;
				cursor: pointer;
				padding: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				color: #8B6914;
				transition: transform 0.2s;
				border-radius: 4px;
			}
			.sidebar-toggle:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			:global(html.dark) .sidebar-toggle {
				color: #C4A35A;
			}
			.sidebar-toggle.expanded {
				transform: rotate(90deg);
			}
			.sidebar-children {
				display: none;
				flex-direction: column;
				padding-left: 0.75rem;
				margin-left: 0.65rem;
				border-left: 1.5px solid rgba(196, 163, 90, 0.3);
			}
			.sidebar-children.open {
				display: flex;
			}
			.sidebar-children .sidebar-btn {
				font-size: 0.88rem;
				padding: 0.45rem 0.6rem;
			}
			.sidebar-divider {
				height: 1px;
				background: #C4A35A;
				opacity: 0.4;
				margin: 0.5rem 0;
			}
			/* Header bar */
			.library-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.library-header h1 {
				font-family: Georgia, 'Times New Roman', serif;
				color: #3E2703;
				margin: 0;
			}
			:global(html.dark) .library-header h1 {
				color: #DEB96E;
			}
			.library-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 0.9rem;
			}
			.btn-secondary {
				padding: 0.4rem 0.8rem;
				border: 1px solid #C4A35A;
				border-radius: 4px;
				background: transparent;
				color: #744908;
				text-decoration: none;
				cursor: pointer;
				font-size: 0.85rem;
				font-family: Georgia, 'Times New Roman', serif;
			}
			.btn-secondary:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			:global(html.dark) .btn-secondary {
				color: #DEB96E;
				border-color: #7a5c2e;
			}
			:global(html.dark) .btn-secondary:hover {
				background: rgba(222, 185, 110, 0.1);
			}
			/* File grid */
			.file-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.file-card {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
				overflow: hidden;
				transition: transform 0.15s, box-shadow 0.15s;
			}
			:global(html.dark) .file-card {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.file-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 20px rgba(62, 39, 3, 0.15);
			}
			.file-card.search-highlight {
				animation: search-pulse 2s ease-out;
			}
			@keyframes search-pulse {
				0%, 20% { box-shadow: 0 0 0 4px rgba(139, 105, 20, 0.4); }
				100% { box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08); }
			}
			.file-link {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 1.25rem;
				color: inherit;
				text-decoration: none;
				height: 100%;
			}
			.file-icon {
				font-size: 2rem;
				flex-shrink: 0;
				line-height: 1;
			}
			.file-info {
				flex: 1;
				min-width: 0;
			}
			.file-name {
				display: block;
				font-family: Georgia, 'Times New Roman', serif;
				font-weight: 700;
				font-size: 1rem;
				color: #3E2703;
				word-break: break-word;
			}
			:global(html.dark) .file-name {
				color: #DEB96E;
			}
			.file-card:hover .file-name {
				color: #8B6914;
			}
			:global(html.dark) .file-card:hover .file-name {
				color: #F5D680;
			}
			.file-badge {
				display: inline-block;
				font-size: 0.7rem;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.12);
				color: #5C3D0E;
				font-family: Georgia, 'Times New Roman', serif;
				text-transform: uppercase;
				margin-top: 0.35rem;
			}
			:global(html.dark) .file-badge {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.file-subfolder {
				display: block;
				font-size: 0.78rem;
				color: #8B6914;
				margin-top: 0.2rem;
			}
			:global(html.dark) .file-subfolder {
				color: #C4A35A;
			}
			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				color: #8B6914;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.1rem;
				font-style: italic;
			}
			:global(html.dark) .empty-state {
				color: #C4A35A;
			}
			/* Preview modal */
			.preview-overlay {
				display: none;
				position: fixed;
				inset: 0;
				z-index: 1000;
				background: rgba(0, 0, 0, 0.7);
				backdrop-filter: blur(4px);
				justify-content: center;
				align-items: center;
				padding: 1.5rem;
			}
			.preview-overlay.open {
				display: flex;
			}
			.preview-overlay {
				padding: 1rem;
			}
			.preview-chrome {
				display: flex;
				flex-direction: column;
				width: 95vw;
				max-width: 1400px;
				height: 92vh;
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
			}
			:global(html.dark) .preview-chrome {
				background: #1e140a;
				border-color: #7a5c2e;
			}
			.preview-toolbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.25rem;
				border-bottom: 1px solid #C4A35A;
				background: rgba(139, 105, 20, 0.08);
				flex-shrink: 0;
			}
			:global(html.dark) .preview-toolbar {
				border-color: #7a5c2e;
				background: rgba(222, 185, 110, 0.05);
			}
			.preview-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-weight: 700;
				font-size: 1rem;
				color: #3E2703;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex: 1;
				margin-right: 1rem;
			}
			:global(html.dark) .preview-title {
				color: #DEB96E;
			}
			.preview-actions {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				flex-shrink: 0;
			}
			.preview-download,
			.preview-close {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border: 1px solid #C4A35A;
				border-radius: 8px;
				background: none;
				color: #5C3D0E;
				cursor: pointer;
				transition: background 0.15s;
				text-decoration: none;
			}
			:global(html.dark) .preview-download,
			:global(html.dark) .preview-close {
				border-color: #7a5c2e;
				color: #DEB96E;
			}
			.preview-download:hover,
			.preview-close:hover {
				background: rgba(139, 105, 20, 0.15);
			}
			:global(html.dark) .preview-download:hover,
			:global(html.dark) .preview-close:hover {
				background: rgba(222, 185, 110, 0.15);
			}
			.preview-body {
				flex: 1;
				overflow: hidden;
				position: relative;
			}
			.preview-body :global(iframe) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: none;
			}
			.preview-body :global(img) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: contain;
			}
			/* Responsive */
			@media (max-width: 900px) {
				.library-layout {
					flex-direction: column;
					padding: 1.25rem;
				}
				.sidebar {
					width: 100%;
					max-width: 100%;
					box-sizing: border-box;
					position: static;
					max-height: none;
					overflow-y: visible;
					border-radius: 12px;
					padding: 0.75rem;
					margin-bottom: 1.5rem;
				}
				.sidebar-title {
					display: none;
				}
				.sidebar-divider {
					display: none;
				}
				.sidebar-toggle {
					width: 18px;
					height: 18px;
				}
				.sidebar-btn {
					font-size: 0.85rem;
					padding: 0.4rem 0.6rem;
				}
				.sidebar-btn .all-icon {
					width: 24px;
					height: 24px;
				}
				.sidebar-btn .collection-count {
					display: none;
				}
				.file-grid {
					grid-template-columns: 1fr;
				}
				.preview-chrome {
					width: 100vw;
					height: 100vh;
					border-radius: 0;
					border: none;
				}
				.preview-overlay {
					padding: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="library-layout">
			<aside class="sidebar">
				<p class="sidebar-title">Collections</p>
				<button class="sidebar-btn active" data-collection="all">
					<span class="all-icon">
						<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
					</span>
					<span class="collection-info">
						<span class="collection-name">All Files</span>
						<span class="collection-count">{files.length} files</span>
					</span>
				</button>
				<div class="sidebar-divider"></div>
				{folderTree.map((node) =>
					node.children.length > 0 ? (
						<div class="sidebar-group">
							<div class="sidebar-group-header">
								<button class="sidebar-toggle" aria-label={`Expand ${node.name}`}>
									<Fragment set:html={chevronSvg} />
								</button>
								<button class="sidebar-btn" data-collection={node.fullPath}>
									<span class="all-icon"><Fragment set:html={folderSvg} /></span>
									<span class="collection-info">
										<span class="collection-name">{node.name.replace(/-/g, ' ')}</span>
										<span class="collection-count">{node.count} {node.count === 1 ? 'file' : 'files'}</span>
									</span>
								</button>
							</div>
							<div class="sidebar-children">
								{node.children.map((child) =>
									child.children.length > 0 ? (
										<div class="sidebar-group">
											<div class="sidebar-group-header">
												<button class="sidebar-toggle" aria-label={`Expand ${child.name}`}>
													<Fragment set:html={chevronSvg} />
												</button>
												<button class="sidebar-btn" data-collection={child.fullPath}>
													<span class="collection-info">
														<span class="collection-name">{child.name.replace(/-/g, ' ')}</span>
														<span class="collection-count">{child.count} {child.count === 1 ? 'file' : 'files'}</span>
													</span>
												</button>
											</div>
											<div class="sidebar-children">
												{child.children.map((gc) =>
													gc.children.length > 0 ? (
														<div class="sidebar-group">
															<div class="sidebar-group-header">
																<button class="sidebar-toggle" aria-label={`Expand ${gc.name}`}>
																	<Fragment set:html={chevronSvg} />
																</button>
																<button class="sidebar-btn" data-collection={gc.fullPath}>
																	<span class="collection-info">
																		<span class="collection-name">{gc.name.replace(/-/g, ' ')}</span>
																		<span class="collection-count">{gc.count} {gc.count === 1 ? 'file' : 'files'}</span>
																	</span>
																</button>
															</div>
															<div class="sidebar-children">
																{gc.children.map((ggc) => (
																	<button class="sidebar-btn" data-collection={ggc.fullPath}>
																		<span class="collection-info">
																			<span class="collection-name">{ggc.name.replace(/-/g, ' ')}</span>
																			<span class="collection-count">{ggc.count} {ggc.count === 1 ? 'file' : 'files'}</span>
																		</span>
																	</button>
																))}
															</div>
														</div>
													) : (
														<button class="sidebar-btn" data-collection={gc.fullPath}>
															<span class="collection-info">
																<span class="collection-name">{gc.name.replace(/-/g, ' ')}</span>
																<span class="collection-count">{gc.count} {gc.count === 1 ? 'file' : 'files'}</span>
															</span>
														</button>
													)
												)}
											</div>
										</div>
									) : (
										<button class="sidebar-btn" data-collection={child.fullPath}>
											<span class="collection-info">
												<span class="collection-name">{child.name.replace(/-/g, ' ')}</span>
												<span class="collection-count">{child.count} {child.count === 1 ? 'file' : 'files'}</span>
											</span>
										</button>
									)
								)}
							</div>
						</div>
					) : (
						<button class="sidebar-btn" data-collection={node.fullPath}>
							<span class="all-icon"><Fragment set:html={folderSvg} /></span>
							<span class="collection-info">
								<span class="collection-name">{node.name.replace(/-/g, ' ')}</span>
								<span class="collection-count">{node.count} {node.count === 1 ? 'file' : 'files'}</span>
							</span>
						</button>
					)
				)}
			</aside>
			<main>
				<SearchBar placeholder="Search files…" items={librarySearchItems} />
				<div class="library-header">
					<h1>Library</h1>
					<div class="library-meta">
						<span>Logged in as <strong>{user.username}</strong></span>
						<button id="logout-btn" class="btn-secondary">Log Out</button>
					</div>
				</div>

				{files.length === 0 ? (
					<div class="empty-state">
						<p>No resources available yet.</p>
					</div>
				) : (
					<ul class="file-grid">
						{files.map((f, i) => (
						<li class="file-card" id={`file-${i}`} data-folder={f.folderPath}>
						<a class="file-link" href={f.url} target="_blank" rel="noopener noreferrer"
						   data-ext={f.ext} data-name={f.name}>
								<span class="file-icon">{fileIcon(f.ext)}</span>
								<div class="file-info">
									<span class="file-name">{f.name}</span>
									{f.folderPath && <span class="file-subfolder">{f.folderPath.split('/').join(' / ')}</span>}
										<span class="file-badge">{f.ext}</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</main>
		</div>

		<!-- Preview modal -->
		<div class="preview-overlay" id="preview-overlay">
			<div class="preview-chrome">
				<div class="preview-toolbar">
					<span class="preview-title" id="preview-title"></span>
					<div class="preview-actions">
						<a class="preview-download" id="preview-download" download title="Download">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
						</a>
						<button class="preview-close" id="preview-close" title="Close">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
						</button>
					</div>
				</div>
				<div class="preview-body" id="preview-body"></div>
			</div>
		</div>

		<Footer />

		<script>
			function initLibrary() {
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const toggles = document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle');
				const allItems = Array.from(document.querySelectorAll<HTMLElement>('.file-card'));

				let currentCollection = 'all';

				function filterItems() {
					allItems.forEach((item) => {
						const folder = item.dataset.folder || '';
						const show =
							currentCollection === 'all' ||
							folder === currentCollection ||
							folder.startsWith(currentCollection + '/');
						item.style.display = show ? '' : 'none';
					});
				}

				// Expand/collapse toggles
				toggles.forEach((toggle) => {
					toggle.addEventListener('click', (e) => {
						e.stopPropagation();
						const group = toggle.closest('.sidebar-group');
						if (!group) return;
						const children = group.querySelector('.sidebar-children');
						if (!children) return;
						const isOpen = children.classList.toggle('open');
						toggle.classList.toggle('expanded', isOpen);
					});
				});

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						currentCollection = btn.dataset.collection!;
						buttons.forEach((b) => b.classList.toggle('active', b.dataset.collection === currentCollection));
						filterItems();
					});
				});

				// Start with all collections expanded
				document.querySelectorAll('.sidebar-children').forEach(c => c.classList.add('open'));
				document.querySelectorAll('.sidebar-toggle').forEach(t => t.classList.add('expanded'));

				filterItems();
			}

			// Preview modal
			const previewableExts = new Set(['pdf', 'png', 'jpg', 'jpeg', 'webp']);

			function initPreview() {
				const overlay = document.getElementById('preview-overlay')!;
				const body = document.getElementById('preview-body')!;
				const title = document.getElementById('preview-title')!;
				const download = document.getElementById('preview-download') as HTMLAnchorElement;
				const closeBtn = document.getElementById('preview-close')!;

				function openPreview(url: string, name: string, ext: string) {
					title.textContent = name;
					download.href = url;
					download.download = name + '.' + ext;
					body.innerHTML = '';

					if (ext === 'pdf') {
						const iframe = document.createElement('iframe');
						iframe.src = url;
						iframe.title = name;
						body.appendChild(iframe);
					} else {
						const img = document.createElement('img');
						img.src = url;
						img.alt = name;
						body.appendChild(img);
					}

					overlay.classList.add('open');
					document.body.style.overflow = 'hidden';
				}

				function closePreview() {
					overlay.classList.remove('open');
					body.innerHTML = '';
					document.body.style.overflow = '';
				}

				// Intercept clicks on previewable file links
				document.querySelectorAll<HTMLAnchorElement>('.file-link').forEach((link) => {
					const ext = link.dataset.ext || '';
					if (previewableExts.has(ext)) {
						link.addEventListener('click', (e) => {
							e.preventDefault();
							openPreview(link.href, link.dataset.name || '', ext);
						});
					}
				});

				closeBtn.addEventListener('click', closePreview);
				overlay.addEventListener('click', (e) => {
					if (e.target === overlay) closePreview();
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && overlay.classList.contains('open')) closePreview();
				});
			}

			document.getElementById('logout-btn')?.addEventListener('click', async () => {
				await fetch('/api/auth/logout', { method: 'POST' });
				window.location.href = '/tavern/login';
			});

			initLibrary();
			initPreview();

			// Handle search-result hash links: show all, scroll to card, highlight
			function handleSearchHash() {
				const hash = window.location.hash;
				if (!hash || !hash.startsWith('#file-')) return;
				const card = document.getElementById(hash.slice(1));
				if (!card) return;

				// Reset sidebar to "All"
				const allBtn = document.querySelector<HTMLButtonElement>('.sidebar-btn[data-collection="all"]');
				if (allBtn) allBtn.click();

				// Scroll into view
				card.scrollIntoView({ behavior: 'smooth', block: 'center' });

				// Highlight briefly
				card.classList.add('search-highlight');
				setTimeout(() => card.classList.remove('search-highlight'), 2000);

				// Clear hash so it can be re-triggered
				history.replaceState(null, '', window.location.pathname + window.location.search);
			}

			// Intercept search-result clicks that point to #file-N
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest('a[href^="#file-"]');
				if (!a) return;
				e.preventDefault();
				const id = a.getAttribute('href')!.slice(1);
				window.location.hash = id;
				handleSearchHash();
			});

			window.addEventListener('hashchange', handleSearchHash);
			handleSearchHash();

			document.addEventListener('astro:after-swap', () => { initLibrary(); initPreview(); });
		</script>
	</body>
</html>
