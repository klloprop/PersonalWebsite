---
export const prerender = false;

/**
 * tavern/library.astro — Private resource library.
 *
 * - Reads files from src/assets/Ressources/ subfolders (like the gallery).
 * - Folder-based collection sidebar (like the wiki).
 * - Card grid of downloadable files.
 * - Protected by middleware (login required).
 */
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const user = Astro.locals.user!;

// Import all files from Ressources — PDFs, PNGs, etc.
const fileModules = import.meta.glob(
	'/src/assets/Ressources/**/*.{pdf,PDF,png,PNG,jpg,jpeg,JPG,JPEG,webp,WEBP,canvas}',
	{ eager: true, query: '?url', import: 'default' }
);

interface LibraryFile {
	name: string;
	url: string;
	ext: string;
	collection: string;   // top-level folder
	subfolder: string;    // full path beneath Ressources (minus filename)
}

const files: LibraryFile[] = [];

for (const [modulePath, url] of Object.entries(fileModules)) {
	const relPath = modulePath.replace('/src/assets/Ressources/', '');
	const parts = relPath.split('/');
	const filename = parts.pop()!;

	// Skip hidden files
	if (filename.startsWith('.')) continue;

	const ext = filename.split('.').pop()?.toLowerCase() ?? '';
	const collection = parts.length > 0 ? parts[0] : '';
	const subfolder = parts.length > 1 ? parts.slice(1).join(' / ') : '';

	files.push({
		name: filename.replace(/\.[^.]+$/, ''),
		url: url as string,
		ext,
		collection,
		subfolder,
	});
}

// Sort alphabetically
files.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

// Discover collections from folder names
const collectionCounts = new Map<string, number>();
for (const f of files) {
	if (f.collection) {
		collectionCounts.set(f.collection, (collectionCounts.get(f.collection) || 0) + 1);
	}
}
const collections = [...collectionCounts.entries()]
	.sort((a, b) => a[0].localeCompare(b[0]))
	.map(([name, count]) => ({ name, count }));

function fileIcon(ext: string): string {
	switch (ext) {
		case 'pdf': return '📕';
		case 'png': case 'jpg': case 'jpeg': case 'webp': return '🖼️';
		case 'canvas': return '🗺️';
		default: return '📄';
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Library`} description="Private resource library" />
		<style>
			:global(html) {
				scrollbar-gutter: stable;
			}
			.library-layout {
				position: relative;
				width: 100%;
				max-width: 1480px;
				margin: 0 auto;
				padding: 2.5rem 2rem 2.5rem calc(240px + 3rem);
				display: flex;
				justify-content: center;
				flex: 1;
				box-sizing: border-box;
			}
			.library-layout > :global(main) {
				width: auto !important;
				max-width: 900px;
				padding: 0 !important;
				margin: 0 !important;
			}
			/* Sidebar */
			.sidebar {
				width: 240px;
				position: fixed;
				top: 6rem;
				left: max(1rem, calc((100vw - 1260px) / 2 + 1rem));
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				padding: 1.25rem 0.75rem;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.1);
				z-index: 10;
			}
			:global(html.dark) .sidebar {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.sidebar-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.9rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #8B6914;
				margin: 0 0 0.75rem;
				padding: 0 0.5rem;
			}
			:global(html.dark) .sidebar-title {
				color: #DEB96E;
			}
			.sidebar-btn {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				width: 100%;
				padding: 0.6rem 0.75rem;
				border: none;
				border-radius: 10px;
				background: none;
				cursor: pointer;
				text-align: left;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.95rem;
				color: #3E2703;
				transition: background 0.2s;
			}
			:global(html.dark) .sidebar-btn {
				color: #F5E4C4;
			}
			.sidebar-btn:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			.sidebar-btn.active {
				background: rgba(139, 105, 20, 0.15);
				font-weight: 700;
				color: #5C3D0E;
			}
			:global(html.dark) .sidebar-btn.active {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			:global(html.dark) .sidebar-btn:hover {
				background: rgba(222, 185, 110, 0.1);
			}
			.sidebar-btn .all-icon {
				width: 36px;
				height: 36px;
				border-radius: 8px;
				background: linear-gradient(135deg, #8B6914, #5C3D0E);
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				color: #FDF6EC;
				font-size: 1.1rem;
			}
			.sidebar-btn .collection-info {
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.sidebar-btn .collection-name {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.sidebar-btn .collection-count {
				font-size: 0.75rem;
				color: #8B6914;
			}
			:global(html.dark) .sidebar-btn .collection-count {
				color: #C4A35A;
			}
			.sidebar-divider {
				height: 1px;
				background: #C4A35A;
				opacity: 0.4;
				margin: 0.5rem 0;
			}
			/* Header bar */
			.library-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.library-header h1 {
				font-family: Georgia, 'Times New Roman', serif;
				color: #3E2703;
				margin: 0;
			}
			:global(html.dark) .library-header h1 {
				color: #DEB96E;
			}
			.library-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 0.9rem;
			}
			.btn-secondary {
				padding: 0.4rem 0.8rem;
				border: 1px solid #C4A35A;
				border-radius: 4px;
				background: transparent;
				color: #744908;
				text-decoration: none;
				cursor: pointer;
				font-size: 0.85rem;
				font-family: Georgia, 'Times New Roman', serif;
			}
			.btn-secondary:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			:global(html.dark) .btn-secondary {
				color: #DEB96E;
				border-color: #7a5c2e;
			}
			:global(html.dark) .btn-secondary:hover {
				background: rgba(222, 185, 110, 0.1);
			}
			/* File grid */
			.file-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.file-card {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
				overflow: hidden;
				transition: transform 0.15s, box-shadow 0.15s;
			}
			:global(html.dark) .file-card {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.file-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 20px rgba(62, 39, 3, 0.15);
			}
			.file-link {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 1.25rem;
				color: inherit;
				text-decoration: none;
				height: 100%;
			}
			.file-icon {
				font-size: 2rem;
				flex-shrink: 0;
				line-height: 1;
			}
			.file-info {
				flex: 1;
				min-width: 0;
			}
			.file-name {
				display: block;
				font-family: Georgia, 'Times New Roman', serif;
				font-weight: 700;
				font-size: 1rem;
				color: #3E2703;
				word-break: break-word;
			}
			:global(html.dark) .file-name {
				color: #DEB96E;
			}
			.file-card:hover .file-name {
				color: #8B6914;
			}
			:global(html.dark) .file-card:hover .file-name {
				color: #F5D680;
			}
			.file-badge {
				display: inline-block;
				font-size: 0.7rem;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.12);
				color: #5C3D0E;
				font-family: Georgia, 'Times New Roman', serif;
				text-transform: uppercase;
				margin-top: 0.35rem;
			}
			:global(html.dark) .file-badge {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.file-subfolder {
				display: block;
				font-size: 0.78rem;
				color: #8B6914;
				margin-top: 0.2rem;
			}
			:global(html.dark) .file-subfolder {
				color: #C4A35A;
			}
			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				color: #8B6914;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.1rem;
				font-style: italic;
			}
			:global(html.dark) .empty-state {
				color: #C4A35A;
			}
			/* Responsive */
			@media (max-width: 900px) {
				.library-layout {
					flex-direction: column;
					padding: 1.25rem;
				}
				.sidebar {
					width: 100%;
					max-width: 100%;
					box-sizing: border-box;
					position: static;
					max-height: 40vh;
					overflow-y: auto;
					display: flex;
					gap: 0.5rem;
					overflow-x: auto;
					flex-wrap: wrap;
					border-radius: 12px;
					padding: 0.75rem;
					margin-bottom: 1.5rem;
				}
				.sidebar-title {
					display: none;
				}
				.sidebar-divider {
					display: none;
				}
				.sidebar-btn {
					white-space: nowrap;
					flex-shrink: 1;
					padding: 0.5rem 0.75rem;
					border-radius: 999px;
					border: 1px solid #C4A35A;
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.sidebar-btn .all-icon {
					width: 24px;
					height: 24px;
				}
				.sidebar-btn .collection-count {
					display: none;
				}
				.file-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="library-layout">
			<aside class="sidebar">
				<p class="sidebar-title">Collections</p>
				<button class="sidebar-btn active" data-collection="all">
					<span class="all-icon">
						<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
					</span>
					<span class="collection-info">
						<span class="collection-name">All Files</span>
						<span class="collection-count">{files.length} files</span>
					</span>
				</button>
				<div class="sidebar-divider"></div>
				{collections.map((col) => (
					<button class="sidebar-btn" data-collection={col.name}>
						<span class="all-icon">
							<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
						</span>
						<span class="collection-info">
							<span class="collection-name">{col.name.replace(/-/g, ' ')}</span>
							<span class="collection-count">{col.count} {col.count === 1 ? 'file' : 'files'}</span>
						</span>
					</button>
				))}
			</aside>
			<main>
				<div class="library-header">
					<h1>Library</h1>
					<div class="library-meta">
						<span>Logged in as <strong>{user.username}</strong></span>
						<button id="logout-btn" class="btn-secondary">Log Out</button>
					</div>
				</div>

				{files.length === 0 ? (
					<div class="empty-state">
						<p>No resources available yet.</p>
					</div>
				) : (
					<ul class="file-grid">
						{files.map((f) => (
							<li class="file-card" data-collection={f.collection}>
								<a class="file-link" href={f.url} target="_blank" rel="noopener noreferrer" download>
									<span class="file-icon">{fileIcon(f.ext)}</span>
									<div class="file-info">
										<span class="file-name">{f.name}</span>
										{f.subfolder && <span class="file-subfolder">{f.subfolder}</span>}
										<span class="file-badge">{f.ext}</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</main>
		</div>
		<Footer />

		<script>
			function initLibrary() {
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const allItems = Array.from(document.querySelectorAll<HTMLElement>('.file-card'));

				let currentCollection = 'all';

				function filterItems() {
					allItems.forEach((item) => {
						const col = item.dataset.collection || '';
						const show = currentCollection === 'all' || col === currentCollection;
						item.style.display = show ? '' : 'none';
					});
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						currentCollection = btn.dataset.collection!;
						buttons.forEach((b) => b.classList.toggle('active', b.dataset.collection === currentCollection));
						filterItems();
					});
				});

				filterItems();
			}

			document.getElementById('logout-btn')?.addEventListener('click', async () => {
				await fetch('/api/auth/logout', { method: 'POST' });
				window.location.href = '/tavern/login';
			});

			initLibrary();
			document.addEventListener('astro:after-swap', initLibrary);
		</script>
	</body>
</html>
