			}
			.search-sort-row :global(.search-container) {
				flex: 1;
				min-width: 0;
			}
			.sort-wrapper {
				position: relative;
				flex-shrink: 0;
			}
			.sort-btn {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				height: 42px;
				padding: 0 0.75rem;
				border: 2px solid #C4A35A;
				border-radius: 12px;
				background: #FDF6EC;
				color: #3E2703;
				cursor: pointer;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.85rem;
				box-shadow: 0 2px 8px rgba(62, 39, 3, 0.08);
				transition: background 0.2s, border-color 0.2s;
				white-space: nowrap;
			}
			.sort-btn:hover {
				background: rgba(139, 105, 20, 0.1);
				border-color: #8B6914;
			}
			:global(html.dark) .sort-btn {
				background: #2a1c0a;
				border-color: #7a5c2e;
				color: #F5E4C4;
			}
			:global(html.dark) .sort-btn:hover {
				background: rgba(222, 185, 110, 0.1);
				border-color: #DEB96E;
			}
			.sort-btn svg {
				flex-shrink: 0;
			}
			.sort-menu {
				display: none;
				position: absolute;
				top: calc(100% + 4px);
				right: 0;
				min-width: 100%;
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 12px;
				list-style: none;
				margin: 0;
				padding: 0.4rem 0;
				box-shadow: 0 4px 16px rgba(62, 39, 3, 0.12);
				z-index: 25;
			}
			.sort-menu.open {
				display: block;
			}
			:global(html.dark) .sort-menu {
				background: #2a1c0a;
				border-color: #7a5c2e;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
			}
			.sort-option {
				display: block;
				width: 100%;
				padding: 0.5rem 1rem;
				border: none;
				background: none;
				text-align: left;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 0.85rem;
				color: #3E2703;
				cursor: pointer;
				white-space: nowrap;
			}
			.sort-option:hover {
				background: rgba(139, 105, 20, 0.1);
			}
			.sort-option.active {
				font-weight: 700;
				color: #5C3D0E;
			}
			:global(html.dark) .sort-option {
				color: #F5E4C4;
			}
			:global(html.dark) .sort-option:hover {
				background: rgba(222, 185, 110, 0.1);
			}
			:global(html.dark) .sort-option.active {
				color: #DEB96E;
			}
			.empty-state {
				display: none;
				text-align: center;
				padding: 4rem 2rem;
				color: #8B6914;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.1rem;
				font-style: italic;
			}
			:global(html.dark) .empty-state {
				color: #C4A35A;
			}
			.section-heading {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.35rem;
				color: #3E2703;
				margin: 0 0 1.25rem 0;
			}
			:global(html.dark) .section-heading {
				color: #DEB96E;
			}
			ul.entry-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.75rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li.entry-card.featured {
				grid-column: 1 / -1;
			}
			li.entry-card.featured img {
				height: 360px;
				object-fit: cover;
				width: 100%;
			}
			li.entry-card img {
				height: 220px;
				object-fit: cover;
				width: 100%;
			}
			li.entry-card {
				background: #FDF6EC;
				border: 2px solid #C4A35A;
				border-radius: 16px;
				box-shadow: 0 2px 12px rgba(62, 39, 3, 0.08);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}
			:global(html.dark) li.entry-card {
				background: #2a1c0a;
				border-color: #7a5c2e;
			}
			.card-link {
				color: inherit;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.card-content {
				padding: 2rem;
				flex: 1;
			}
			.wiki-content h2 {
				margin: 0 0 0.75rem 0;
				font-size: 1.55rem;
				font-family: Georgia, 'Times New Roman', serif;
				color: #3E2703;
			}
			:global(html.dark) .wiki-content h2 {
				color: #DEB96E;
			}
			.date {
				margin: 0 0 1rem;
				color: #8B6914;
			}
			:global(html.dark) .date {
				color: #C4A35A;
			}
			.description {
				margin: 0;
				color: #5C3D0E;
				line-height: 1.75;
			}
			:global(html.dark) .description {
				color: #F5E4C4;
			}
			.card-link:hover .description,
			.card-link:hover h2 {
				color: #8B6914;
			}
			:global(html.dark) .card-link:hover h2 {
				color: #F5D680;
			}
			.badge-chain {
				display: flex;
				align-items: center;
				gap: 0.25rem;
				flex-wrap: wrap;
				margin-bottom: 0.5rem;
			}
			.collection-badge {
				display: inline-block;
				font-size: 0.75rem;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: rgba(139, 105, 20, 0.12);
				color: #5C3D0E;
				font-family: Georgia, 'Times New Roman', serif;
			}
			:global(html.dark) .collection-badge {
				background: rgba(222, 185, 110, 0.15);
				color: #DEB96E;
			}
			.badge-sep {
				color: #C4A35A;
				font-size: 0.85rem;
				line-height: 1;
			}
			/* ── Mobile collection toggle button ── */
			.sidebar-mobile-toggle {
				display: none;
			}
			@media (max-width: 900px) {
				.sidebar-mobile-toggle {
					display: flex;
					align-items: center;
					justify-content: space-between;
					width: 100%;
					padding: 0.75rem 1rem;
					border: 2px solid #C4A35A;
					border-radius: 12px;
					background: #FDF6EC;
					color: #3E2703;
					cursor: pointer;
					font-family: Georgia, 'Times New Roman', serif;
					font-size: 1rem;
					font-weight: 600;
					margin-bottom: 0.75rem;
					box-shadow: 0 2px 8px rgba(62, 39, 3, 0.08);
				}
				:global(html.dark) .sidebar-mobile-toggle {
					background: #2a1c0a;
					border-color: #7a5c2e;
					color: #F5E4C4;
				}
				.sidebar-mobile-toggle .toggle-chevron {
					transition: transform 0.3s;
					flex-shrink: 0;
				}
				.sidebar-mobile-toggle.open .toggle-chevron {
					transform: rotate(180deg);
				}
				.wiki-layout {
					flex-direction: column;
					padding: 1.25rem;
				}
				.sidebar {
					width: 100%;
					max-width: 100%;
					box-sizing: border-box;
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					max-height: 100vh;
					max-height: 100dvh;
					height: 100vh;
					height: 100dvh;
					overflow-y: auto;
					display: none;
					flex-direction: column;
					gap: 0.25rem;
					border-radius: 0;
					padding: 1rem 1rem 6rem;
					margin-bottom: 0;
					z-index: 100;
					overscroll-behavior: contain;
				}
				.sidebar.mobile-open {
					display: flex;
				}
				/* Scroll indicator gradient at bottom — only shown when scrollable */
				.sidebar::after {
					content: '⌄ scroll for more';
					position: fixed;
					bottom: 0;
					left: 0;
					right: 0;
					height: 4rem;
					background: linear-gradient(transparent, #FDF6EC 60%);
					display: none;
					align-items: flex-end;
					justify-content: center;
					padding-bottom: 1rem;
					font-family: Georgia, 'Times New Roman', serif;
					font-size: 0.8rem;
					color: #8B6914;
					pointer-events: none;
					z-index: 101;
				}
				.sidebar.can-scroll::after {
					display: flex;
				}
				:global(html.dark) .sidebar.can-scroll::after {
					background: linear-gradient(transparent, #2a1c0a 60%);
					color: #C4A35A;
				}
				.sidebar-title {
					display: block;
					font-size: 1.1rem;
					text-align: center;
					padding-bottom: 0.5rem;
					margin-bottom: 0.5rem;
					border-bottom: 1px solid rgba(196, 163, 90, 0.3);
				}
				.sidebar-divider {
					display: block;
				}
				.sidebar-group {
					flex-direction: column;
				}
				.sidebar-group-header {
					width: 100%;
				}
				.sidebar-toggle {
					display: flex;
				}
				.sidebar-children {
					flex-direction: column;
					padding-left: 0.75rem;
					margin-left: 0.65rem;
					border-left: 1.5px solid rgba(196, 163, 90, 0.3);
					gap: 0;
				}
				.sidebar-btn {
					white-space: normal;
					flex-shrink: 0;
					padding: 0.7rem 0.75rem;
					border-radius: 10px;
					border: none;
					font-size: 1rem;
				}
				.sidebar-children .sidebar-btn {
					font-size: 0.92rem;
					padding: 0.55rem 0.6rem;
					position: static;
				}
				.sidebar-children .sidebar-btn::before {
					display: none;
				}
				.sidebar-btn .collection-img,
				.sidebar-btn .all-icon {
					width: 32px;
					height: 32px;
				}
