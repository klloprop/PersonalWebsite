					display: inline;
					font-size: 0.8rem;
				}
				ul.entry-grid {
					grid-template-columns: 1fr;
				}
				.card-content {
					padding: 1.25rem;
				}
				.wiki-content h2 {
					font-size: 1.25rem;
				}
				.section-heading {
					font-size: 1.1rem;
				}
				li.entry-card.featured img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="wiki-layout">
			<button class="sidebar-mobile-toggle" id="sidebar-mobile-toggle">
				<span class="toggle-label">Browse Collections</span>
				<svg class="toggle-chevron" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
			</button>
			<aside class="sidebar" data-descendants={JSON.stringify(collectionDescendants)}>
				<p class="sidebar-title">Collections</p>
				<button class="sidebar-btn active" data-collection="all">
					<span class="all-icon">
						<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
					</span>
					<span class="collection-info">
						<span class="collection-name">All Entries</span>
						<span class="collection-count">{entries.length} entries</span>
					</span>
				</button>
				<div class="sidebar-divider"></div>
				{roots.map((root) => (
					root.children.length > 0 ? (
						<div class="sidebar-group">
							<div class="sidebar-group-header">
								<button class="sidebar-toggle" aria-label={`Expand ${root.name}`}>
									<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
								</button>
								<button class="sidebar-btn" data-collection={root.name}>
									<Image class="collection-img" src={root.image} alt={root.name} width={36} height={36} />
									<span class="collection-info">
										<span class="collection-name">{root.name}</span>
										<span class="collection-count">{root.totalCount} {root.totalCount === 1 ? 'entry' : 'entries'}</span>
									</span>
								</button>
							</div>
							<div class="sidebar-children">
								{root.children.map((child) => (
									child.children.length > 0 ? (
										<div class="sidebar-group">
											<div class="sidebar-group-header">
												<button class="sidebar-toggle" aria-label={`Expand ${child.name}`}>
													<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
												</button>
												<button class="sidebar-btn" data-collection={child.name}>
													<Image class="collection-img" src={child.image} alt={child.name} width={28} height={28} />
													<span class="collection-info">
														<span class="collection-name">{child.name}</span>
														<span class="collection-count">{child.totalCount} {child.totalCount === 1 ? 'entry' : 'entries'}</span>
													</span>
												</button>
											</div>
											<div class="sidebar-children">
												{child.children.map((grandchild) => (
													<button class="sidebar-btn" data-collection={grandchild.name}>
														<Image class="collection-img" src={grandchild.image} alt={grandchild.name} width={28} height={28} />
														<span class="collection-info">
															<span class="collection-name">{grandchild.name}</span>
															<span class="collection-count">{grandchild.totalCount} {grandchild.totalCount === 1 ? 'entry' : 'entries'}</span>
														</span>
													</button>
												))}
											</div>
										</div>
									) : (
										<button class="sidebar-btn" data-collection={child.name}>
											<Image class="collection-img" src={child.image} alt={child.name} width={28} height={28} />
											<span class="collection-info">
												<span class="collection-name">{child.name}</span>
												<span class="collection-count">{child.totalCount} {child.totalCount === 1 ? 'entry' : 'entries'}</span>
											</span>
										</button>
									)
								))}
							</div>
						</div>
					) : (
						<button class="sidebar-btn" data-collection={root.name}>
							<Image class="collection-img" src={root.image} alt={root.name} width={36} height={36} />
							<span class="collection-info">
								<span class="collection-name">{root.name}</span>
								<span class="collection-count">{root.count} {root.count === 1 ? 'entry' : 'entries'}</span>
							</span>
						</button>
					)
				))}
			</aside>
			<main class="wiki-content">
				<div class="search-sort-row">
					<SearchBar placeholder="Search wiki entries…" items={wikiSearchItems} />
					<div class="sort-wrapper" id="sort-wrapper">
						<button class="sort-btn" id="sort-btn" aria-label="Sort entries" aria-haspopup="true" aria-expanded="false">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="4" y1="6" x2="16" y2="6"/><line x1="4" y1="12" x2="13" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/>
								<polyline points="18 15 21 18 18 21"/><line x1="21" y1="18" x2="21" y2="8"/>
							</svg>
							<span class="sort-label">Newest</span>
						</button>
						<ul class="sort-menu" id="sort-menu">
							<li><button class="sort-option active" data-sort="newest">Newest</button></li>
							<li><button class="sort-option" data-sort="oldest">Oldest</button></li>
							<li><button class="sort-option" data-sort="a-z">A → Z</button></li>
							<li><button class="sort-option" data-sort="z-a">Z → A</button></li>
						</ul>
					</div>
				</div>
				<section>
					<h2 class="section-heading">Most Recent Entry</h2>
					<p class="empty-state">No entries in this collection yet.</p>
					<ul class="entry-grid">
						{entries.map((entry, i) => (
							<li class={`entry-card${i === 0 ? ' featured' : ''}`} data-collection={entry.data.collection || ''} data-title={entry.data.title} data-date={entry.data.pubDate.toISOString()}>
								<a class="card-link" href={`/tavern/wiki/${flatSlug(entry)}/`}>
									{entry.data.heroImage && <Image src={entry.data.heroImage} alt={entry.data.title} width={680} densities={[1]} style={`object-position: ${entry.data.heroImagePosition}`} />}
									<div class="card-content">
								{entry.data.collection && (
									<div class="badge-chain">
										{getAncestors(entry.data.collection).map((name, idx, arr) => (
											<><span class="collection-badge">{name}</span>{idx < arr.length - 1 && <span class="badge-sep">›</span>}</>
										))}
									</div>
								)}
										<h2>{entry.data.title}</h2>
										<p class="date">{entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
										<p class="description">{entry.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			</main>
		</div>
		<Footer />
		<script>
			function initWikiFilter() {
				const sidebar = document.querySelector<HTMLElement>('.sidebar');
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const cards = document.querySelectorAll<HTMLElement>('.entry-card');
				const toggles = document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle');
				const heading = document.querySelector<HTMLElement>('.section-heading');
				const emptyState = document.querySelector<HTMLElement>('.empty-state');
				const grid = document.querySelector<HTMLElement>('.entry-grid');
				const sortBtn = document.getElementById('sort-btn');
				const sortLabel = sortBtn?.querySelector('.sort-label');
				const sortMenu = document.getElementById('sort-menu');
				const sortOptions = document.querySelectorAll<HTMLButtonElement>('.sort-option');
				const mobileToggle = document.getElementById('sidebar-mobile-toggle') as HTMLButtonElement | null;
				const toggleLabel = mobileToggle?.querySelector('.toggle-label');

				// Mobile sidebar toggle
				function isMobile() {
					return window.matchMedia('(max-width: 900px)').matches;
				}

				function closeMobileSidebar() {
					sidebar?.classList.remove('mobile-open');
					mobileToggle?.classList.remove('open');
					document.body.style.overflow = '';
				}

				function openMobileSidebar() {
					sidebar?.classList.add('mobile-open');
					mobileToggle?.classList.add('open');
					document.body.style.overflow = 'hidden';
					// Check if sidebar content is scrollable
					requestAnimationFrame(() => {
						if (sidebar && sidebar.scrollHeight > sidebar.clientHeight) {
							sidebar.classList.add('can-scroll');
						} else {
							sidebar?.classList.remove('can-scroll');
						}
					});
				}

				mobileToggle?.addEventListener('click', () => {
					if (sidebar?.classList.contains('mobile-open')) {
						closeMobileSidebar();
					} else {
						openMobileSidebar();
					}
				});

				// Sort modes
				type SortMode = 'newest' | 'oldest' | 'a-z' | 'z-a';
				let currentSort: SortMode = 'newest';

				function sortCards() {
					if (!grid) return;
					const cardArray = Array.from(grid.querySelectorAll<HTMLElement>('.entry-card'));
					cardArray.sort((a, b) => {
						switch (currentSort) {
							case 'newest':
								return new Date(b.dataset.date || '').getTime() - new Date(a.dataset.date || '').getTime();
							case 'oldest':
								return new Date(a.dataset.date || '').getTime() - new Date(b.dataset.date || '').getTime();
							case 'a-z':
								return (a.dataset.title || '').localeCompare(b.dataset.title || '', undefined, { numeric: true });
							case 'z-a':
								return (b.dataset.title || '').localeCompare(a.dataset.title || '', undefined, { numeric: true });
						}
					});
					for (const card of cardArray) grid.appendChild(card);
					let first = true;
					cardArray.forEach((card) => {
						card.classList.remove('featured');
						if (card.style.display !== 'none' && first) {
							card.classList.add('featured');
							first = false;
						}
					});
				}

				sortBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					const open = sortMenu?.classList.toggle('open');
					sortBtn.setAttribute('aria-expanded', String(!!open));
				});

				sortOptions.forEach((opt) => {
					opt.addEventListener('click', () => {
						currentSort = opt.dataset.sort as SortMode;
						if (sortLabel) sortLabel.textContent = opt.textContent || '';
						sortOptions.forEach((o) => o.classList.toggle('active', o === opt));
						sortMenu?.classList.remove('open');
						sortBtn?.setAttribute('aria-expanded', 'false');
						sortCards();
					});
				});

				document.addEventListener('click', (e) => {
					const wrapper = document.getElementById('sort-wrapper');
					if (wrapper && !wrapper.contains(e.target as Node)) {
						sortMenu?.classList.remove('open');
						sortBtn?.setAttribute('aria-expanded', 'false');
					}
				});

				// Parse the descendants map from the sidebar data attribute
				const descendants: Record<string, string[]> = JSON.parse(
					sidebar?.dataset.descendants || '{}'
				);

				// Expand/collapse toggles
				toggles.forEach((toggle) => {
					toggle.addEventListener('click', (e) => {
						e.stopPropagation();
						const group = toggle.closest('.sidebar-group');
						if (!group) return;
						const children = group.querySelector('.sidebar-children');
						if (!children) return;
						const isOpen = children.classList.toggle('open');
						toggle.classList.toggle('expanded', isOpen);
						toggle.setAttribute('aria-label',
							isOpen ? `Collapse ${toggle.nextElementSibling?.textContent?.trim()}` : `Expand ${toggle.nextElementSibling?.textContent?.trim()}`
						);
					});
				});

				// Start with all collections expanded
				document.querySelectorAll('.sidebar-children').forEach(c => c.classList.add('open'));
				document.querySelectorAll('.sidebar-toggle').forEach(t => t.classList.add('expanded'));

				function filterTo(selected: string) {
					// Determine which collection names match
					let matchNames: Set<string>;
					if (selected === 'all') {
						matchNames = new Set(); // show everything
					} else {
						matchNames = new Set(descendants[selected] || [selected]);
					}

					buttons.forEach((b) => {
						b.classList.toggle('active', b.dataset.collection === selected);
					});

					// Filter cards — just toggle display + featured class, no DOM movement
					let visibleCount = 0;
					cards.forEach((card) => {
						const cardCol = card.dataset.collection || '';
						const visible = selected === 'all' || matchNames.has(cardCol);
						card.style.display = visible ? '' : 'none';
						card.classList.remove('featured');
						if (visible) {
							visibleCount++;
							if (visibleCount === 1) {
								card.classList.add('featured');
							}
						}
					});

					// Update heading text
					if (heading) {
						heading.style.display = visibleCount > 0 ? '' : 'none';
						heading.textContent = selected === 'all' ? 'Most Recent Entry' : selected;
					}
					// Show/hide empty state and grid
					if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
					if (grid) grid.style.display = visibleCount > 0 ? '' : 'none';
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						filterTo(btn.dataset.collection!);
						// Update the mobile toggle label
						if (toggleLabel) {
							toggleLabel.textContent = btn.dataset.collection === 'all'
								? 'Browse Collections'
								: btn.dataset.collection!;
						}
						// Auto-expand parent group when clicking its button
						const group = btn.closest('.sidebar-group');
						if (group) {
							const children = group.querySelector('.sidebar-children');
							const toggle = group.querySelector('.sidebar-toggle');
							if (children && !children.classList.contains('open')) {
								children.classList.add('open');
								toggle?.classList.add('expanded');
							}
						}
						// Collapse sidebar on mobile after selection
						if (isMobile()) {
							closeMobileSidebar();
						}
					});
				});

				const params = new URLSearchParams(window.location.search);
				const col = params.get('collection');
				if (col) {
					filterTo(col);
					// Auto-expand the group containing this collection
					buttons.forEach((btn) => {
						if (btn.dataset.collection === col) {
							const group = btn.closest('.sidebar-group');
							if (group) {
								const children = group.querySelector('.sidebar-children');
								const toggle = group.querySelector('.sidebar-toggle');
								children?.classList.add('open');
								toggle?.classList.add('expanded');
							}
						}
					});
				}
			}
			initWikiFilter();
			document.addEventListener('astro:after-swap', initWikiFilter);
		</script>
	</body>
</html>