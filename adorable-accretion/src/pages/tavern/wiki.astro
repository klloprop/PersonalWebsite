				}
				.sidebar-mobile-toggle.open .toggle-chevron {
					transform: rotate(180deg);
				}
				.wiki-layout {
					flex-direction: column;
					padding: 1.25rem;
				}
				.sidebar {
					width: auto;
					box-sizing: border-box;
					position: fixed;
					top: 8rem;
					left: 5%;
					right: 5%;
					bottom: 0;
					max-height: calc(100vh - 8rem);
					max-height: calc(100dvh - 8rem);
					height: calc(100vh - 8rem);
					height: calc(100dvh - 8rem);
					overflow-y: auto;
					overflow-x: hidden;
					display: none;
					flex-direction: column;
					gap: 0.25rem;
					border-radius: 0 0 16px 16px;
					padding: 1rem 1rem 6rem;
					margin-bottom: 0;
					z-index: 100;
					overscroll-behavior: contain;
				}
				@media (max-width: 720px) {
					.sidebar {
						top: 5.5rem;
						max-height: calc(100vh - 5.5rem);
						max-height: calc(100dvh - 5.5rem);
						height: calc(100vh - 5.5rem);
						height: calc(100dvh - 5.5rem);
						left: 0;
						right: 0;
						border-radius: 0;
					}
				}
				@media (max-width: 500px) {
					.sidebar {
						top: 5rem;
						max-height: calc(100vh - 5rem);
						max-height: calc(100dvh - 5rem);
						height: calc(100vh - 5rem);
						height: calc(100dvh - 5rem);
						left: 0;
						right: 0;
						border-radius: 0;
					}
				}
				.sidebar.mobile-open {
					display: flex;
				}
				/* Scroll indicator gradient at bottom — only shown when scrollable */
				.sidebar::after {
					content: '\2304  scroll for more  \2304';
					position: fixed;
					bottom: 0;
					left: 5%;
					right: 5%;
					height: 4rem;
					background: linear-gradient(transparent, #FDF6EC 60%);
					display: none;
					align-items: flex-end;
					justify-content: center;
					padding-bottom: 1rem;
					font-family: Georgia, 'Times New Roman', serif;
					font-size: 0.8rem;
					color: #8B6914;
					pointer-events: none;
					z-index: 101;
					opacity: 1;
					transition: opacity 0.2s ease;
				}
				.sidebar.can-scroll::after {
					display: flex;
				}
				.sidebar.scrolled-bottom::after {
					opacity: 0;
				}
				:global(html.dark) .sidebar.can-scroll::after {
					background: linear-gradient(transparent, #2a1c0a 60%);
					color: #C4A35A;
				}
				.sidebar-title {
					display: block;
					font-size: 1.1rem;
					text-align: center;
					padding-bottom: 0.5rem;
					margin-bottom: 0.5rem;
					border-bottom: 1px solid rgba(196, 163, 90, 0.3);
				}
				.sidebar-divider {
					display: block;
				}
				.sidebar-group {
					flex-direction: column;
				}
				.sidebar-group-header {
					width: 100%;
				}
				.sidebar-toggle-slot {
					display: inline-flex;
				}
				.sidebar-toggle {
					display: flex;
				}
				.sidebar-children {
					flex-direction: column;
					padding-left: 0.75rem;
					margin-left: 0.65rem;
					border-left: 1.5px solid rgba(196, 163, 90, 0.3);
					gap: 0;
				}
				.sidebar-btn {
					white-space: normal;
					flex-shrink: 0;
					padding: 0.7rem 0.75rem;
					border-radius: 10px;
					border: none;
					font-size: 1rem;
				}
				.sidebar-children .sidebar-btn {
					font-size: 0.92rem;
					padding: 0.55rem 0.6rem;
					position: static;
				}
				.sidebar-children .sidebar-btn::before {
					display: none;
				}
				.sidebar-btn .collection-img-wrap,
				.sidebar-btn .all-icon {
					--size: var(--wiki-icon-mobile-size);
					width: var(--size);
					height: var(--size);
				}
				.sidebar-children .sidebar-btn .collection-img-wrap {
					--size: calc(var(--wiki-icon-mobile-size) * var(--wiki-icon-mobile-nested-ratio));
					width: var(--size);
					height: var(--size);
				}
				.sidebar-btn .collection-count {
					display: inline;
					font-size: 0.8rem;
				}
				ul.entry-grid {
					grid-template-columns: 1fr;
				}
				.card-content {
					padding: 1.25rem;
				}
				.wiki-content h2 {
					font-size: 1.25rem;
				}
				.section-heading {
					font-size: 1.1rem;
				}
				li.entry-card.featured img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="wiki-layout">
			<button class="sidebar-mobile-toggle" id="sidebar-mobile-toggle">
				<span class="toggle-label">Browse Collections</span>
				<svg class="toggle-chevron" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
			</button>
			<aside class="sidebar" data-descendants={JSON.stringify(collectionDescendants)}>
				<p class="sidebar-title">Collections</p>
				<div class="sidebar-group-header">
					<span class="sidebar-toggle-slot" aria-hidden="true"></span>
					<button class="sidebar-btn active" data-collection="all">
						<span class="all-icon">
							<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
						</span>
						<span class="collection-info">
							<span class="collection-name">All Entries</span>
							<span class="collection-count">{entries.length} entries</span>
						</span>
					</button>
				</div>
				<div class="sidebar-divider"></div>
				{roots.map((root) => (
					root.children.length > 0 ? (
						<div class="sidebar-group">
							<div class="sidebar-group-header">
								<button class="sidebar-toggle" aria-label={`Expand ${root.name}`}>
									<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
								</button>
								<button class="sidebar-btn" data-collection={root.id} data-collection-label={root.name} style={`--icon-bg: ${colIconBg[root.id]}; --icon-scale: ${root.imageScale}`}>
									<span class="collection-img-wrap"><Image class="collection-img" src={root.image} alt={root.name} width={72} height={72} fit="contain" /></span>
									<span class="collection-info">
										<span class="collection-name">{root.name}</span>
										<span class="collection-count">{root.totalCount} {root.totalCount === 1 ? 'entry' : 'entries'}</span>
									</span>
								</button>
							</div>
							<div class="sidebar-children">
								{root.children.map((child) => (
									child.children.length > 0 ? (
										<div class="sidebar-group">
											<div class="sidebar-group-header">
												<button class="sidebar-toggle" aria-label={`Expand ${child.name}`}>
													<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
												</button>
												<button class="sidebar-btn" data-collection={child.id} data-collection-label={child.name} style={`--icon-bg: ${colIconBg[child.id]}; --icon-scale: ${child.imageScale}`}>
													<span class="collection-img-wrap"><Image class="collection-img" src={child.image} alt={child.name} width={56} height={56} fit="contain" /></span>
													<span class="collection-info">
														<span class="collection-name">{child.name}</span>
														<span class="collection-count">{child.totalCount} {child.totalCount === 1 ? 'entry' : 'entries'}</span>
													</span>
												</button>
											</div>
											<div class="sidebar-children">
												{child.children.map((grandchild) => (
													<div class="sidebar-group-header">
														<span class="sidebar-toggle-slot" aria-hidden="true"></span>
														<button class="sidebar-btn" data-collection={grandchild.id} data-collection-label={grandchild.name} style={`--icon-bg: ${colIconBg[grandchild.id]}; --icon-scale: ${grandchild.imageScale}`}>
															<span class="collection-img-wrap"><Image class="collection-img" src={grandchild.image} alt={grandchild.name} width={56} height={56} fit="contain" /></span>
															<span class="collection-info">
																<span class="collection-name">{grandchild.name}</span>
																<span class="collection-count">{grandchild.totalCount} {grandchild.totalCount === 1 ? 'entry' : 'entries'}</span>
															</span>
														</button>
													</div>
												))}
											</div>
										</div>
									) : (
										<div class="sidebar-group-header">
											<span class="sidebar-toggle-slot" aria-hidden="true"></span>
											<button class="sidebar-btn" data-collection={child.id} data-collection-label={child.name} style={`--icon-bg: ${colIconBg[child.id]}; --icon-scale: ${child.imageScale}`}>
												<span class="collection-img-wrap"><Image class="collection-img" src={child.image} alt={child.name} width={56} height={56} fit="contain" /></span>
												<span class="collection-info">
													<span class="collection-name">{child.name}</span>
													<span class="collection-count">{child.totalCount} {child.totalCount === 1 ? 'entry' : 'entries'}</span>
												</span>
											</button>
										</div>
									)
								))}
							</div>
						</div>
					) : (
						<div class="sidebar-group-header">
							<span class="sidebar-toggle-slot" aria-hidden="true"></span>
							<button class="sidebar-btn" data-collection={root.id} data-collection-label={root.name} style={`--icon-bg: ${colIconBg[root.id]}; --icon-scale: ${root.imageScale}`}>
								<span class="collection-img-wrap"><Image class="collection-img" src={root.image} alt={root.name} width={72} height={72} fit="contain" /></span>
								<span class="collection-info">
									<span class="collection-name">{root.name}</span>
									<span class="collection-count">{root.count} {root.count === 1 ? 'entry' : 'entries'}</span>
								</span>
							</button>
						</div>
					)
				))}
			</aside>
			<main class="wiki-content">
				<div class="search-sort-row">
					<SearchBar placeholder="Search wiki entries…" items={wikiSearchItems} />
					<div class="sort-wrapper" id="sort-wrapper">
						<button class="sort-btn" id="sort-btn" aria-label="Sort entries" aria-haspopup="true" aria-expanded="false">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="4" y1="6" x2="16" y2="6"/><line x1="4" y1="12" x2="13" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/>
								<polyline points="18 15 21 18 18 21"/><line x1="21" y1="18" x2="21" y2="8"/>
							</svg>
							<span class="sort-label">Newest</span>
						</button>
						<ul class="sort-menu" id="sort-menu">
							<li><button class="sort-option active" data-sort="newest">Newest</button></li>
							<li><button class="sort-option" data-sort="oldest">Oldest</button></li>
							<li><button class="sort-option" data-sort="a-z">A ? Z</button></li>
							<li><button class="sort-option" data-sort="z-a">Z ? A</button></li>
						</ul>
					</div>
				</div>
				<section>
					<h2 class="section-heading">Most Recent Entry</h2>
					<p class="empty-state">No entries in this collection yet.</p>
					<p class="access-notice" id="collection-access-notice" hidden></p>
					<ul class="entry-grid">
						{entries.map((entry, i) => (
							<li class={`entry-card${i === 0 ? ' featured' : ''}`} data-collection={entryCollectionIdByEntryId.get(entry.id) || ''} data-title={entry.data.title} data-date={entry.data.pubDate.toISOString()}>
								<a class="card-link" href={`/tavern/wiki/${flatSlug(entry)}/`}>
									{entry.data.heroImage && <Image src={entry.data.heroImage} alt={entry.data.title} width={680} densities={[1]} style={`object-position: ${entry.data.heroImagePosition}`} />}
									<div class="card-content">
								{entryCollectionIdByEntryId.get(entry.id) && (
									<div class="badge-chain">
										{getAncestorsById(entryCollectionIdByEntryId.get(entry.id)!).map((name, idx, arr) => (
											<><span class="collection-badge">{name}</span>{idx < arr.length - 1 && <span class="badge-sep">›</span>}</>
										))}
									</div>
								)}
										<h2>{entry.data.title}</h2>
										<p class="date">{entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
										<p class="description">{entry.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			</main>
		</div>
		<Footer />
		<script>
			// Keep sidebar above the footer by updating --sidebar-max-h on scroll/resize
			const _sidebar = document.querySelector<HTMLElement>('.sidebar');
			const _footer = document.querySelector<HTMLElement>('footer');
			function clampSidebar() {
				if (!_sidebar || !_footer) return;
				const footerTop = _footer.getBoundingClientRect().top;
				const sidebarTop = _sidebar.getBoundingClientRect().top;
				const gap = 85;
				const available = footerTop - sidebarTop - gap;
				_sidebar.style.setProperty('--sidebar-max-h', `${Math.max(available, 100)}px`);
			}
			clampSidebar();
			window.addEventListener('scroll', clampSidebar, { passive: true });
			window.addEventListener('resize', clampSidebar, { passive: true });
			if (_footer) new ResizeObserver(clampSidebar).observe(_footer);

			function initWikiFilter() {
				const sidebar = document.querySelector<HTMLElement>('.sidebar');
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const cards = document.querySelectorAll<HTMLElement>('.entry-card');
				const toggles = document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle');
				const heading = document.querySelector<HTMLElement>('.section-heading');
				const emptyState = document.querySelector<HTMLElement>('.empty-state');
				const accessNotice = document.getElementById('collection-access-notice') as HTMLElement | null;
				const grid = document.querySelector<HTMLElement>('.entry-grid');
				const sortBtn = document.getElementById('sort-btn');
				const sortLabel = sortBtn?.querySelector('.sort-label');
				const sortMenu = document.getElementById('sort-menu');
				const sortOptions = document.querySelectorAll<HTMLButtonElement>('.sort-option');
				const mobileToggle = document.getElementById('sidebar-mobile-toggle') as HTMLButtonElement | null;
				const toggleLabel = mobileToggle?.querySelector('.toggle-label');

				// Mobile sidebar toggle
				function isMobile() {
					return window.matchMedia('(max-width: 900px)').matches;
				}

				function closeMobileSidebar() {
					sidebar?.classList.remove('mobile-open');
					mobileToggle?.classList.remove('open');
					document.body.style.overflow = '';
				}

				function openMobileSidebar() {
					sidebar?.classList.add('mobile-open');
					sidebar?.classList.remove('scrolled-bottom');
					mobileToggle?.classList.add('open');
					document.body.style.overflow = 'hidden';
					// Check if sidebar content is scrollable
					requestAnimationFrame(() => {
						if (sidebar && sidebar.scrollHeight > sidebar.clientHeight) {
							sidebar.classList.add('can-scroll');
						} else {
							sidebar?.classList.remove('can-scroll');
						}
					});
				}

				// Fade out scroll hint when user reaches the bottom
				sidebar?.addEventListener('scroll', () => {
					if (!sidebar) return;
					const atBottom = sidebar.scrollTop + sidebar.clientHeight >= sidebar.scrollHeight - 20;
					sidebar.classList.toggle('scrolled-bottom', atBottom);
				});

				mobileToggle?.addEventListener('click', () => {
					if (sidebar?.classList.contains('mobile-open')) {
						closeMobileSidebar();
					} else {
						openMobileSidebar();
					}
				});

				// Sort modes
				type SortMode = 'newest' | 'oldest' | 'a-z' | 'z-a';
				const SORT_KEY = 'wiki-sort';
				const saved = sessionStorage.getItem(SORT_KEY) as SortMode | null;
				let currentSort: SortMode = (saved && ['newest','oldest','a-z','z-a'].includes(saved)) ? saved : 'newest';

				// Apply saved sort to UI on load
				sortOptions.forEach((o) => {
					const isActive = o.dataset.sort === currentSort;
					o.classList.toggle('active', isActive);
					if (isActive && sortLabel) sortLabel.textContent = o.textContent || '';
				});
				sortCards();

				function sortCards() {
					if (!grid) return;
					const cardArray = Array.from(grid.querySelectorAll<HTMLElement>('.entry-card'));
					cardArray.sort((a, b) => {
						switch (currentSort) {
							case 'newest':
								return new Date(b.dataset.date || '').getTime() - new Date(a.dataset.date || '').getTime();
							case 'oldest':
								return new Date(a.dataset.date || '').getTime() - new Date(b.dataset.date || '').getTime();
							case 'a-z':
								return (a.dataset.title || '').localeCompare(b.dataset.title || '', undefined, { numeric: true });
							case 'z-a':
								return (b.dataset.title || '').localeCompare(a.dataset.title || '', undefined, { numeric: true });
						}
					});
					for (const card of cardArray) grid.appendChild(card);
					let first = true;
					cardArray.forEach((card) => {
						card.classList.remove('featured');
						if (card.style.display !== 'none' && first) {
							card.classList.add('featured');
							first = false;
						}
					});
				}

				sortBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					const open = sortMenu?.classList.toggle('open');
					sortBtn.setAttribute('aria-expanded', String(!!open));
				});

				sortOptions.forEach((opt) => {
					opt.addEventListener('click', () => {
						currentSort = opt.dataset.sort as SortMode;
						sessionStorage.setItem(SORT_KEY, currentSort);
						if (sortLabel) sortLabel.textContent = opt.textContent || '';
						sortOptions.forEach((o) => o.classList.toggle('active', o === opt));
						sortMenu?.classList.remove('open');
						sortBtn?.setAttribute('aria-expanded', 'false');
						sortCards();
					});
				});

				document.addEventListener('click', (e) => {
					const wrapper = document.getElementById('sort-wrapper');
					if (wrapper && !wrapper.contains(e.target as Node)) {
						sortMenu?.classList.remove('open');
						sortBtn?.setAttribute('aria-expanded', 'false');
					}
				});

				// Parse the descendants map from the sidebar data attribute
				const descendants: Record<string, string[]> = JSON.parse(
					sidebar?.dataset.descendants || '{}'
				);

				// Expand/collapse toggles
				toggles.forEach((toggle) => {
					toggle.addEventListener('click', (e) => {
						e.stopPropagation();
						const group = toggle.closest('.sidebar-group');
						if (!group) return;
						const children = group.querySelector('.sidebar-children');
						if (!children) return;
						const isOpen = children.classList.toggle('open');
						toggle.classList.toggle('expanded', isOpen);
						toggle.setAttribute('aria-label',
							isOpen ? `Collapse ${toggle.nextElementSibling?.textContent?.trim()}` : `Expand ${toggle.nextElementSibling?.textContent?.trim()}`
						);
					});
				});

				function filterTo(selected: string) {
					// Determine which collection names match
					let matchNames: Set<string>;
					if (selected === 'all') {
						matchNames = new Set(); // show everything
					} else {
						matchNames = new Set(descendants[selected] || [selected]);
					}

					buttons.forEach((b) => {
						b.classList.toggle('active', b.dataset.collection === selected);
					});

					// Filter cards — just toggle display + featured class, no DOM movement
					// Use live DOM query so order reflects any active sort
					const sortedCards = Array.from(grid?.querySelectorAll<HTMLElement>('.entry-card') || []);
					let visibleCount = 0;
					sortedCards.forEach((card) => {
						const cardCol = card.dataset.collection || '';
						const visible = selected === 'all' || matchNames.has(cardCol);
						card.style.display = visible ? '' : 'none';
						card.classList.remove('featured');
						if (visible) {
							visibleCount++;
							if (visibleCount === 1) {
								card.classList.add('featured');
							}
						}
					});

					// Update heading text
					if (heading) {
						heading.style.display = visibleCount > 0 ? '' : 'none';
						if (selected === 'all') {
							heading.textContent = 'Most Recent Entry';
						} else {
							const activeBtn = Array.from(buttons).find((b) => b.dataset.collection === selected);
							heading.textContent = activeBtn?.dataset.collectionLabel || selected;
						}
					}
					// Show/hide empty state and grid
					if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
					if (grid) grid.style.display = visibleCount > 0 ? '' : 'none';
					if (accessNotice) accessNotice.hidden = true;
					// Recalculate sidebar height — content height changed
					requestAnimationFrame(clampSidebar);
				}

				function hasCollectionButton(name: string): boolean {
					return Array.from(buttons).some((btn) => btn.dataset.collection === name);
				}

				function resolveCollectionSelection(value: string): string | null {
					if (value === 'all') return 'all';
					const direct = Array.from(buttons).find((btn) => btn.dataset.collection === value);
					if (direct?.dataset.collection) return direct.dataset.collection;

					const byLabel = Array.from(buttons).filter((btn) =>
						(btn.dataset.collectionLabel || '').toLowerCase() === value.toLowerCase(),
					);
					if (byLabel.length === 1) return byLabel[0].dataset.collection || null;
					return null;
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const col = btn.dataset.collection!;
						sessionStorage.setItem('wiki-collection', col);
						filterTo(col);
						// Update the mobile toggle label
						if (toggleLabel) {
							toggleLabel.textContent = btn.dataset.collection === 'all'
								? 'Browse Collections'
								: (btn.dataset.collectionLabel || btn.dataset.collection!);
						}
						// Auto-expand parent group when clicking its button
						const group = btn.closest('.sidebar-group');
						if (group) {
							const children = group.querySelector('.sidebar-children');
							const toggle = group.querySelector('.sidebar-toggle');
							if (children && !children.classList.contains('open')) {
								children.classList.add('open');
								toggle?.classList.add('expanded');
							}
						}
						// Collapse sidebar on mobile after selection
						if (isMobile()) {
							closeMobileSidebar();
						}
					});
				});

				const params = new URLSearchParams(window.location.search);
				const urlCol = params.get('collection');
				const rawSelection = urlCol || sessionStorage.getItem('wiki-collection');
				const requestedByUrl = !!urlCol;
				if (urlCol) sessionStorage.setItem('wiki-collection', urlCol);
				const col = rawSelection ? resolveCollectionSelection(rawSelection) : null;
				if (col) {
					const selectable = col === 'all' || hasCollectionButton(col);
					if (!selectable) {
						filterTo('all');
						sessionStorage.removeItem('wiki-collection');
						if (toggleLabel) toggleLabel.textContent = 'Browse Collections';
						if (requestedByUrl && accessNotice) {
							accessNotice.textContent = 'The requested collection is not available for your account or does not exist.';
							accessNotice.hidden = false;
							if (emptyState) emptyState.style.display = 'none';
							if (heading) heading.textContent = 'Most Recent Entry';
						}
						return;
					}

					filterTo(col);
					if (toggleLabel) {
						const activeBtn = Array.from(buttons).find((btn) => btn.dataset.collection === col);
						toggleLabel.textContent = col === 'all' ? 'Browse Collections' : (activeBtn?.dataset.collectionLabel || col);
					}
					// Auto-expand the group containing this collection
					buttons.forEach((btn) => {
						if (btn.dataset.collection === col) {
							const group = btn.closest('.sidebar-group');
							if (group) {
								const children = group.querySelector('.sidebar-children');
								const toggle = group.querySelector('.sidebar-toggle');
								children?.classList.add('open');
								toggle?.classList.add('expanded');
							}
						}
					});
				}
			}
			initWikiFilter();
			document.addEventListener('astro:after-swap', initWikiFilter);
		</script>
	</body>
</html>
