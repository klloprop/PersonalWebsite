---
export const prerender = false;

/**
 * tavern/wiki.astro — Wiki entry listing page.
 *
 * Features:
 *  - Hierarchical collection sidebar with tree-structured expand/collapse.
 *  - Card grid with featured first entry.
 *  - Collection breadcrumb chains showing ancestor paths.
 *  - Client-side filtering via ?collection= query param.
 *  - Responsive: sidebar becomes scrollable pills on mobile.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import D20Icon from '../../assets/D20_Icon.png';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SearchBar from '../../components/SearchBar.astro';
import type { SearchItem } from '../../components/SearchBar.astro';
import { SITE_TITLE } from '../../consts';
import {
	canRoleViewCollection,
	computeEffectiveCollectionVisibility,
	getWikiCollectionVisibilityOverrides,
	listWikiCollectionInfos,
	resolveCollectionId,
	type ViewerRole,
} from '../../lib/wiki-collection-visibility';
import {
	canRoleViewWikiEntry,
	computeEffectiveWikiEntryVisibility,
	getWikiEntryVisibilityOverrides,
	type WikiEntryInfo,
} from '../../lib/wiki-entry-visibility';

const viewerRole: ViewerRole = Astro.locals.user?.role === 'admin' ? 'admin' : 'user';
const allEntries = await getCollection('wiki');
const collectionInfos = await listWikiCollectionInfos();
const visibilityOverrides = await getWikiCollectionVisibilityOverrides();
const effectiveVisibility = computeEffectiveCollectionVisibility(collectionInfos, visibilityOverrides);
const entryOverrides = await getWikiEntryVisibilityOverrides();
function sanitizeEntryVisibility(value: unknown): 'user' | 'admin' {
	return value === 'admin' ? 'admin' : 'user';
}
const entryInfos: WikiEntryInfo[] = allEntries.map((entry) => ({
	id: entry.id,
	title: entry.data.title,
	collectionRef: (entry.data.collectionId as string | undefined) ?? entry.data.collection,
	defaultVisibility: sanitizeEntryVisibility((entry.data as Record<string, unknown>).visibility),
}));
const effectiveEntryVisibility = computeEffectiveWikiEntryVisibility(
	entryInfos,
	entryOverrides,
	effectiveVisibility,
	collectionInfos,
);

function entryCollectionRef(entry: any): string | undefined {
	return (entry.data.collectionId as string | undefined) ?? (entry.data.collection as string | undefined);
}

const entryCollectionIdByEntryId = new Map<string, string | undefined>();
for (const entry of allEntries) {
	entryCollectionIdByEntryId.set(entry.id, resolveCollectionId(entryCollectionRef(entry), collectionInfos));
}

const entries = allEntries
	.filter((entry) => canRoleViewCollection(entryCollectionRef(entry), viewerRole, effectiveVisibility, collectionInfos))
	.filter((entry) => canRoleViewWikiEntry(entry.id, viewerRole, effectiveEntryVisibility))
	.sort(
	(a, b) => {
		const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
		if (dateDiff !== 0) return dateDiff;
		return b.data.title.localeCompare(a.data.title, undefined, { numeric: true });
	},
);
const defaultHeroImage = D20Icon;
const getHeroImage = (heroImage: any) =>
	typeof heroImage === 'string' || !heroImage ? defaultHeroImage : heroImage;

function flatSlug(entry: any) {
	return (entry.slug ?? entry.id).split('/').pop();
}

const collectionEntries = (await getCollection('wikiCollections'))
	.filter((col) => canRoleViewCollection(col.id, viewerRole, effectiveVisibility, collectionInfos))
	.sort(
	(a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

// Build tree structure
interface ColNode {
	id: string;
	name: string;
	image: ImageMetadata;
	imageScale: number;
	description?: string;
	parentId?: string;
	count: number;          // direct entries
	totalCount: number;     // entries in this + all descendants
	children: ColNode[];
}

function getDescendantIds(node: ColNode): string[] {
	const ids = [node.id];
	for (const child of node.children) {
		ids.push(...getDescendantIds(child));
	}
	return ids;
}

const colMap = new Map<string, ColNode>();
for (const col of collectionEntries) {
	colMap.set(col.id, {
		id: col.id,
		name: col.data.name,
		image: col.data.image,
		imageScale: col.data.imageScale ?? 1,
		description: col.data.description,
		parentId: (collectionInfos.find((info) => info.id === col.id)?.parentId),
		count: entries.filter((e) => entryCollectionIdByEntryId.get(e.id) === col.id).length,
		totalCount: 0,
		children: [],
	});
}

// Wire parent-child
const roots: ColNode[] = [];
for (const node of colMap.values()) {
	if (node.parentId && colMap.has(node.parentId)) {
		colMap.get(node.parentId)!.children.push(node);
	} else {
		roots.push(node);
	}
}

// Calculate totalCount (includes all descendants)
function calcTotal(node: ColNode): number {
	node.totalCount = node.count;
	for (const child of node.children) {
		node.totalCount += calcTotal(child);
	}
	return node.totalCount;
}
roots.forEach(calcTotal);

function flatOrder(nodes: ColNode[]): string[] {
	const result: string[] = [];
	for (const node of nodes) {
		result.push(node.id);
		if (node.children.length) result.push(...flatOrder(node.children));
	}
	return result;
}
const colIconBg: Record<string, string> = {};
flatOrder(roots).forEach((id) => {
	colIconBg[id] = 'rgba(196, 163, 90, 0.8)';
});

// Build a map: collection id -> all descendant ids
const collectionDescendants: Record<string, string[]> = {};
for (const node of colMap.values()) {
	collectionDescendants[node.id] = getDescendantIds(node);
}

// Build search items for the search bar
const wikiSearchItems: SearchItem[] = entries.map((entry) => ({
	name: entry.data.title,
	tags: entry.data.tags || [],
	url: `/tavern/wiki/${flatSlug(entry)}/`,
	extra: entry.data.collection || (entryCollectionIdByEntryId.get(entry.id) ?? ''),
}));

// Build ancestor chain by collection id -> [topmost, ..., parent, self] names
function getAncestorsById(collectionId: string): string[] {
	const chain: string[] = [];
	let current: string | undefined = collectionId;
	while (current) {
		const node = colMap.get(current);
		if (!node) break;
		chain.unshift(node.name);
		if (node.parentId && colMap.has(node.parentId)) {
			current = node.parentId;
		} else {
			break;
		}
	}
	return chain;
}
