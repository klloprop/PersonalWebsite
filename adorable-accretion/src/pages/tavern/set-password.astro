---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getSetupToken } from '../../lib/auth';

const token = Astro.url.searchParams.get('token');
let tokenValid = false;
let tokenType: 'setup' | 'reset' | null = null;

if (token) {
	const data = await getSetupToken(token);
	if (data) {
		tokenValid = true;
		tokenType = data.type;
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} - ${tokenType === 'reset' ? 'Reset Password' : 'Set Password'}`}
			description="Set your account password"
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="auth-card">
				{!tokenValid ? (
					<div class="auth-message">
						<h1>Invalid Link</h1>
						<p>This link is invalid or has expired. Please contact the admin for a new link.</p>
						<a href="/tavern/login">Go to Login</a>
					</div>
				) : (
					<>
						<h1>{tokenType === 'reset' ? 'Reset Password' : 'Set Your Password'}</h1>
						<p>{tokenType === 'reset'
							? 'Enter your new password below.'
							: 'Welcome! Set a password for your account.'}</p>
						<form id="set-password-form">
							<input type="hidden" id="token" value={token} />

							<label for="password">New Password</label>
							<input type="password" id="password" name="password" required
								minlength="8" autocomplete="new-password" />

							<label for="confirm">Confirm Password</label>
							<input type="password" id="confirm" name="confirm" required
								minlength="8" autocomplete="new-password" />

							<div id="error-msg" class="auth-error" hidden></div>
							<button type="submit">Set Password</button>
						</form>
					</>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.auth-card {
		max-width: 400px;
		margin: 2rem auto;
		padding: 2rem;
		border: 1px solid #c99026;
		border-radius: 8px;
		background: rgba(245, 228, 196, 0.3);
	}
	h1 {
		text-align: center;
		margin-bottom: 1rem;
	}
	p {
		text-align: center;
		margin-bottom: 1.5rem;
	}
	label {
		display: block;
		margin-bottom: 0.3rem;
		font-weight: bold;
	}
	input[type="password"] {
		width: 100%;
		padding: 0.6rem;
		margin-bottom: 1rem;
		border: 1px solid #c99026;
		border-radius: 4px;
		box-sizing: border-box;
		background: rgba(255,255,255,0.8);
	}
	button {
		width: 100%;
		padding: 0.75rem;
		background: #744908;
		color: #F5E4C4;
		border: none;
		border-radius: 4px;
		cursor: pointer;
		font-size: 1rem;
		font-weight: bold;
	}
	button:hover {
		background: #c99026;
	}
	button:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.auth-error {
		color: #a00;
		margin-bottom: 1rem;
		text-align: center;
	}
	.auth-message {
		text-align: center;
	}
	.auth-message a {
		display: inline-block;
		margin-top: 1rem;
		color: #744908;
		font-weight: bold;
	}

	:global(html.dark) .auth-card {
		background: rgba(50, 30, 14, 0.5);
		border-color: #6B4710;
	}
	:global(html.dark) input[type="password"] {
		background: rgba(30, 20, 10, 0.6);
		color: #F5E4C4;
		border-color: #6B4710;
	}
	:global(html.dark) button {
		background: #6B4710;
	}
	:global(html.dark) button:hover {
		background: #8B6914;
	}
	:global(html.dark) .auth-error {
		color: #ff8080;
	}
	:global(html.dark) .auth-message a {
		color: #DEB96E;
	}
</style>

<script>
	const form = document.getElementById('set-password-form') as HTMLFormElement | null;
	if (form) {
		const errorMsg = document.getElementById('error-msg') as HTMLDivElement;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			errorMsg.hidden = true;

			const token = (document.getElementById('token') as HTMLInputElement).value;
			const password = (document.getElementById('password') as HTMLInputElement).value;
			const confirm = (document.getElementById('confirm') as HTMLInputElement).value;
			const btn = form.querySelector('button') as HTMLButtonElement;

			if (password !== confirm) {
				errorMsg.textContent = 'Passwords do not match';
				errorMsg.hidden = false;
				return;
			}

			if (password.length < 8) {
				errorMsg.textContent = 'Password must be at least 8 characters';
				errorMsg.hidden = false;
				return;
			}

			btn.disabled = true;
			try {
				const res = await fetch('/api/auth/set-password', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ token, password }),
				});
				const data = await res.json();

				if (!res.ok) {
					errorMsg.textContent = data.error || 'Failed to set password';
					errorMsg.hidden = false;
					return;
				}

				// Replace form with success message
				form.innerHTML = `
					<div style="text-align:center">
						<h2 style="color:#2a7a2a">Password set!</h2>
						<p>You can now <a href="/tavern/login" style="font-weight:bold">log in</a>.</p>
					</div>
				`;
			} catch {
				errorMsg.textContent = 'Something went wrong. Please try again.';
				errorMsg.hidden = false;
			} finally {
				btn.disabled = false;
			}
		});
	}
</script>
