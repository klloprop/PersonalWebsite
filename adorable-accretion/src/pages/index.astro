---
/**
 * index.astro — Landing page.
 *
 * Full-width split layout: Studio (left) and Tavern (right).
 * Studio: PolaroidGroup.png background + TopPolaroid.png as clickable button.
 * Tavern: BigSignWChains.png + chains.png with top sign as clickable button.
 * Mobile: stacked vertically, Tavern on top.
 */
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preload" href="/images/landing/PolaroidGroup.webp" as="image" type="image/webp" />
		<link rel="preload" href="/images/landing/TopPolaroid.webp" as="image" type="image/webp" />
		<link rel="preload" href="/images/landing/BigSignWChains.webp" as="image" type="image/webp" />
		<link rel="preload" href="/images/landing/chains.webp" as="image" type="image/webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Indie+Flower&family=Trade+Winds&display=swap" rel="stylesheet" />
		<style>
			/* ===== LAYOUT ===== */
			html, body {
				height: 100%;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
			}
			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			.landing {
				flex: 1;
				display: flex;
				flex-direction: row;
				min-height: calc(100vh - 4rem);
				width: 100%;
				max-width: 100vw;
				margin: 0;
				padding: 0;
				overflow: hidden;
			}

			/* ===== PANEL BASE ===== */
			.panel {
				flex: 1;
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}

			/* ===== STUDIO PANEL (LEFT) ===== */
			.panel-studio {
				background: linear-gradient(
					180deg,
					#421627 0%,
					#924b72 100%
				);
			}
			.panel-studio::before {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(
					180deg,
					#421627 0%,
					#ff6abc 100%
				);
				opacity: 0;
				transition: opacity 0.4s ease;
				z-index: 0;
			}
			.panel-studio:has(.studio-button:hover)::before {
				opacity: 1;
			}

			/* Polaroid group (without top polaroid) as background */
			.studio-bg {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
				transform: translateY(5%);
			}
			.studio-bg img {
				width: 900px;          /* ← fixed size, adjust as needed */
				height: auto;
				max-width: none;       /* prevent shrinking */
			}

			/* Top polaroid as the clickable button */
			.studio-button {
				position: relative;
				z-index: 2;
				display: block;
				text-decoration: none;
				color: inherit;
				/* Match the original rotation from the design */
				transform: rotate(-2deg);
				transition: transform 0.3s ease, box-shadow 0.3s ease;
				margin-top: 120px;
				margin-left: 60px;
			}
			.studio-button:hover {
				transform: rotate(0deg) scale(1.05);
				z-index: 10;
			}
			.studio-button img {
				width: 450px;
				height: auto;
				display: block;
			}
			.studio-title {
				position: absolute;
				top: 34%;              /* ← vertical position on the polaroid */
				left: 45%;             /* ← horizontal position on the polaroid */
				transform: translate(-50%, -50%);
				font-family: 'Indie Flower', regular;
				font-size: 5rem;     /* ← title font size */
				color: white;
				text-shadow: 2px 3px 6px rgba(0, 0, 0, 0.5);
				text-align: center;
				line-height: 1.2;
				margin: 0;
				pointer-events: none;
			}

			/* Studio description text */
			.studio-desc {
				position: absolute;
				z-index: 2;
				font-family: 'Indie Flower', cursive;
				font-size: 1.4rem;
				color: #333;
				text-align: center;
				line-height: 1.5;
				max-width: 280px;
				top: 60%;              /* ← vertical position on the polaroid */
				left: 12%;  
				pointer-events: none;
			}

			/* ===== TAVERN PANEL (RIGHT) ===== */
			.panel-tavern {
				overflow: hidden;
				background: linear-gradient(
					180deg,
					#2e1d0f 0%,
					#774904 100%
				);
			}
			.panel-tavern::before {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(
					180deg,
					#2e1d0f 0%,
					#e6951b 100%
				);
				opacity: 0;
				transition: opacity 0.4s ease;
				z-index: 0;
			}
			.panel-tavern:has(.tavern-button:hover)::before {
				opacity: 1;
			}

			/* Chains background layer */
			.tavern-chains {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
				z-index: 1;
				transition: transform 0.4s ease;
			}
			.panel-tavern:has(.tavern-button:hover) .tavern-chains {
				transform: translateY(-30px);
			}
			.tavern-chains img {
				width: 900px;          /* ← fixed size, adjust as needed */
				height: auto;
				max-width: none;
				opacity: 1;
			}

			/* Sign image */
			.tavern-bg {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
				z-index: 2;
				transform: translateY(-600px);
			}
			.tavern-bg img {
				width: 600px;          /* ← adjust size as needed */
				height: auto;
				max-width: none;
			}
			.tavern-bg picture {
				display: contents;
			}

			/* Top sign as clickable button */
			.tavern-button {
				position: relative;
				z-index: 3;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-decoration: none;
				color: inherit;
				/* Sized to overlay the upper sign panel */
				width: 100%;
				max-width: 500px;
				padding: 1.5rem 1rem;
				top: 230px;
				left: 0;
				transition: transform 0.3s ease;
			}
			.tavern-button:hover {
				transform: scale(1.00);
			}
			.tavern-title {
				font-family: 'Trade Winds', serif;
				font-size: 5rem;
				color: white;
				text-shadow: 2px 3px 6px rgba(0, 0, 0, 0.7);
				margin: 0;
				line-height: 1.15;
				text-align: center;
			}

			/* Tavern description (non-clickable) */
			.tavern-desc {
				position: relative;
				z-index: 3;
				font-family: 'Trade Winds', serif;
				font-size: 1.3rem;
				color: white;
				text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.6);
				max-width: 330px;
				line-height: 1.5;
				margin-top: 450px;
				text-align: center;
				pointer-events: none;
			}
			.tavern-desc p {
				margin: 0.3rem 0;
			}

			/* ===== RESPONSIVE ===== */

			/* Shorter desktop screens — row layout still active */
			@media (min-width: 1001px) and (max-height: 1100px) {
				.studio-button {
					margin-top: 60px;
					margin-left: 60px;
				}
				.studio-button img {
					width: 350px;
				}
				.studio-title {
					font-size: 3.5rem;
				}
				.studio-desc {
					font-size: 1.2rem;
					max-width: 300px;
					margin-right: 19%;
				}
				.studio-bg img {
					width: 700px;
				}
				.tavern-button {
					top: 200px;
				}
				.tavern-title {
					font-size: 4.5rem;
				}
				.tavern-desc {
					font-size: 1.2rem;
					max-width: 300px;
					margin-top: 360px;
				}
				.tavern-bg {
					transform: translateY(-500px);
				}
				.tavern-bg img {
					width: 500px;
				}
				.tavern-chains img {
					width: 800px;
				}
			}

			/* Short desktop screens (e.g. 1366×768 laptops) — row layout */
			@media (min-width: 1001px) and (max-height: 900px) {
				.studio-button {
					margin-top: 30px;
					margin-left: 50px;
				}
				.studio-button img {
					width: 300px;
				}
				.studio-title {
					font-size: 2.8rem;
				}
				.studio-desc {
					font-size: 1rem;
					max-width: 220px;
					margin-right: 19%;
				}
				.studio-bg img {
					width: 600px;
				}
				.tavern-button {
					top: 60px;
				}
				.tavern-title {
					font-size: 3.5rem;
				}
				.tavern-desc {
					font-size: 0.9rem;
					max-width: 250px;
					margin-top: 180px;
				}
				.tavern-bg {
					transform: translateY(-420px);
				}
				.tavern-bg img {
					width: 380px;
				}
				.tavern-chains img {
					width: 600px;
				}
			}

			/* Tablet and below — switch to vertical column layout */
			@media (max-width: 1100px) {
				.landing {
					flex-direction: column;
				}
				.panel-studio {
					order: 3;
				}
				.panel-tavern {
					order: 1;
				}
				.panel {
					flex: 1 1 0;
					min-height: 0;
				}

				.studio-button {
					margin-top: 60px;
					margin-right:10px;
				}
				.studio-button img {
					width: 350px;
				}
				.studio-title {
					font-size: 3.5rem;
				}
				.studio-desc {
					font-size: 1.2rem;
					max-width: 260px;
					margin-right: 20%;
				}
				.studio-bg img {
					width: 650px;
				}
				.tavern-button {
					top: 55px;
					left: 0;
				}
				.tavern-title {
					font-size: 3.5rem;
				}
				.tavern-desc {
					font-size: 1rem;
					max-width: 280px;
					margin-top: 180px;
				}
				.tavern-bg {
					transform: translateY(-450px);
				}
				.tavern-bg img {
					width: 400px;
				}
				.tavern-chains {
					left: 4%;
				}
				.tavern-chains img {
					width: 700px;
				}
			}

			/* Phones (narrow screens) */
			@media (max-width: 600px) {
				.studio-button img {
					width: 300px;
				}
				.studio-title {
					font-size: 3rem;
				}
				.studio-desc {
					font-size: 1rem;
				}
				.studio-bg img {
					width: 550px;
				}
				.tavern-button {
					top: 45px;
				}
				.tavern-title {
					font-size: 3rem;
				}
				.tavern-desc {
					font-size: 0.9rem;
					max-width: 220px;
					margin-top: 140px;
				}
				.tavern-bg {
					transform: translateY(-400px);
				}
				.tavern-bg img {
					width: 350px;
				}
				.tavern-chains img {
					width: 600px;
				}
			}

			/* Narrow screens (any height) OR short screens in column layout */
			@media (max-width: 500px), (max-width: 1000px) and (max-height: 900px) {
				.studio-button img {
					width: 200px;
				}
				.studio-title {
					font-size: 2.5rem;
				}
				.studio-desc {
					font-size: 0.7rem;
					max-width: 170px;
					margin-right: 19%;
				}
				.studio-bg img {
					width: 350px;
				}
				.tavern-button {
					top: 6px;
				}
				.tavern-title {
					font-size: 2rem;
				}
				.tavern-desc {
					font-size: 0.5rem;
					max-width: 130px;
					margin-top: 45px;
				}
				.tavern-bg {
					transform: translateY(-230px);
				}
				.tavern-bg img {
					width: 200px;
				}
				.tavern-chains img {
					width: 300px;
				}
			}
		
		</style>
	</head>
	<body>
		<main class="landing">
			<!-- ===== STUDIO PANEL ===== -->
			<section class="panel panel-studio">
				<!-- Polaroid group background (without top polaroid) -->
				<div class="studio-bg">
					<picture>
						<source srcset="/images/landing/PolaroidGroup.webp" type="image/webp" />
						<img src="/images/landing/PolaroidGroup.png" alt="Studio polaroid collage" width="2093" height="2581" loading="lazy" />
					</picture>
				</div>
				<!-- Top polaroid as clickable button -->
				<a href="/studio/blog" class="studio-button">
					<picture>
						<source srcset="/images/landing/TopPolaroid.webp" type="image/webp" />
						<img src="/images/landing/TopPolaroid.png" alt="To the Studio!" width="1133" height="1548" fetchpriority="high" />
					</picture>
					<h2 class="studio-title">To the<br>Studio!</h2>
					<p class="studio-desc">
						A personal blog and a small photo studio for you to explore!
						Just generally stuff I want to share with the world.
					</p>
				</a>
			</section>

			<!-- ===== TAVERN PANEL ===== -->
			<section class="panel panel-tavern">
				<!-- Chains background -->
				<div class="tavern-chains">
					<picture>
						<source srcset="/images/landing/chains.webp" type="image/webp" />
						<img src="/images/landing/chains.png" alt="" width="1606" height="2461" loading="lazy" />
					</picture>
				</div>
				<!-- Sign image -->
				<div class="tavern-bg">
					<picture>
						<source srcset="/images/landing/BigSignWChains.webp" type="image/webp" />
						<img src="/images/landing/BigSignWChains.png" alt="Tavern sign" width="1235" height="4569" loading="lazy" />
					</picture>
				</div>
				<!-- Top sign as clickable button -->
				<a href="/tavern/scheduling" class="tavern-button">
					<h2 class="tavern-title">To The<br>Tavern!</h2>
				</a>
				<!-- Description text -->
				<div class="tavern-desc">
					<p>Come in! There is always a seat for you.</p>
					<p>Vote on scheduling and explore Pen and Paper content here.</p>
				</div>
			</section>
		</main>
	</body>
</html>
