---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html, body {
				height: 100%;
				overflow-x: hidden;
			}
			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			main {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				max-width: 800px;
				width: 100%;
				padding: 2rem;
				text-align: center;
				position: relative;
				z-index: 2;
				box-sizing: border-box;
			}
			h1 {
				font-size: 3rem;
				margin-bottom: 2rem;
				border-radius: 10px;
				padding: 1rem;
				background: rgba(255, 255, 255, 0.9);
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			}
			.choices {
				display: flex;
				flex-direction: row;
				gap: 2rem;
				align-items: center;
				justify-content: center;
			}
			.choice {
				max-width: 400px;
				width: 100%;
				border-radius: 10px;
				padding: 1.5rem;
				background: rgba(255, 255, 255, 0.9);
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
				text-align: center;
				box-sizing: border-box;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			.button {
				display: inline-block;
				padding: 1.5rem 3rem;
				font-size: 1.5rem;
				font-weight: bold;
				color: white;
				border-radius: 8px;
				text-decoration: none;
				transition: background 0.2s;
				max-width: 250px;
				width: 100%;
				box-sizing: border-box;
			}
			.button-studio {
				background: #3b82f6;
			}
			.button-studio:hover {
				background: #2563eb;
			}
			.button-tavern {
				background: linear-gradient(180deg, #8B6914, #5C3D0E);
				border: 2px solid #3E2703;
				text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
				font-family: Georgia, 'Times New Roman', serif;
			}
			.button-tavern:hover {
				background: linear-gradient(180deg, #A07818, #6B4710);
			}
			.choice p {
				margin-top: 1rem;
				font-size: 1.1rem;
				color: var(--gray);
			}

			:global(html.dark) body {
				background: var(--bg);
			}
			:global(html.dark) h1 {
				color: rgb(var(--black));
				background: rgba(34, 34, 58, 0.9);
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
			}
			:global(html.dark) .choice {
				background: rgba(34, 34, 58, 0.9);
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
			}
			:global(html.dark) .choice p {
				color: rgb(var(--gray));
			}
			.choice-tavern {
				background: linear-gradient(180deg, rgba(245, 228, 196, 0.95), rgba(222, 196, 154, 0.95));
				border: 2px solid #8B6914;
				box-shadow: inset 0 1px 3px rgba(139, 105, 20, 0.2), 0 4px 6px rgba(0, 0, 0, 0.15);
			}
			:global(html.dark) .choice-tavern {
				background: linear-gradient(180deg, rgba(62, 39, 3, 0.95), rgba(40, 25, 2, 0.95));
				border-color: #8B6914;
				box-shadow: inset 0 1px 3px rgba(139, 105, 20, 0.3), 0 4px 6px rgba(0, 0, 0, 0.4);
			}
			:global(html.dark) .background-left {
				background: linear-gradient(180deg, rgba(30, 64, 175, 0.3), rgba(26, 26, 46, 0.2));
			}
			@media (max-width: 600px) {
				.choices {
					flex-direction: column;
					gap: 1.5rem;
				}
				h1 {
					font-size: 1.8rem;
					padding: 0.75rem;
					max-width: 100%;
					box-sizing: border-box;
				}
				.button {
					padding: 1rem 2rem;
					font-size: 1.1rem;
				}
				.choice p {
					font-size: 0.95rem;
				}
				main {
					padding: 1rem;
				}
				.background-left,
				.background-right {
					display: none;
				}
			}
			.background-left,
			.background-right {
				position: fixed;
				top: 0;
				bottom: 0;
				width: 50%;
				background-size: cover;
				background-position: center;
				opacity: 0;
				transition: opacity 0.3s ease;
				z-index: 1;
			}
			.background-left {
				left: 0;
				background: linear-gradient(180deg, rgba(59, 130, 246, 0.22), rgba(255, 255, 255, 0.1));
			}
			.background-right {
				right: 0;
				background-image: url('https://www.dieharddice.com/cdn/shop/files/M0510020_SkyforgeHexbreaker.jpg?v=1750180662');
			}
			.background-left:hover,
			.background-right:hover {
				opacity: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="background-left"></div>
		<div class="background-right"></div>
		<main>
			<h1>Welcome to Lucy's Blog</h1>
			<div class="choices">
				<div class="choice">
					<a href="/studio" class="button button-studio">To the Studio!</a>
					<p>A personal diary-style blog and a small digital studio for you to explore! Just generally stuff I want to share with the world.</p>
				</div>
				<div class="choice choice-tavern">
					<a href="/tavern/scheduling" class="button button-tavern">&#9876; To the Tavern!</a>
					<p>Come into my Tavern, there is always a seat reserved for you! <br>
						Explore Pen and Paper content and recent developments in the latest Campaign.
					</p>
				</div>
			</div>
		</main>
		<Footer />
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const leftBg = document.querySelector('.background-left');
				const rightBg = document.querySelector('.background-right');
				const leftButton = document.querySelector('.choice:first-child .button');
				const rightButton = document.querySelector('.choice:last-child .button');

				document.addEventListener('mousemove', (e) => {
					const mouseX = e.clientX;
					const mouseY = e.clientY;

					// Get button positions
					const leftRect = leftButton.getBoundingClientRect();
					const rightRect = rightButton.getBoundingClientRect();

					// Calculate distance from mouse to button centers
					const leftCenterX = leftRect.left + leftRect.width / 2;
					const leftCenterY = leftRect.top + leftRect.height / 2;
					const rightCenterX = rightRect.left + rightRect.width / 2;
					const rightCenterY = rightRect.top + rightRect.height / 2;

					const leftDistance = Math.sqrt((mouseX - leftCenterX) ** 2 + (mouseY - leftCenterY) ** 2);
					const rightDistance = Math.sqrt((mouseX - rightCenterX) ** 2 + (mouseY - rightCenterY) ** 2);

					// Max distance for full opacity (adjust as needed)
					const maxDistance = 300;

					// Calculate opacity (closer = more opaque, from 20% to 80%)
					const leftOpacity = 0.2 + (0.6 * Math.max(0, 1 - leftDistance / maxDistance));
					const rightOpacity = 0.2 + (0.6 * Math.max(0, 1 - rightDistance / maxDistance));

					leftBg.style.opacity = leftOpacity;
					rightBg.style.opacity = rightOpacity;
				});
			});
		</script>
	</body>
</html>
