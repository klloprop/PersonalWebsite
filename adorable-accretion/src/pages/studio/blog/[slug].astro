---
export const prerender = false;

/**
 * studio/blog/[slug].astro — Individual blog post page (SSR + ISR).
 *
 * Body content is fetched from GitHub at request time for instant updates.
 * Images and layout metadata come from the build-time content collection.
 * ISR caches the result; on-demand revalidation busts it after edits.
 */
import BlogPost from '../../../layouts/BlogPost.astro';
import { getEntry } from 'astro:content';
import { renderFromGitHub } from '../../../lib/content-renderer';

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404, statusText: 'Not Found' });

const post = await getEntry('blog', slug);
if (!post) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Fetch latest body from GitHub (instant updates, no rebuild needed)
const filePath = post.filePath || `src/content/blog/${post.id}.md`;
const rendered = await renderFromGitHub('blog', filePath);

// Always serve fresh runtime content for live edits.
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

// Use GitHub frontmatter for title/description if available
const title = rendered?.frontmatter.title || post.data.title;
const description = rendered?.frontmatter.description || post.data.description;
const bodyHtml = rendered?.html || '';
---

<BlogPost {...post.data} title={title} description={description}>
	<Fragment set:html={bodyHtml} />
</BlogPost>
