---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import D20Icon from '../../../assets/D20_Icon.png';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const placeholderColors = ['#f97316', '#10b981', '#8b5cf6'];
const defaultHeroImage = D20Icon;
const getHeroImage = (heroImage) =>
	typeof heroImage === 'string' || !heroImage ? defaultHeroImage : heroImage;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background: #eff6ff;
			}
			:global(html.dark) body {
				background: var(--bg);
			}
			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2.5rem 2rem;
			}
			.featured-post {
				margin-bottom: 2rem;
			}
			.featured-post li {
				grid-column: 1 / -1;
				min-height: 560px;
			}
			.featured-post .image-placeholder {
				height: 360px;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.75rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				background: white;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}
			.card-link {
				color: inherit;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.image-placeholder {
				height: 260px;
				width: 100%;
			}
			.card-content {
				padding: 2rem;
				flex: 1;
			}
			h2 {
				margin: 0 0 0.75rem 0;
				font-size: 1.55rem;
			}
			.date {
				margin: 0 0 1rem;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.75;
			}
			.card-link:hover .description,
			.card-link:hover h2 {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				main {
					padding: 1.25rem;
				}
			}
			:global(html.dark) li {
				background: #22223a;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{posts.length > 0 && (
					<div class="featured-post">
						<ul>
							<li>
								<a class="card-link" href={`/studio/blog/${posts[0].slug ?? posts[0].id}/`}>
								<Image src={getHeroImage(posts[0].data.heroImage)} alt={posts[0].data.title} width={880} height={420} />
												<div class="card-content">
										<h2>{posts[0].data.title}</h2>
										<p class="date">Published {posts[0].data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
										<p class="description">{posts[0].data.description}</p>
									</div>
								</a>
							</li>
						</ul>
					</div>
				)}
				<ul>
					{posts.slice(1).map((post, index) => (
						<li>
							<a class="card-link" href={`/studio/blog/${post.slug ?? post.id}/`}>
								<Image src={getHeroImage(post.data.heroImage)} alt={post.data.title} width={680} height={320} />
								<div class="card-content">
									<h2>{post.data.title}</h2>
									<p class="date">Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
									<p class="description">{post.data.description}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
