---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Load collections from content and count matching posts
const collectionEntries = (await getCollection('blogCollections')).sort(
	(a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
const collections = collectionEntries.map((col) => ({
	name: col.data.name,
	image: col.data.image,
	description: col.data.description,
	count: posts.filter((p) => p.data.collection === col.data.name).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.blog-layout {
				position: relative;
				max-width: 1400px;
				margin: 0 auto;
				padding: 2.5rem 2rem;
				display: flex;
				justify-content: center;
			}
			/* Sidebar */
			.sidebar {
				width: 240px;
				position: fixed;
				top: 5rem;
				left: max(1rem, calc((100vw - 1400px) / 2 + 1rem));
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				background: white;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
				padding: 1.25rem 0.75rem;
				z-index: 10;
			}
			:global(html.dark) .sidebar {
				background: #2a1428;
			}
			.sidebar-title {
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem;
				padding: 0 0.5rem;
			}
			.sidebar-btn {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				width: 100%;
				padding: 0.6rem 0.75rem;
				border: none;
				border-radius: 10px;
				background: none;
				cursor: pointer;
				text-align: left;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
				transition: background 0.2s;
			}
			.sidebar-btn:hover {
				background: rgba(155, 16, 136, 0.08);
			}
			.sidebar-btn.active {
				background: rgba(155, 16, 136, 0.12);
				font-weight: 700;
				color: #6b1d5e;
			}
			:global(html.dark) .sidebar-btn.active {
				background: rgba(243, 132, 224, 0.15);
				color: #f384e0;
			}
			:global(html.dark) .sidebar-btn:hover {
				background: rgba(243, 132, 224, 0.1);
			}
			.sidebar-btn .collection-img {
				width: 36px;
				height: 36px;
				border-radius: 8px;
				object-fit: cover;
				flex-shrink: 0;
			}
			.sidebar-btn .all-icon {
				width: 36px;
				height: 36px;
				border-radius: 8px;
				background: #9b1088;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				color: white;
				font-size: 1.1rem;
			}
			.sidebar-btn .collection-info {
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.sidebar-btn .collection-name {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.sidebar-btn .collection-count {
				font-size: 0.75rem;
				color: rgb(var(--gray));
			}
			.sidebar-divider {
				height: 1px;
				background: rgb(var(--gray-light));
				margin: 0.5rem 0;
			}
			/* Main content */
			.blog-content {
				flex: 0 1 900px;
				min-width: 0;
				width: auto !important;
				max-width: none !important;
				padding: 0 !important;
				margin: 0 !important;
			}
			.section-heading {
				font-size: 1.35rem;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--gray-dark));
			}
			.other-heading {
				margin-top: 8rem;
				padding-top: 0.75rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			ul.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.75rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li.post-card.featured {
				grid-column: 1 / -1;
			}
			li.post-card.featured img {
				height: 360px;
				object-fit: cover;
				width: 100%;
			}
			li.post-card {
				background: white;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}
			.card-link {
				color: inherit;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.card-content {
				padding: 2rem;
				flex: 1;
			}
			.blog-content h2 {
				margin: 0 0 0.75rem 0;
				font-size: 1.55rem;
			}
			.date {
				margin: 0 0 1rem;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.75;
			}
			.card-link:hover .description,
			.card-link:hover h2 {
				color: rgb(var(--accent));
			}
			.collection-badge {
				display: inline-block;
				font-size: 0.75rem;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				background: rgba(155, 16, 136, 0.1);
				color: #6b1d5e;
				margin-bottom: 0.5rem;
			}
			:global(html.dark) .collection-badge {
				background: rgba(243, 132, 224, 0.15);
				color: #f384e0;
			}
			@media (max-width: 720px) {
				.blog-layout {
					flex-direction: column;
					padding: 1.25rem;
				}
				.sidebar {
					width: 100%;
					max-width: 100%;
					box-sizing: border-box;
					position: static;
					max-height: none;
					display: flex;
					gap: 0.5rem;
					overflow-x: auto;
					flex-wrap: wrap;
					border-radius: 12px;
					padding: 0.75rem;
				}
				.sidebar-title {
					display: none;
				}
				.sidebar-divider {
					display: none;
				}
				.sidebar-btn {
					white-space: nowrap;
					flex-shrink: 1;
					padding: 0.5rem 0.75rem;
					border-radius: 999px;
					border: 1px solid rgb(var(--gray-light));
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.sidebar-btn .collection-img,
				.sidebar-btn .all-icon {
					width: 24px;
					height: 24px;
				}
				.sidebar-btn .collection-count {
					display: none;
				}
				ul.post-grid {
					grid-template-columns: 1fr;
				}
				li.post-card.featured img {
					height: 200px;
				}
				.card-content {
					padding: 1.25rem;
				}
				.blog-content h2 {
					font-size: 1.25rem;
				}
				.section-heading {
					font-size: 1.15rem;
				}
				.other-heading {
					margin-top: 3rem;
				}
			}
			:global(html.dark) li.post-card {
				background: #2a1428;
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="blog-layout">
			<aside class="sidebar">
				<p class="sidebar-title">Collections</p>
				<button class="sidebar-btn active" data-collection="all">
					<span class="all-icon">
						<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
					</span>
					<span class="collection-info">
						<span class="collection-name">All Posts</span>
						<span class="collection-count">{posts.length} posts</span>
					</span>
				</button>
				<div class="sidebar-divider"></div>
				{collections.map((col) => (
					<button class="sidebar-btn" data-collection={col.name}>
						<Image class="collection-img" src={col.image} alt={col.name} width={36} height={36} />
						<span class="collection-info">
							<span class="collection-name">{col.name}</span>
							<span class="collection-count">{col.count} {col.count === 1 ? 'post' : 'posts'}</span>
						</span>
					</button>
				))}
			</aside>
			<main class="blog-content">
				<section>
					<h2 class="section-heading">Most Recent Post</h2>
					<ul class="post-grid featured-section">
					{posts.slice(0, 1).map((post) => (
						<li class="post-card featured" data-collection={post.data.collection || ''}>
								<a class="card-link" href={`/studio/blog/${post.slug ?? post.id}/`}>
								{post.data.heroImage && <Image src={post.data.heroImage} alt={post.data.title} width={680} height={320} />}
									<div class="card-content">
										{post.data.collection && <span class="collection-badge">{post.data.collection}</span>}
										<h2>{post.data.title}</h2>
										<p class="date">Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
										<p class="description">{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
					<h2 class="section-heading other-heading">Other Posts</h2>
					<ul class="post-grid other-section">
					{posts.slice(1).map((post) => (
						<li class="post-card" data-collection={post.data.collection || ''}>
								<a class="card-link" href={`/studio/blog/${post.slug ?? post.id}/`}>
								{post.data.heroImage && <Image src={post.data.heroImage} alt={post.data.title} width={680} height={320} />}
									<div class="card-content">
										{post.data.collection && <span class="collection-badge">{post.data.collection}</span>}
										<h2>{post.data.title}</h2>
										<p class="date">Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
										<p class="description">{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			</main>
		</div>
		<Footer />
		<script>
			function initCollectionFilter() {
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const cards = document.querySelectorAll<HTMLElement>('.post-card');
				const featuredSection = document.querySelector<HTMLElement>('.featured-section');
				const otherSection = document.querySelector<HTMLElement>('.other-section');
				const featuredHeading = document.querySelector<HTMLElement>('.section-heading:not(.other-heading)');
				const otherHeading = document.querySelector<HTMLElement>('.other-heading');

				function filterTo(selected: string) {
					buttons.forEach((b) => {
						b.classList.toggle('active', b.dataset.collection === selected);
					});
					let visibleCount = 0;
					cards.forEach((card) => {
						const visible = selected === 'all' || card.dataset.collection === selected;
						card.style.display = visible ? '' : 'none';
						if (visible) {
							visibleCount++;
							if (visibleCount === 1) {
								card.classList.add('featured');
								if (featuredSection && !featuredSection.contains(card)) {
									featuredSection.appendChild(card);
								}
							} else {
								card.classList.remove('featured');
								if (otherSection && !otherSection.contains(card)) {
									otherSection.appendChild(card);
								}
							}
						}
					});
					if (otherHeading) otherHeading.style.display = visibleCount > 1 ? '' : 'none';
					if (otherSection) otherSection.style.display = visibleCount > 1 ? '' : 'none';
					if (featuredHeading) featuredHeading.style.display = visibleCount > 0 ? '' : 'none';
					if (featuredSection) featuredSection.style.display = visibleCount > 0 ? '' : 'none';
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						filterTo(btn.dataset.collection!);
					});
				});

				// Check for ?collection= query param
				const params = new URLSearchParams(window.location.search);
				const col = params.get('collection');
				if (col) {
					filterTo(col);
				}
			}
			initCollectionFilter();
			document.addEventListener('astro:after-swap', initCollectionFilter);
		</script>
	</body>
</html>
