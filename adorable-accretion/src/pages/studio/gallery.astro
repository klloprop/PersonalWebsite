---
/**
 * studio/gallery.astro — Photo gallery with infinite scroll.
 *
 * Features:
 *  - Reads images from src/assets/StudioImages/ subfolders.
 *  - Extracts EXIF DateTimeOriginal via Sharp for chronological sorting.
 *  - Folder-based collection sidebar for filtering.
 *  - IntersectionObserver-driven infinite scroll (batch size: 24).
 *  - Renders each image as a Polaroid card with random rotation.
 *  - Responsive: 3-column desktop, 2-column mobile grid.
 */
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Polaroid from '../../components/Polaroid.astro';
import { SITE_TITLE } from '../../consts';

import sharp from 'sharp';
import exifReader from 'exif-reader';
import fs from 'node:fs';
import path from 'node:path';

// Eagerly import all images from StudioImages (including subfolders)
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/StudioImages/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
	{ eager: true }
);

// Read EXIF dates and derive collections from folder structure
const imagesWithDates: { src: ImageMetadata; filename: string; date: Date; collection: string }[] = [];

for (const [modulePath, mod] of Object.entries(imageModules)) {
	const filename = modulePath.split('/').pop()!;
	// Path relative to StudioImages, e.g. "subfolder/image.jpg" or "image.jpg"
	const relPath = modulePath.replace('/src/assets/StudioImages/', '');
	const parts = relPath.split('/');
	// Direct children → no collection; subfolder images → collection = folder name
	const collection = parts.length > 1 ? parts[0] : '';

	const filePath = path.join(process.cwd(), 'src/assets/StudioImages', ...parts);

	let date: Date;
	try {
		const metadata = await sharp(filePath).metadata();
		if (metadata.exif) {
			const exif = exifReader(metadata.exif);
			const exifDate = exif.Photo?.DateTimeOriginal || exif.Image?.DateTime;
			date = exifDate instanceof Date ? exifDate : new Date(fs.statSync(filePath).mtime);
		} else {
			date = new Date(fs.statSync(filePath).mtime);
		}
	} catch {
		date = new Date(fs.statSync(filePath).mtime);
	}

	imagesWithDates.push({ src: mod.default, filename, date, collection });
}

// Sort newest first
imagesWithDates.sort((a, b) => b.date.getTime() - a.date.getTime());

// Discover collections from folder names
const collectionCounts = new Map<string, number>();
for (const img of imagesWithDates) {
	if (img.collection) {
		collectionCounts.set(img.collection, (collectionCounts.get(img.collection) || 0) + 1);
	}
}
const collections = [...collectionCounts.entries()]
	.sort((a, b) => a[0].localeCompare(b[0]))
	.map(([name, count]) => ({ name, count }));

// Generate rotation values: alternating slight rotations
const rotations = imagesWithDates.map((_, i) => {
	const base = ((i % 5) - 2) * 1.5; // -3, -1.5, 0, 1.5, 3
	return base;
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Gallery`} description="Photo gallery" />
	</head>
	<body>
		<Header />
		<div class="gallery-layout" style="flex: 1;">
			{collections.length > 0 && (
				<button class="sidebar-mobile-toggle" id="sidebar-mobile-toggle">
					<span class="toggle-label">Browse Collections</span>
					<svg class="toggle-chevron" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
				</button>
			)}
			{collections.length > 0 && (
				<aside class="sidebar">
					<p class="sidebar-title">Collections</p>
					<button class="sidebar-btn active" data-collection="all">
						<span class="all-icon">
							<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"/></svg>
						</span>
						<span class="collection-info">
							<span class="collection-name">All Photos</span>
							<span class="collection-count">{imagesWithDates.length} photos</span>
						</span>
					</button>
					<div class="sidebar-divider"></div>
					{collections.map((col) => (
						<button class="sidebar-btn" data-collection={col.name}>
							<span class="all-icon">
								<svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
							</span>
							<span class="collection-info">
								<span class="collection-name">{col.name}</span>
								<span class="collection-count">{col.count} {col.count === 1 ? 'photo' : 'photos'}</span>
							</span>
						</button>
					))}
				</aside>
			)}
			<main class="gallery-main">
				<h1>Gallery</h1>
				<div class="gallery-grid">
					{imagesWithDates.map((img, i) => (
						<div class="gallery-item" data-collection={img.collection}>
							<Polaroid
								src={img.src}
								alt={img.filename.replace(/\.[^.]+$/, '')}
								rotate={rotations[i]}
							/>
						</div>
					))}
				</div>
				<div class="scroll-sentinel"></div>
				<div class="loading-spinner" style="display:none">
					<div class="spinner"></div>
				</div>
			</main>
		</div>
		<Footer />
		<script>
			const BATCH = 24;

			function initGallery() {
				const sidebar = document.querySelector<HTMLElement>('.sidebar');
				const buttons = document.querySelectorAll<HTMLButtonElement>('.sidebar-btn');
				const allItems = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));
				const sentinel = document.querySelector<HTMLElement>('.scroll-sentinel');
				const spinner = document.querySelector<HTMLElement>('.loading-spinner');
				const mobileToggle = document.getElementById('sidebar-mobile-toggle') as HTMLButtonElement | null;
				const toggleLabel = mobileToggle?.querySelector('.toggle-label');

				let currentCollection = 'all';
				let shown = 0;
				let filtered: HTMLElement[] = [];

				function isMobile() {
					return window.matchMedia('(max-width: 1350px)').matches;
				}

				function closeMobileSidebar() {
					sidebar?.classList.remove('mobile-open');
					mobileToggle?.classList.remove('open');
					document.body.style.overflow = '';
				}

				function openMobileSidebar() {
					sidebar?.classList.add('mobile-open');
					sidebar?.classList.remove('scrolled-bottom');
					mobileToggle?.classList.add('open');
					document.body.style.overflow = 'hidden';
					requestAnimationFrame(() => {
						if (sidebar && sidebar.scrollHeight > sidebar.clientHeight) {
							sidebar.classList.add('can-scroll');
						} else {
							sidebar?.classList.remove('can-scroll');
						}
					});
				}

				sidebar?.addEventListener('scroll', () => {
					if (!sidebar) return;
					const atBottom = sidebar.scrollTop + sidebar.clientHeight >= sidebar.scrollHeight - 20;
					sidebar.classList.toggle('scrolled-bottom', atBottom);
				});

				mobileToggle?.addEventListener('click', () => {
					if (sidebar?.classList.contains('mobile-open')) {
						closeMobileSidebar();
					} else {
						openMobileSidebar();
					}
				});

				function getFiltered(): HTMLElement[] {
					return allItems.filter((item) => {
						const col = item.dataset.collection || '';
						return currentCollection === 'all' || col === currentCollection;
					});
				}

				function renderBatch() {
					const end = Math.min(shown + BATCH, filtered.length);
					for (let i = shown; i < end; i++) {
						filtered[i].style.display = '';
					}
					shown = end;
					if (spinner) spinner.style.display = shown < filtered.length ? '' : 'none';
				}

				function reset() {
					allItems.forEach((item) => { item.style.display = 'none'; });
					filtered = getFiltered();
					shown = 0;
					renderBatch();
				}

				// IntersectionObserver for infinite scroll
				let observer: IntersectionObserver | null = null;
				if (sentinel) {
					observer = new IntersectionObserver((entries) => {
						if (entries[0].isIntersecting && shown < filtered.length) {
							renderBatch();
						}
					}, { rootMargin: '400px' });
					observer.observe(sentinel);
				}

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						currentCollection = btn.dataset.collection!;
						buttons.forEach((b) => b.classList.toggle('active', b.dataset.collection === currentCollection));
						reset();
						if (toggleLabel) {
							toggleLabel.textContent = btn.dataset.collection === 'all'
								? 'Browse Collections'
								: btn.dataset.collection!;
						}
						if (isMobile()) {
							closeMobileSidebar();
						}
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
				});

				const params = new URLSearchParams(window.location.search);
				const col = params.get('collection');
				if (col) {
					currentCollection = col;
					buttons.forEach((b) => b.classList.toggle('active', b.dataset.collection === col));
				}

				reset();
			}
			initGallery();
			document.addEventListener('astro:after-swap', initGallery);
		</script>
	</body>
</html>

<style>
	.gallery-layout {
		position: relative;
		max-width: 1400px;
		margin: 0 auto;
		padding: 2.5rem 2rem;
		display: flex;
		justify-content: center;
	}
	/* Sidebar */
	.sidebar {
		width: 240px;
		position: fixed;
		top: 5rem;
		left: max(1rem, calc((100vw - 1400px) / 2 + 1rem));
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
		background: white;
		border-radius: 20px;
		box-shadow: var(--box-shadow);
		padding: 1.25rem 0.75rem;
		z-index: 10;
	}
	:global(html.dark) .sidebar {
		background: #2a1428;
	}
	.sidebar-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin: 0 0 0.75rem;
		padding: 0 0.5rem;
	}
	.sidebar-btn {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		padding: 0.6rem 0.75rem;
		border: none;
		border-radius: 10px;
		background: none;
		cursor: pointer;
		text-align: left;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		transition: background 0.2s;
	}
	.sidebar-btn:hover {
		background: rgba(155, 16, 136, 0.08);
	}
	.sidebar-btn.active {
		background: rgba(155, 16, 136, 0.12);
		font-weight: 700;
		color: #6b1d5e;
	}
	:global(html.dark) .sidebar-btn.active {
		background: rgba(243, 132, 224, 0.15);
		color: #f384e0;
	}
	:global(html.dark) .sidebar-btn:hover {
		background: rgba(243, 132, 224, 0.1);
	}
	.sidebar-btn .all-icon {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: #9b1088;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: white;
		font-size: 1.1rem;
	}
	.sidebar-btn .collection-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.sidebar-btn .collection-name {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sidebar-btn .collection-count {
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}
	.sidebar-divider {
		height: 1px;
		background: rgb(var(--gray-light));
		margin: 0.5rem 0;
	}
	/* Main content */
	.gallery-main {
		flex: 0 1 1100px;
		min-width: 0;
		width: auto !important;
		max-width: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}
	h1 {
		text-align: center;
		margin-bottom: 2rem;
	}
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		padding: 1rem;
		justify-items: center;
	}
	.gallery-item {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.scroll-sentinel {
		height: 1px;
	}
	.loading-spinner {
		display: flex;
		justify-content: center;
		padding: 2rem 0;
	}
	.spinner {
		width: 32px;
		height: 32px;
		border: 3px solid rgba(155, 16, 136, 0.2);
		border-top-color: #9b1088;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}
	:global(html.dark) .spinner {
		border-color: rgba(243, 132, 224, 0.2);
		border-top-color: #f384e0;
	}
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	/* ── Mobile collection toggle button ── */
	.sidebar-mobile-toggle {
		display: none;
	}
	@media (max-width: 1350px) {
		.sidebar-mobile-toggle {
			display: flex;
			align-items: center;
			justify-content: space-between;
			width: 100%;
			padding: 0.75rem 1rem;
			border: none;
			border-radius: 12px;
			background: white;
			color: rgb(var(--gray-dark));
			cursor: pointer;
			font-size: 1rem;
			font-weight: 600;
			margin-bottom: 0.75rem;
			box-shadow: var(--box-shadow);
		}
		:global(html.dark) .sidebar-mobile-toggle {
			background: #2a1428;
			color: #f384e0;
		}
		.sidebar-mobile-toggle .toggle-chevron {
			transition: transform 0.3s;
			flex-shrink: 0;
		}
		.sidebar-mobile-toggle.open .toggle-chevron {
			transform: rotate(180deg);
		}
		.gallery-layout {
			flex-direction: column;
			padding: 1.25rem;
			box-sizing: border-box;
			max-width: 100%;
		}
		.sidebar {
			width: 100%;
			max-width: 100%;
			box-sizing: border-box;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			max-height: 100vh;
			max-height: 100dvh;
			height: 100vh;
			height: 100dvh;
			overflow-y: auto;
			overflow-x: hidden;
			display: none;
			flex-direction: column;
			gap: 0.25rem;
			border-radius: 0;
			padding: 1rem 1rem 6rem;
			margin-bottom: 0;
			z-index: 100;
			overscroll-behavior: contain;
		}
		.sidebar.mobile-open {
			display: flex;
		}
		/* Scroll indicator */
		.sidebar::after {
			content: '⌄ scroll for more';
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			height: 4rem;
			background: linear-gradient(transparent, white 60%);
			display: none;
			align-items: flex-end;
			justify-content: center;
			padding-bottom: 1rem;
			font-size: 0.8rem;
			color: rgb(var(--gray));
			pointer-events: none;
			z-index: 101;
			opacity: 1;
			transition: opacity 0.2s ease;
		}
		.sidebar.can-scroll::after {
			display: flex;
		}
		.sidebar.scrolled-bottom::after {
			opacity: 0;
		}
		:global(html.dark) .sidebar.can-scroll::after {
			background: linear-gradient(transparent, #2a1428 60%);
			color: #f384e0;
		}
		.sidebar-title {
			display: block;
			font-size: 1.1rem;
			text-align: center;
			padding-bottom: 0.5rem;
			margin-bottom: 0.5rem;
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.sidebar-divider {
			display: block;
		}
		.sidebar-btn {
			white-space: normal;
			flex-shrink: 0;
			padding: 0.7rem 0.75rem;
			border-radius: 10px;
			border: none;
			font-size: 1rem;
		}
		.sidebar-btn .all-icon {
			width: 32px;
			height: 32px;
		}
		.sidebar-btn .collection-count {
			display: inline;
			font-size: 0.8rem;
		}
		.gallery-grid {
			gap: 1rem;
			padding: 0.5rem;
		}
		.gallery-item {
			min-width: 0;
			overflow: hidden;
		}
		.gallery-main {
			max-width: 100% !important;
			width: 100% !important;
			box-sizing: border-box;
		}
	}

		@media (max-width: 1000px) {
		.gallery-grid {
			gap: 0.5rem;
			padding: 0.5rem;
		}
		.gallery-item {
			min-width: 0;
			overflow: hidden;
		}
		.gallery-main {
			max-width: 100% !important;
			width: 100% !important;
			box-sizing: border-box;
		}
	}
	@media (max-width: 720px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
