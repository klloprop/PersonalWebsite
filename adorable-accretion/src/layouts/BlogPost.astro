---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import D20Icon from '../assets/D20_Icon.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Polaroid from '../components/Polaroid.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, galleryImages, collection } = Astro.props;

const rotations = [-4, 3, -2, 5, -3, 4, -5, 2];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			html, body {
				margin: 0;
				padding: 0;
			}
			main {
				margin-top: 0;
			}
			.hero-image {
				width: 100vw;
				height: 50vh;
				min-height: 250px;
				max-height: 500px;
				overflow: hidden;
				position: relative;
				margin: 0;
				padding: 0;
			}
			.hero-image::after {
				content: '';
				display: block;
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(255,255,255,0) 55%, rgba(255,255,255,1) 100%);
				pointer-events: none;
			}
			:global(html.dark) .hero-image::after {
				background: linear-gradient(180deg, rgba(26,26,46,0) 55%, rgba(26,26,46,1) 100%);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.blog-layout {
				display: flex;
				justify-content: center;
				position: relative;
				max-width: 1400px;
				margin: 0 auto;
			}

			.polaroid-column {
				display: none;
				flex-direction: column;
				justify-content: space-evenly;
				padding: 0 1rem;
				width: 240px;
				flex-shrink: 0;
				align-items: center;
			}

			@media (min-width: 1200px) {
				.polaroid-column {
					display: flex;
				}
			}

			.polaroid-left {
				padding-top: 3rem;
				padding-bottom: 20rem;
			}

			.polaroid-right {
				padding-top: 30rem;
				padding-bottom: 2rem;
			}

			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.meta-date {
				margin: 0 0 1rem 0;
				color: rgb(var(--gray));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.75rem 0;
			}
			.last-updated-on {
				font-style: italic;
			}
			.collection-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.3em 0.85em;
				border-radius: 999px;
				background: rgba(59, 130, 246, 0.1);
				color: #1e40af;
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: none;
				transition: background 0.2s;
			}
			.title-chips {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 0.75rem;
			}
			.collection-chip:hover {
				background: rgba(59, 130, 246, 0.2);
			}
			.collection-chip svg {
				width: 14px;
				height: 14px;
			}
			:global(html.dark) .collection-chip {
				background: rgba(107, 123, 255, 0.15);
				color: #8e9aff;
			}
			:global(html.dark) .collection-chip:hover {
				background: rgba(107, 123, 255, 0.25);
			}
		</style>
	</head>

	<body>
		<Header />
		{heroImage && (
			<div class="hero-image">
				<Image src={heroImage} alt={title} width={1600} height={800} />
			</div>
		)}
		<div class="blog-layout">
			{galleryImages && galleryImages.length > 0 && (
				<aside class="polaroid-column polaroid-left">
					{galleryImages
						.filter((_: any, i: number) => i % 2 === 0)
						.map((img: any, i: number) => (
							<Polaroid
								src={img.src}
								alt={img.alt || ''}
								caption={img.caption}
								rotate={rotations[i % rotations.length]}
							/>
						))}
				</aside>
			)}
			<main>
				<article>
					<div class="prose">
						<div class="title">
							<div class="title-chips">
								<a class="collection-chip" href="/studio/blog/">
									<svg viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
									All Posts
								</a>
								{collection && (
									<a class="collection-chip" href={`/studio/blog/?collection=${encodeURIComponent(collection)}`}>
										<svg viewBox="0 0 20 20" fill="currentColor"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
										{collection}
									</a>
								)}
							</div>
							<h1>{title}</h1>
							<p class="meta-date">Published {new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
							<hr />
						</div>
						<slot />
					</div>
				</article>
			</main>
			{galleryImages && galleryImages.length > 1 && (
				<aside class="polaroid-column polaroid-right">
					{galleryImages
						.filter((_: any, i: number) => i % 2 === 1)
						.map((img: any, i: number) => (
							<Polaroid
								src={img.src}
								alt={img.alt || ''}
								caption={img.caption}
								rotate={rotations[(i + 4) % rotations.length]}
							/>
						))}
				</aside>
			)}
		</div>
		<Footer />
	</body>
</html>
